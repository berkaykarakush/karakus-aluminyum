@model List<KarakusAluminyum.Web.Models.ServiceContent>
@{
    var schema = ViewData["BusinessSchema"];
}
<section class="hero">
    <div class="container hero__content">
        <span class="eyebrow">Mimari Alüminyum Sistemleri</span>
        <h1>Mimariye değer katan <em>alüminyum çözümleri.</em></h1>
        <p>Alüminyum doğrama, sürme sistemler, cephe ve tamamlayıcı mimari çözümler. Projenizin ihtiyaçlarını birlikte değerlendirelim.</p>
        <div class="hero__actions"><a class="button button--silver" href="/iletisim">Projeniz için teklif alın <span aria-hidden="true">↗</span></a><a class="button button--outline" href="/projeler">Uygulamalarımızı inceleyin</a></div>
        <div class="trust-row"><span>Projeye özel çözümler</span><span>Modern mimari yaklaşım</span><span>İzmir ve çevresi</span></div>
    </div>
</section>
<section class="section">
    <div class="container">
        <div class="section-heading"><div><span class="eyebrow">Ürün ve Hizmetler</span><h2>Projenize uygun sistemi keşfedin.</h2></div><p>Her sistemin kullanım alanını ve teknik seçeneklerini açıklayan sayfalarla doğru çözüme daha kolay ulaşın.</p></div>
        <div class="card-grid">
            @foreach (var service in Model)
            {
                <article class="service-card">
                    <a href="/urunler/@service.Slug" aria-label="@service.Name detayları">
                        <div class="service-card__image">
                             @{
                                var imagePath = service.Image?.Trim();

                                if (!string.IsNullOrWhiteSpace(imagePath)
                                    && !imagePath.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                                    && !imagePath.StartsWith('/'))
                                {
                                    imagePath = "/" + imagePath.TrimStart('~', '/');
                                }
                            }

                            <img src="@(string.IsNullOrWhiteSpace(imagePath) ? "/images/aluminyum-dograma.png" : imagePath)"
                                alt="@service.Name uygulama örneği"
                                loading="lazy"
                                width="800"
                                height="600"
                                onerror="this.onerror=null;this.src='/images/aluminyum-dograma.png';" />
                        </div>
                    </a>
                    <div class="service-card__body">
                        <h3>
                            <a href="/urunler/@service.Slug">@service.Name</a>
                        </h3>
                        <p>@service.ShortDescription</p>
                        <a class="text-link" href="/urunler/@service.Slug">Detayları inceleyin ↗</a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>
<section class="section section--soft">
    <div class="container split">
        <div class="split__visual"><img src="/images/pvc-dograma.png" alt="Alüminyum profil ve doğrama uygulama detayı" loading="lazy" width="900" height="1000" /></div>
        <div class="split__copy"><span class="eyebrow">Karakuş Alüminyum</span><h2>Detaylara önem veren, projeye odaklı yaklaşım.</h2><p>Bu metni firmanızın gerçek geçmişi, deneyimi, hizmet bölgesi ve iş yapış biçimiyle tamamlayın. Gerçek uygulama fotoğrafları ve doğrulanabilir bilgiler ziyaretçilerin güvenini destekler.</p><ul class="check-list"><li>Proje ihtiyaçlarına göre sistem değerlendirmesi</li><li>Ürün seçimi ve uygulama sürecinde açık iletişim</li><li>Gerçek projeler ve şeffaf hizmet bilgileri</li></ul><a class="button button--dark" href="/kurumsal">Bizi daha yakından tanıyın ↗</a></div>
    </div>
</section>
<section class="section">
    <div class="container">
        <div class="section-heading"><div><span class="eyebrow">Uygulamalar</span><h2>Projelerimizden örnekler.</h2></div><a class="text-link" href="/projeler">Tüm projeleri görün ↗</a></div>
        <div class="project-grid">
            <a class="project-card" href="/projeler/ornek-konut-projesi"><img src="/images/proje-01.jpg" alt="Konut projesinde alüminyum doğrama uygulaması" loading="lazy" width="1000" height="900" /><div class="project-card__text"><span>Konut projesi</span><h3>Uygulama detaylarını görün ↗</h3></div></a>
            <a class="project-card" href="/projeler/ornek-ticari-yapi"><img src="/images/proje-02.jpg" alt="Ticari yapıda cam ve alüminyum cephe uygulaması" loading="lazy" width="800" height="600" /><div class="project-card__text"><span>Ticari yapı</span><h3>Cephe uygulaması ↗</h3></div></a>
            <a class="project-card" href="/projeler/ornek-surme-sistem"><img src="/images/proje-03.jpg" alt="Sürme sistem uygulama örneği" loading="lazy" width="800" height="600" /><div class="project-card__text"><span>Mimari uygulama</span><h3>Sürme sistem ↗</h3></div></a>
        </div>
        <p class="form-note">Yayın öncesinde örnek proje kartlarını yalnızca gerçek ve paylaşım izni bulunan projelerle değiştirin.</p>
    </div>
</section>
<section class="section section--soft">
    <div class="container"><div class="section-heading"><div><span class="eyebrow">Sık Sorulan Sorular</span><h2>Karar vermenize yardımcı bilgiler.</h2></div></div>
        <div class="faq-list">
            <article class="faq-item"><h3>Alüminyum doğrama nasıl seçilir?</h3><p>Açıklık ölçüsü, kullanım amacı, mimari tasarım, yalıtım beklentisi ve donanım seçenekleri birlikte değerlendirilmelidir.</p></article>
            <article class="faq-item"><h3>Projem için nasıl teklif alabilirim?</h3><p>Proje konumu, yaklaşık ölçüler, tercih edilen sistem ve varsa çizimleri iletişim formu üzerinden paylaşabilirsiniz.</p></article>
            <article class="faq-item"><h3>İzmir dışında hizmet veriyor musunuz?</h3><p>Hizmet verdiğiniz il ve ilçeleri gerçek operasyon kapsamınıza göre burada belirtin.</p></article>
        </div>
    </div>
</section>
<section class="section"><div class="container"><div class="cta-band"><div><h2>Projeniz için doğru sistemi birlikte belirleyelim.</h2><p>İhtiyacınızı anlatın, ekibimizle iletişime geçin.</p></div><a class="button button--silver" href="/iletisim">İletişime geçin ↗</a></div></div></section>
