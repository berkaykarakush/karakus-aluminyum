@model List<KarakusAluminyum.Web.Models.ServiceContent>
@inject KarakusAluminyum.Web.Services.SiteSettingsProvider SettingsProvider
@{
    var site = await SettingsProvider.GetAsync();
    var trustItems = site.TrustItems.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var projects = (IReadOnlyList<ProjectItem>)ViewBag.Projects;
}
@section Head {
    <link rel="preload" as="image" href="/images/hero-villa.webp" />
}
<section class="hero">
    <div class="container hero__content">
        <span class="eyebrow">@site.HeroEyebrow</span>
        <h1>@site.HeroTitle <em>@site.HeroTitleEmphasis</em></h1>
        <p>@site.HeroText</p>
        <div class="hero__actions"><a class="button button--silver" href="/iletisim">Projeniz için teklif alın <span aria-hidden="true">↗</span></a><a class="button button--outline" href="/projeler">Uygulamalarımızı inceleyin</a></div>
        <div class="trust-row">@foreach (var item in trustItems) { <span>@item</span> }</div>
    </div>
</section>
@if (Model.Count > 0)
{
    <div class="ticker" aria-hidden="true">
        <div class="ticker__track">
            @for (var copy = 0; copy < 2; copy++)
            {
                <div class="ticker__group">
                    @foreach (var service in Model)
                    {
                        <span>@service.Name</span>
                    }
                </div>
            }
        </div>
    </div>
}
<section class="section">
    <div class="container">
        <div class="section-heading"><div><span class="eyebrow">Ürün ve Hizmetler</span><h2>Projenize uygun sistemi keşfedin.</h2></div><p>Kullanım alanlarını ve seçenekleri inceleyin, projeniz için uygun sistemi birlikte belirleyelim.</p></div>
        <div class="mosaic">
            @for (var i = 0; i < Model.Count; i++)
            {
                var service = Model[i];
                var imagePath = service.Image?.Trim();
                if (!string.IsNullOrWhiteSpace(imagePath)
                    && !imagePath.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                    && !imagePath.StartsWith('/'))
                {
                    imagePath = "/" + imagePath.TrimStart('~', '/');
                }
                <a class="mosaic-card" href="/urunler/@service.Slug" aria-label="@service.Name detayları">
                    <img src="@(string.IsNullOrWhiteSpace(imagePath) ? "/images/aluminyum-dograma.png" : imagePath)"
                         alt="@service.Name uygulama örneği"
                         loading="lazy"
                         width="800"
                         height="600"
                         onerror="this.onerror=null;this.src='/images/aluminyum-dograma.png';" />
                    <span class="mosaic-card__index">@((i + 1).ToString("00"))</span>
                    <div class="mosaic-card__body">
                        <h3>@service.Name</h3>
                        <p>@service.ShortDescription</p>
                    </div>
                </a>
            }
        </div>
    </div>
</section>
<section class="section section--dark">
    <div class="container">
        <div class="split">
            <div class="split__visual"><img src="/images/kapi-ve-pencere-sistemleri.png" alt="Alüminyum kapı ve pencere uygulama detayı" loading="lazy" width="900" height="1000" /></div>
            <div class="split__copy"><span class="eyebrow">Karakuş Alüminyum</span><h2>@site.ApproachTitle</h2><p>@site.ApproachText</p><ul class="check-list"><li>Proje ihtiyaçlarına göre sistem değerlendirmesi</li><li>Ürün seçimi ve uygulama sürecinde açık iletişim</li><li>Uygulama öncesi ölçü ve detayların değerlendirilmesi</li></ul><a class="button button--dark" href="/kurumsal">Bizi daha yakından tanıyın ↗</a></div>
        </div>
        <div class="steps">
            <div class="step"><span>01</span><h3>Görüşme</h3><p>Projenizi, kullanım amacını ve beklentilerinizi dinliyoruz.</p></div>
            <div class="step"><span>02</span><h3>Değerlendirme</h3><p>Ölçüleri, çizimleri ve uygulama koşullarını birlikte inceliyoruz.</p></div>
            <div class="step"><span>03</span><h3>Sistem ve teklif</h3><p>Projenize uygun sistem seçeneklerini ve teklifimizi paylaşıyoruz.</p></div>
            <div class="step"><span>04</span><h3>Uygulama</h3><p>Onaylanan detaylar doğrultusunda uygulamaya geçiyoruz.</p></div>
        </div>
    </div>
</section>
@if (projects.Count > 0)
{
    <section class="section section--soft">
        <div class="container">
            <div class="section-heading"><div><span class="eyebrow">Uygulamalar</span><h2>Projelerimizden örnekler.</h2></div><a class="text-link" href="/projeler">Tüm projeleri görün ↗</a></div>
            <div class="project-grid">
                @foreach (var project in projects)
                {
                    <a class="project-card" href="/projeler/@project.Slug"><img src="@project.Image" alt="@project.Title - @project.Type" loading="lazy" width="1000" height="900" /><div class="project-card__text"><span>@project.Type · @project.Location</span><h3>@project.Title</h3></div></a>
                }
            </div>
        </div>
    </section>
}
@{ ViewData["FaqHeading"] = "Karar vermenize yardımcı bilgiler."; }
<partial name="_Faqs" model="(IReadOnlyList<KarakusAluminyum.Web.Models.FaqItem>)ViewBag.Faqs" />
<section class="section section--soft"><div class="container"><div class="cta-band"><div><h2>@site.CtaTitle</h2><p>@site.CtaText</p></div><a class="button button--silver" href="/iletisim">İletişime geçin ↗</a></div></div></section>
