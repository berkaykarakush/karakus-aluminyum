@inject KarakusAluminyum.Web.Services.SiteSettingsProvider SettingsProvider
@{
    var site = await SettingsProvider.GetAsync();
    var services = (IReadOnlyList<KarakusAluminyum.Web.Models.ServiceContent>)ViewBag.Services;
    var projects = (IReadOnlyList<ProjectItem>)ViewBag.Projects;
}
<section class="page-hero page-hero--feature">
    <img class="page-hero__media" src="/images/hero-villa.webp" alt="" width="1920" height="1080" fetchpriority="high" />
    <div class="container">
        <nav class="breadcrumbs" aria-label="İçerik yolu"><a href="/">Ana Sayfa</a><span>/</span><span>Kurumsal</span></nav>
        <span class="eyebrow">Kurumsal</span>
        <h1>@site.AboutTitle</h1>
        <p class="page-intro">@site.AboutIntro</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="about-lead">
            <div class="detail-layout__main">
                <span class="eyebrow">Yaklaşımımız</span>
                <h2>@site.AboutSectionTitle</h2>
            </div>
            <div class="content-prose content-prose--lead">
                <p>@site.AboutText</p>
                <a class="text-link" href="/iletisim">İletişime geçin ↗</a>
            </div>
        </div>
        <div class="duo-figure">
            <img src="/images/aluminyum-dograma.png" alt="Alüminyum doğrama profil detayı" loading="lazy" width="1536" height="1024" />
            <img src="/images/kapi-ve-pencere-sistemleri.png" alt="Alüminyum kapı ve pencere uygulama detayı" loading="lazy" width="1536" height="1024" />
        </div>
    </div>
</section>

<section class="section section--soft">
    <div class="container">
        <div class="section-heading"><div><span class="eyebrow">İlkelerimiz</span><h2>Her projede aynı özeni gösteriyoruz.</h2></div></div>
        <div class="principles">
            <div class="principle"><span>01</span><h3>Projeye göre değerlendirme</h3><p>Her yapının ölçüsü, cephesi ve kullanım amacı farklıdır. Sistem önerimizi bu koşulları inceledikten sonra oluşturuyoruz.</p></div>
            <div class="principle"><span>02</span><h3>Açık iletişim</h3><p>Ürün seçiminden uygulamaya kadar seçenekleri gerekçeleriyle paylaşıyor, kararları sizinle birlikte veriyoruz.</p></div>
            <div class="principle"><span>03</span><h3>Uygulama öncesi netlik</h3><p>Uygulamaya geçmeden önce ölçüleri ve detayları değerlendiriyor, süreci onaylanan kararlar üzerinden planlıyoruz.</p></div>
        </div>
    </div>
</section>

<section class="section section--dark">
    <div class="container">
        <div class="section-heading"><div><span class="eyebrow">Çalışma süreci</span><h2>Süreci ilk görüşmeden uygulamaya birlikte yürütüyoruz.</h2></div></div>
        <partial name="_ProcessSteps" />
    </div>
</section>

@if (services.Count > 0)
{
    <section class="section">
        <div class="container">
            <div class="section-heading"><div><span class="eyebrow">Çalışma alanlarımız</span><h2>Alüminyum, cam ve kapı sistemlerinde hizmet veriyoruz.</h2></div><a class="text-link" href="/urunler">Tüm ürün ve hizmetler ↗</a></div>
            <div class="expertise-list">
                @for (var i = 0; i < services.Count; i++)
                {
                    <a class="expertise-row" href="/urunler/@services[i].Slug">
                        <span class="expertise-row__index">@((i + 1).ToString("00"))</span>
                        <h3>@services[i].Name</h3>
                        <p>@services[i].ShortDescription</p>
                        <span class="expertise-row__arrow" aria-hidden="true">↗</span>
                    </a>
                }
            </div>
        </div>
    </section>
}

@if (projects.Count > 0)
{
    <section class="section section--soft">
        <div class="container">
            <div class="section-heading"><div><span class="eyebrow">Uygulamalar</span><h2>Projelerimizden örnekler.</h2></div><a class="text-link" href="/projeler">Tüm projeleri görün ↗</a></div>
            <div class="project-grid">
                @foreach (var project in projects)
                {
                    <a class="project-card" href="/projeler/@project.Slug"><img src="@project.Image" alt="@project.Title - @project.Type" loading="lazy" width="1000" height="900" /><div class="project-card__text"><span>@project.Type · @project.Location</span><h3>@project.Title</h3></div></a>
                }
            </div>
        </div>
    </section>
}

<section class="section"><div class="container"><div class="cta-band"><div><h2>@site.CtaTitle</h2><p>@site.CtaText</p></div><a class="button button--silver" href="/iletisim">İletişime geçin ↗</a></div></div></section>
