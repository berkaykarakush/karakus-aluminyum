@model KarakusAluminyum.Web.Models.Drawing.DrawingList
@using KarakusAluminyum.Web.Services.Drawing
@{
    // QR ile açılan çizim listesi: yalnızca pozlar (çizim, ölçü, açıklama). Malzeme, maliyet ve fiyat gösterilmez.
    Layout = null;
    var pozlar = PozSheet.Build(Model.Items.OrderBy(x => x.SortOrder).ThenBy(x => x.Id));
    var culture = KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture;
}
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>@Model.Name - Çizim listesi</title>
  <link rel="stylesheet" href="~/css/document-print.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/poz-list.css" asp-append-version="true" />
  <style>@@page{size:A4;margin:10mm}.poz-public{max-width:210mm;margin:0 auto;padding:10mm;background:#fff;box-shadow:0 4px 18px rgba(0,0,0,.14)}@@media print{.poz-public{max-width:none;padding:0;box-shadow:none}}</style>
</head>
<body class="doc">
  @if (ViewData["PublicNote"] is string note) { <partial name="~/Areas/Admin/Views/Documents/_PublicBanner.cshtml" model="note" /> }
  <div class="doc-toolbar"><button type="button" onclick="window.print()">Yazdır / PDF kaydet</button></div>
  <div class="poz-public">
    <table class="poz-sheet">
      <thead><tr><td><partial name="~/Areas/Admin/Views/Shared/_PozSheetHead.cshtml" model="new PozSheetHeadVm(Model, pozlar)" /></td></tr></thead>
      <tbody><tr><td>
        <partial name="~/Areas/Admin/Views/Shared/_PozList.cshtml" model="pozlar" />
        <div class="poz-totals">
          <span>Ünite adedi: @pozlar.Sum(x => x.Design.Quantity)</span>
          <span>Toplam çevre: @pozlar.Sum(x => x.PerimeterM * x.Design.Quantity).ToString("0.0", culture) m</span>
          <span>Toplam alan: @pozlar.Sum(x => x.AreaM2 * x.Design.Quantity).ToString("0.00", culture) m²</span>
        </div>
      </td></tr></tbody>
    </table>
  </div>
  <script src="~/js/units.js" asp-append-version="true"></script>
  <script src="~/js/window-drawing.js" asp-append-version="true"></script>
  <script src="~/js/poz-list.js" asp-append-version="true"></script>
</body>
</html>
