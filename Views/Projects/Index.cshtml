@model IReadOnlyList<ProjectItem>
<section class="page-hero">
    <div class="container">
        <nav class="breadcrumbs" aria-label="İçerik yolu">
            <a href="/">Ana Sayfa</a>
            <span>/</span>
            <span>Projeler</span>
        </nav>
        <span class="eyebrow">Proje Portföyü</span>
        <h1>Detaylarda hayat bulan uygulamalarımız.</h1>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="card-grid">
            @foreach (var project in Model)
            {
                <article class="service-card">
                    <a href="/projeler/@project.Slug">
                    <div class="service-card__image">
                        <img src="@project.Image" alt="@project.Title - @project.Type" loading="lazy" width="800" height="600" />
                    </div>
                    </a>
                    <div class="service-card__body">
                        <p class="eyebrow">@project.Type · @project.Location</p>
                        <h2>@project.Title</h2>
                        <p>@project.Summary</p>
                        <a class="text-link" href="/projeler/@project.Slug">Proje detayları ↗</a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>
