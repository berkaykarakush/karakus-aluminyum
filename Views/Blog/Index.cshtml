@model IReadOnlyList<KarakusAluminyum.Web.Models.BlogPost>
<section class="page-hero"><div class="container"><nav class="breadcrumbs"><a href="/">Ana Sayfa</a><span>/</span><span>Bilgi Merkezi</span></nav><span class="eyebrow">Bilgi Merkezi</span><h1>Alüminyum sistemleri hakkında bilgi edinin.</h1><p class="page-intro">Yayınlanan rehber ve makalelerimizi inceleyin.</p></div></section><section class="section"><div class="container"><div class="card-grid">@foreach(var post in Model){<article class="service-card"><a href="/blog/@post.Slug"><div class="service-card__image"><img src="@post.Image" alt="@post.Title" loading="lazy" width="800" height="600"/></div></a><div class="service-card__body"><h2>@post.Title</h2><p>@post.Summary</p><a class="text-link" href="/blog/@post.Slug">Yazıyı oku ↗</a></div></article>}</div>@if(Model.Count==0){<p>Henüz yayınlanmış yazı bulunmuyor.</p>}</div></section>
