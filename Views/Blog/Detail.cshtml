@model KarakusAluminyum.Web.Models.BlogPost
<section class="page-hero"><div class="container"><nav class="breadcrumbs"><a href="/">Ana Sayfa</a><span>/</span><a href="/blog">Bilgi Merkezi</a><span>/</span><span>@Model.Title</span></nav><span class="eyebrow">Bilgi Merkezi</span><h1>@Model.Title</h1><p class="page-intro">@Model.Summary</p></div></section><section class="section"><div class="container" style="max-width:900px"><img src="@Model.Image" alt="@Model.Title" style="width:100%;height:auto;border-radius:16px"/><article style="white-space:pre-wrap;line-height:1.85;margin-top:28px">@Model.Content</article><p><a class="text-link" href="/blog">← Tüm yazılar</a></p></div></section>
