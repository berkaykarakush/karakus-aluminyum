@model IReadOnlyList<ServicePage>
<section class="page-hero">
    <div class="container">
        <nav class="breadcrumbs" aria-label="İçerik yolu">
            <a href="/">Ana Sayfa</a>
            <span>/</span>
            <span>Ürün ve Hizmetler</span>
        </nav>
        <span class="eyebrow">Çözümlerimiz</span>
        <h1>Mimari projeniz için sistem seçenekleri.</h1>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="card-grid">
            @foreach (var service in Model)
            {
                <article class="service-card">
                    <a href="/urunler/@service.Slug">
                        <div class="service-card__image">
                            <img src="@service.Image" alt="@service.Name" loading="lazy" width="800" height="600" />
                        </div>
                    </a>
                    <div class="service-card__body">
                        <h2>@service.Name</h2>
                        <p>@service.ShortDescription</p>
                        <a class="text-link" href="/urunler/@service.Slug">Hizmeti inceleyin ↗</a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>