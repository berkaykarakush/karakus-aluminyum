@model ServicePage
@inject KarakusAluminyum.Web.Services.SiteSettingsProvider SettingsProvider
@{
    var site = await SettingsProvider.GetAsync();
    var gallery = (IReadOnlyList<KarakusAluminyum.Web.Models.GalleryImage>)ViewBag.Gallery;
    var related = (IReadOnlyList<ServicePage>)ViewBag.Related;
    var hasImage = Model.Image != KarakusAluminyum.Web.Services.ProjectQueries.PlaceholderImage;
    var showcaseImage = gallery.FirstOrDefault()?.ImagePath ?? (hasImage ? Model.Image : null);
    var quoteUrl = "/iletisim?service=" + Uri.EscapeDataString(Model.Name);
}
<section class="page-hero page-hero--feature">
    @if (hasImage)
    {
        <img class="page-hero__media" src="@Model.Image" alt="@Model.Name uygulama görseli" width="1536" height="1024" fetchpriority="high" />
    }
    <div class="container">
        <nav class="breadcrumbs" aria-label="İçerik yolu">
            <a href="/">Ana Sayfa</a>
            <span>/</span>
            <a href="/urunler">Ürün ve Hizmetler</a>
            <span>/</span>
            <span>@Model.Name</span>
        </nav>
        <span class="eyebrow">Ürün ve Hizmetler</span>
        <h1>@Model.Name</h1>
        <p class="page-intro">@Model.ShortDescription</p>
        <div class="page-hero__actions">
            <a class="button button--silver" href="@quoteUrl">Teklif isteyin <span aria-hidden="true">↗</span></a>
            <a class="button button--outline" href="/projeler">Uygulamalarımızı inceleyin</a>
        </div>
    </div>
</section>

<section class="section">
    <div class="container detail-layout">
        <div class="detail-layout__main">
            <span class="eyebrow">Sistem hakkında</span>
            <h2>Projeye uygun çözümü birlikte değerlendirelim.</h2>
            <div class="content-prose content-prose--lead">@Html.Raw(KarakusAluminyum.Web.Services.SimpleMarkdown.ToHtml(Model.Intro))</div>
        </div>
        <aside class="side-card" aria-label="Teklif ve iletişim">
            <span class="eyebrow">Teklif</span>
            <h3>Bu sistem için ilk değerlendirmeyi başlatın.</h3>
            <p>Ölçü, çizim ve ihtiyaçlarınızı paylaşın; projenize uygun seçenekleri birlikte belirleyelim.</p>
            <a class="button button--silver" href="@quoteUrl">Teklif isteyin <span aria-hidden="true">↗</span></a>
            <div class="side-card__links">
                @if (!site.PhoneE164.Contains('X'))
                {
                    <a href="tel:@site.PhoneE164">@site.PhoneDisplay</a>
                }
                @if (!string.IsNullOrWhiteSpace(site.WhatsAppNumber) && !site.WhatsAppNumber.Contains('X'))
                {
                    <a href="https://wa.me/@site.WhatsAppNumber" target="_blank" rel="noopener noreferrer">WhatsApp ile yazın</a>
                }
            </div>
        </aside>
    </div>
</section>

<section class="section section--dark">
    <div class="container">
        @if (Model.Benefits.Count > 0)
        {
            <div class="split split--top">
                @if (showcaseImage is not null)
                {
                    <div class="split__visual"><img src="@showcaseImage" alt="@Model.Name detay görseli" loading="lazy" width="900" height="1000" /></div>
                }
                <div class="split__copy">
                    <span class="eyebrow">Öne çıkanlar</span>
                    <h2>Sistemi öne çıkaran özellikler.</h2>
                    <ol class="feature-list">
                        @for (var i = 0; i < Model.Benefits.Count; i++)
                        {
                            <li><span>@((i + 1).ToString("00"))</span>@Model.Benefits[i]</li>
                        }
                    </ol>
                </div>
            </div>
        }
        <partial name="_ProcessSteps" />
    </div>
</section>

@{ ViewData["GalleryTitle"] = Model.Name + " uygulamaları"; }
<partial name="_Gallery" model="(IReadOnlyList<KarakusAluminyum.Web.Models.GalleryImage>)gallery.Skip(1).ToList()" />

@{ ViewData["FaqHeading"] = Model.Name + " hakkında merak edilenler."; }
<partial name="_Faqs" model="(IReadOnlyList<KarakusAluminyum.Web.Models.FaqItem>)ViewBag.Faqs" />

@if (related.Count > 0)
{
    <section class="section section--soft">
        <div class="container">
            <div class="section-heading"><div><span class="eyebrow">Diğer sistemler</span><h2>Bunlar da ilginizi çekebilir.</h2></div><a class="text-link" href="/urunler">Tüm ürün ve hizmetler ↗</a></div>
            <div class="card-grid">
                @foreach (var item in related)
                {
                    <a class="service-card" href="/urunler/@item.Slug">
                        <div class="service-card__image"><img src="@item.Image" alt="@item.Name uygulama örneği" loading="lazy" width="800" height="600" /></div>
                        <div class="service-card__body"><h3>@item.Name</h3><p>@item.ShortDescription</p></div>
                    </a>
                }
            </div>
        </div>
    </section>
}

<section class="section">
    <div class="container">
        <div class="cta-band">
            <div>
                <h2>Projeniz için detayları konuşalım.</h2>
                <p>Ölçü, çizim ve ihtiyaçlarınızı paylaşarak ilk değerlendirmeyi başlatın.</p>
            </div>
            <a class="button button--silver" href="@quoteUrl">Teklif isteyin ↗</a>
        </div>
    </div>
</section>
