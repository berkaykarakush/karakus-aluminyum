@model IReadOnlyList<KarakusAluminyum.Web.Models.GalleryImage>
@{
    var cats = (List<(string Key, string Name)>)ViewBag.Categories;
    var active = (string)(ViewBag.ActiveKey ?? "");
}
<section class="page-hero">
    <div class="container">
        <nav class="breadcrumbs" aria-label="İçerik yolu">
            <a href="/">Ana Sayfa</a>
            <span>/</span>
            <span>Galeri</span>
        </nav>
        <span class="eyebrow">Galeri</span>
        <h1>Uygulamalarımızdan seçtiğimiz kareler.</h1>
        <div class="gallery-filters">
            @foreach (var c in cats)
            {
                <a class="@(c.Key == active ? "is-active" : "")"
                   href="@(c.Key.Length == 0 ? "/galeri" : "/galeri?k=" + c.Key)">@c.Name</a>
            }
        </div>
    </div>
</section>

@if (Model.Count == 0)
{
    <section class="section">
        <div class="container"><p>Bu kategoride henüz görsel yok.</p></div>
    </section>
}
<partial name="_Gallery" model="Model" />
