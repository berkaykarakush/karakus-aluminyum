@model KarakusAluminyum.Web.Controllers.LoginInput
@{ViewData["Title"]="Yönetici Girişi";Layout="~/Views/Shared/_Layout.cshtml";}<section class="section"><div class="container" style="max-width:520px"><h1>Yönetici Girişi</h1><form method="post" action="/yonetim-giris">@Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/><div asp-validation-summary="All"></div><label asp-for="Email">E-posta</label><input asp-for="Email" autocomplete="username"/><span asp-validation-for="Email"></span><label asp-for="Password">Parola</label><input asp-for="Password" autocomplete="current-password"/><span asp-validation-for="Password"></span><p><label><input asp-for="RememberMe" type="checkbox"/> Beni hatırla</label></p><button class="button button--primary" type="submit">Giriş yap</button></form></div></section>
