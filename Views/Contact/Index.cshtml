@model ContactRequest
@using KarakusAluminyum.Web.Models
@{ var availableServices = ViewBag.Services as List<string> ?? new List<string>(); }
@{
    var settings = (SiteSettings)ViewBag.Settings;
    if (Context.Request.Query.TryGetValue("service", out var serviceValue) && string.IsNullOrWhiteSpace(Model.Service))
        Model.Service = serviceValue.ToString();
}
<section class="page-hero"><div class="container"><nav class="breadcrumbs" aria-label="İçerik yolu"><a href="/">Ana Sayfa</a><span>/</span><span>İletişim</span></nav><span class="eyebrow">İletişim ve Teklif</span><h1>Projenizi konuşalım.</h1><p class="page-intro">Ölçü, çizim veya aklınızdaki fikri paylaşın. Talebinizi inceleyip size telefon veya e-posta ile dönüş yapalım.</p></div></section>
<section class="section"><div class="container split"><div class="split__copy"><h2>Size yardımcı olmaktan memnuniyet duyarız.</h2><p>Telefon, e-posta veya teklif formu üzerinden bize ulaşabilirsiniz.</p><ul class="check-list"><li><strong>Telefon:</strong>&nbsp; <a href="tel:@settings.PhoneE164">@settings.PhoneDisplay</a></li><li><strong>E-posta:</strong>&nbsp; <a href="mailto:@settings.Email">@settings.Email</a></li><li><strong>Adres:</strong>&nbsp; @settings.Address</li></ul></div>
<div class="contact-panel">
@if (TempData["ContactNotice"] is string notice) { <p class="notice">@notice</p> }
<form method="post" action="/iletisim">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <div class="form-grid">
        <div class="form-field"><label asp-for="Name"></label><input asp-for="Name" autocomplete="name" /><span asp-validation-for="Name" class="field-error"></span></div>
        <div class="form-field"><label asp-for="ContactInfo"></label><input asp-for="ContactInfo" autocomplete="email" placeholder="Telefon veya e-posta" /><span asp-validation-for="ContactInfo" class="field-error"></span></div>
        <div class="form-field"><label asp-for="ProjectLocation"></label><input asp-for="ProjectLocation" placeholder="Örn. Bornova, İzmir" /></div>
        <div class="form-field"><label asp-for="Service"></label><select asp-for="Service"><option value="">Hizmet seçin</option>@foreach (var service in availableServices) { <option value="@service">@service</option> }</select></div>
        <div class="form-field form-field--full"><label asp-for="Message"></label><textarea asp-for="Message" placeholder="Proje ölçüsü, kullanım amacı ve ihtiyaçlarınızı yazın."></textarea><span asp-validation-for="Message" class="field-error"></span></div>
        <div class="honeypot" aria-hidden="true"><label asp-for="Website">Web sitesi</label><input asp-for="Website" tabindex="-1" autocomplete="off" /></div>
        <div class="form-field form-field--full consent"><label><input asp-for="PrivacyAccepted" /> <a href="/kvkk-aydinlatma-metni" target="_blank">KVKK aydınlatma metnini</a> okudum.</label><span asp-validation-for="PrivacyAccepted" class="field-error"></span></div>
        <div class="form-field form-field--full"><button class="button button--dark" type="submit">Talep gönder <span aria-hidden="true">↗</span></button><p class="form-note">Bilgileriniz yalnızca talebinizi değerlendirmek ve size dönüş yapmak için kullanılır.</p></div>
    </div>
</form>
</div></div></section>
@if (settings.MapEmbedUrl is { } mapUrl)
{
    <section class="section section--soft">
        <div class="container">
            <div class="section-heading"><div><span class="eyebrow">Konum</span><h2>Bizi ziyaret edin.</h2></div><div class="map-address"><p>@settings.Address</p><a class="text-link" href="@settings.MapDirectionsUrl" target="_blank" rel="noopener noreferrer">Yol tarifi alın ↗</a></div></div>
            @* Harita Google'a veri aktarır: çerez onayı varsa kendiliğinden, yoksa ziyaretçi isteyince yüklenir (site.js). *@
            <div class="map-embed" data-map-src="@mapUrl" data-map-title="@settings.SiteName konum haritası">
                <div class="map-embed__prompt">
                    <p>Harita Google tarafından sunulur. Görüntülediğinizde IP adresiniz gibi bazı veriler Google'a aktarılabilir.</p>
                    <button type="button" class="button button--silver">Haritayı göster</button>
                </div>
            </div>
        </div>
    </section>
}
