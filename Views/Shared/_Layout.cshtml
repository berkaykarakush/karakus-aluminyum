@using System.Text.Json
@using KarakusAluminyum.Web.Models
@using KarakusAluminyum.Web.Services
@inject SiteSettingsProvider SettingsProvider
@inject SeoService Seo
@inject KarakusAluminyum.Web.Data.AppDbContext Db
@using Microsoft.EntityFrameworkCore
@{
    var navServices = await Db.Services.AsNoTracking().Where(x => x.IsPublished).OrderBy(x => x.SortOrder).ToListAsync();
    var seo = ViewData["Seo"] as SeoViewModel ?? new SeoViewModel();
    var settings = await SettingsProvider.GetAsync();
    var canonical = settings.BaseUrl.TrimEnd('/') + (seo.CanonicalPath.StartsWith('/') ? seo.CanonicalPath : "/" + seo.CanonicalPath);
    var imagePath = string.IsNullOrWhiteSpace(seo.ImagePath) ? "/images/aluminyum-dograma.png" : seo.ImagePath;
    var imageUrl = imagePath.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? imagePath : settings.BaseUrl.TrimEnd('/') + imagePath;
    // Yönetici oturumu ve aranmayan sayfalar (giriş, hata) ölçüme girmez.
    var firstParty = settings.FirstPartyAnalyticsEnabled == "true";
    // Teşekkür sayfası aranmaz ama dönüşümü ölçmek için izlenir.
    var trackable = User.Identity?.IsAuthenticated != true && (!seo.Robots.Contains("noindex", StringComparison.OrdinalIgnoreCase) || ViewData["TrackEvent"] is not null);
    var tracking = trackable && (firstParty || !string.IsNullOrWhiteSpace(settings.Ga4MeasurementId) || !string.IsNullOrWhiteSpace(settings.MetaPixelId));
}
<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d1115" />
    <title>@seo.Title</title>
    <meta name="description" content="@seo.Description" />
    <meta name="robots" content="@seo.Robots" />
    <link rel="canonical" href="@canonical" />
    @if (seo.IsIndexable) { <link rel="alternate" type="text/markdown" href="@seo.MarkdownPath" title="Markdown" /> }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="~/images/favicon.ico" rel="icon">
    <meta property="og:type" content="@seo.Type" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content="@settings.SiteName" />
    <meta property="og:title" content="@seo.Title" />
    <meta property="og:description" content="@seo.Description" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@imageUrl" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@seo.Title" />
    <meta name="twitter:description" content="@seo.Description" />
    <meta name="twitter:image" content="@imageUrl" />
    @if (seo.PublishedUtc is { } published) { <meta property="article:published_time" content="@DateTime.SpecifyKind(published, DateTimeKind.Utc).ToString("yyyy-MM-ddTHH:mm:ssZ")" /> }
    @if (seo.ModifiedUtc is { } modifiedAt) { <meta property="article:modified_time" content="@DateTime.SpecifyKind(modifiedAt, DateTimeKind.Utc).ToString("yyyy-MM-ddTHH:mm:ssZ")" /> }
    @if (seo.IsIndexable)
    {
        @* Kodlayıcı < ve > karakterlerini kaçırır, içerik script etiketini kapatamaz. "!" etiket yardımcısının + işaretini kodlamasını önler. *@
        <!script type="application/ld+json">@Html.Raw(Seo.PageGraphJson(seo, settings))</!script>
    }
    @if (!string.IsNullOrWhiteSpace(settings.GoogleSiteVerification)) { <meta name="google-site-verification" content="@settings.GoogleSiteVerification" /> }
    @if (!string.IsNullOrWhiteSpace(settings.MetaDomainVerification)) { <meta name="facebook-domain-verification" content="@settings.MetaDomainVerification" /> }
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main">İçeriğe geç</a>
    <div class="top-strip">
        <div class="container top-strip__inner">
            <span>İzmir’de mimari alüminyum çözümleri sunuyoruz</span>
            <div class="top-strip__links">
                <a href="tel:@settings.PhoneE164">@settings.PhoneDisplay</a>
                <a href="/iletisim">Teklif isteyin <span aria-hidden="true">↗</span></a>
            </div>
        </div>
    </div>
    <header class="site-header">
        <div class="container nav-wrap">
            <a class="brand" href="/" aria-label="Karakuş Alüminyum ana sayfa">
                <img src="/images/transparent.png" alt="Karakuş Alüminyum" width="206" height="64" />
            </a>
            <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Menüyü aç veya kapat">
                <span></span><span></span><span></span>
            </button>
            <nav id="primary-nav" class="primary-nav" aria-label="Ana menü">
                <a href="/" class="nav-link">Ana Sayfa</a>
                <a href="/kurumsal" class="nav-link">Kurumsal</a>
                <div class="nav-dropdown">
                    <a href="/urunler" class="nav-link">Ürün ve Hizmetler <span aria-hidden="true">⌄</span></a>
                    <div class="nav-dropdown__menu">
                        @foreach (var item in navServices)
                        {
                            <a href="/urunler/@item.Slug">@item.Name</a>
                        }
                    </div>
                </div>
                <a href="/projeler" class="nav-link">Projeler</a>
                <a href="/galeri" class="nav-link">Galeri</a>
                <a href="/blog" class="nav-link">Bilgi Merkezi</a>
                <a href="/iletisim" class="nav-link">İletişim</a>
                <a href="/iletisim" class="button button--small button--silver nav-cta">Teklif Alın <span aria-hidden="true">↗</span></a>
            </nav>
        </div>
    </header>
    <main id="main">@RenderBody()</main>
    <footer class="site-footer">
        <div class="container footer-grid">
            <div class="footer-brand">
                <a class="brand brand--footer" href="/"><img src="/images/transparent.png" alt="Karakuş Alüminyum" width="206" height="64" loading="lazy" /></a>
                <p>@settings.FooterText</p>
            </div>
            <div><h2>Hızlı Erişim</h2><a href="/kurumsal">Hakkımızda</a><a href="/urunler">Ürün ve Hizmetler</a><a href="/projeler">Projelerimiz</a><a href="/galeri">Galeri</a><a href="/blog">Bilgi Merkezi</a><a href="/iletisim">İletişim</a></div>
            <div><h2>Hizmetler</h2>
                @foreach (var item in navServices)
                {
                    <a href="/urunler/@item.Slug">@item.Name</a>
                }
            </div>
            <div><h2>İletişim</h2><p>@settings.Address</p><a href="tel:@settings.PhoneE164">@settings.PhoneDisplay</a><a href="mailto:@settings.Email">@settings.Email</a>@if (!string.IsNullOrWhiteSpace(settings.GoogleMapsUrl)) { <a href="@settings.GoogleMapsUrl" rel="noopener noreferrer" target="_blank">Haritada görüntüle ↗</a> }</div>
        </div>
        <div class="container footer-bottom"><span>© @SiteSettings.CopyrightYears @settings.SiteName. Tüm hakları saklıdır.</span><div><a href="/gizlilik-politikasi">Gizlilik</a><a href="/kvkk-aydinlatma-metni">KVKK</a>@if (tracking) { <button type="button" class="footer-link-button" data-consent-open>Çerez tercihleri</button> }</div></div>
    </footer>
    @if (!string.IsNullOrWhiteSpace(settings.WhatsAppNumber) && !settings.WhatsAppNumber.Contains('X'))
    {
        <a class="floating-contact" href="https://wa.me/@settings.WhatsAppNumber" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp üzerinden iletişim">WhatsApp <span aria-hidden="true">↗</span></a>
    }
    @if (tracking)
    {
        <div id="consent-banner" class="consent-banner" role="dialog" aria-label="Çerez tercihleri" hidden>
            <p>@settings.ConsentText <a href="/gizlilik-politikasi">Ayrıntılar</a></p>
            <div class="consent-banner__actions">
                <button type="button" class="button button--small button--outline-light" data-consent-reject>Reddet</button>
                <button type="button" class="button button--small button--silver" data-consent-accept>Kabul et</button>
            </div>
        </div>
        <script type="application/json" id="tracking-config">@Html.Raw(JsonSerializer.Serialize(new { ga4 = settings.Ga4MeasurementId, pixel = settings.MetaPixelId, firstParty, @event = ViewData["TrackEvent"] as string, eventLabel = ViewData["TrackLabel"] as string }))</script>
        <script src="~/js/tracking.js" asp-append-version="true" defer></script>
    }
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
