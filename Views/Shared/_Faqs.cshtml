@model IReadOnlyList<KarakusAluminyum.Web.Models.FaqItem>
@if (Model.Count == 0) { return; }
<section class="section">
    <div class="container faq-layout">
        <div>
            <span class="eyebrow">Sık Sorulan Sorular</span>
            <h2>@ViewData["FaqHeading"]</h2>
        </div>
        <div class="faq-list">
            @for (var i = 0; i < Model.Count; i++)
            {
                <details class="faq-item" open="@(i == 0)">
                    <summary><h3>@Model[i].Question</h3></summary>
                    <p>@Model[i].Answer</p>
                </details>
            }
        </div>
    </div>
</section>
