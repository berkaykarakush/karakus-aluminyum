# Sunucuda bu dosyayı .env olarak kopyalayın ve "chmod 600 .env" uygulayın.
# Şifrelerde boşluk, ; $ ' " ` karakterlerini kullanmayın. Veritabanı ve admin şifresi farklı olmalıdır.

# Caddy'yi devreye alır. Yerel geliştirmede bu satırı yazmayın.
COMPOSE_PROFILES=production
DOMAIN=www.karakusaluminyum.com
APEX_DOMAIN=karakusaluminyum.com

DATABASE_SCHEMA_MODE=ensurecreated

POSTGRES_DB=karakus_aluminyum
POSTGRES_USER=karakus_app
POSTGRES_PASSWORD=

WEB_PORT=8080

# Şifre yalnızca hesap ilk oluşturulurken okunur; sonradan değiştirmek panelden yapılır.
KARAKUS_ADMIN_EMAIL=
KARAKUS_ADMIN_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL_TO=

# İsteğe bağlı
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_GRAPH_API_VERSION=v22.0

# Yerel yedeklerin saklanacağı gün sayısı
BACKUP_KEEP_DAYS=14
# Sunucu dışı kopya için rclone hedefi, örn. depo:karakus-yedek. Boşsa kopyalanmaz.
BACKUP_REMOTE=
