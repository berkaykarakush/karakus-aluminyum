@model List<KarakusAluminyum.Web.Services.Accounting.StatementLine>
@using KarakusAluminyum.Web.Models.Accounting
@using KarakusAluminyum.Web.Services.Accounting
@using KarakusAluminyum.Web.Services.Documents
@{ var customer = (KarakusAluminyum.Web.Models.Crm.Customer)ViewBag.Customer; decimal balance = ViewBag.Balance; ViewData["Title"] = customer.Name; var open = (List<OpenInvoice>)ViewBag.Open; var from = ViewBag.From as DateOnly?; var to = ViewBag.To as DateOnly?; var today = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(3)).ToString("yyyy-MM-dd"); }
<div class="admin-actions"><h1>@customer.Name</h1>
  <a class="admin-btn" href="/yonetim/muhasebe/faturalar/ekle?tur=Sale&cari=@customer.Id">+ Satış</a><a class="admin-btn" href="/yonetim/muhasebe/faturalar/ekle?tur=Purchase&cari=@customer.Id">+ Alış</a>
  <a class="admin-btn" href="/yonetim/muhasebe/kasa-banka/yeni?tur=tahsilat&cari=@customer.Id">+ Tahsilat</a><a class="admin-btn" href="/yonetim/muhasebe/kasa-banka/yeni?tur=odeme&cari=@customer.Id">+ Ödeme</a>
  <a class="admin-btn admin-btn--secondary" href="/yonetim/muhasebe/cek-senet/ekle?yon=Received&cari=@customer.Id">+ Çek/senet</a><a class="admin-btn admin-btn--secondary" href="/yonetim/crm/musteriler/duzenle/@customer.Id">Cari bilgileri</a></div>
<div class="report-kpis"><div class="report-kpi"><span class="report-kpi__label">Güncel bakiye</span><strong class="report-kpi__value">@TurkishNumbers.Money(Math.Abs(balance)) @(balance > 0 ? "borçlu" : balance < 0 ? "alacaklı" : "")</strong></div><div class="report-kpi"><span class="report-kpi__label">Açık fatura</span><strong class="report-kpi__value">@open.Count (@TurkishNumbers.Money(open.Sum(x => x.Open)))</strong></div></div>
<form class="admin-panel admin-actions" method="get"><label for="bas" style="margin:0">Başlangıç</label><input id="bas" type="date" name="bas" value="@from?.ToString("yyyy-MM-dd")" /><label for="bit" style="margin:0">Bitiş</label><input id="bit" type="date" name="bit" value="@to?.ToString("yyyy-MM-dd")" /><button class="admin-btn">Uygula</button><button class="admin-btn admin-btn--secondary" name="csv" value="true">CSV</button><button class="admin-btn admin-btn--secondary" type="button" onclick="window.print()">Yazdır</button></form>
<div class="admin-panel" style="overflow-x:auto"><table class="admin-table"><thead><tr><th>Tarih</th><th>İşlem</th><th>Belge</th><th>Açıklama</th><th>Borç</th><th>Alacak</th><th>Bakiye</th></tr></thead><tbody>
@foreach (var x in Model) { <tr><td>@x.Date.ToString("dd.MM.yyyy")</td><td>@x.Type</td><td>@if (x.Url is not null) { <a href="@x.Url">@x.Document</a> } else { @x.Document }</td><td>@x.Description</td><td>@(x.Debit > 0 ? x.Debit.ToString("N2", TurkishNumbers.Culture) : "")</td><td>@(x.Credit > 0 ? x.Credit.ToString("N2", TurkishNumbers.Culture) : "")</td><td>@x.Balance.ToString("N2", TurkishNumbers.Culture)</td></tr> }
</tbody></table>@if (Model.Count == 0) { <p class="admin-muted">Hareket yok.</p> }</div>
<div class="admin-panel"><h2>Açılış bakiyesi / düzeltme</h2><p class="admin-muted">Artı: cari bize borçlu. Eksi: biz cariye borçluyuz. Kayıt silinmez, gerekirse ters tutarla düzeltilir.</p>
<form class="admin-actions" method="post" action="/yonetim/muhasebe/cariler/@customer.Id/duzeltme">@Html.AntiForgeryToken()<input type="date" name="date" value="@today" required aria-label="Tarih" /><input type="number" name="amount" step="0.01" required placeholder="Tutar" aria-label="Tutar" /><input name="description" required placeholder="Açıklama" aria-label="Açıklama" /><button class="admin-btn">Ekle</button></form></div>
