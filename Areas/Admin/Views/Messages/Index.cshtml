@model List<KarakusAluminyum.Web.Models.ContactMessage>
@{ViewData["Title"]="İletişim mesajları";}<h1>İletişim mesajları</h1><div class="admin-panel"><table class="admin-table"><thead><tr><th>Durum</th><th>Gönderen</th><th>İletişim</th><th>Hizmet</th><th>Tarih</th><th>İşlem</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@(x.IsRead?"Okundu":"Yeni")</td><td>@x.Name</td><td>@x.ContactInfo</td><td>@x.Service</td><td>@x.CreatedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td><td><div class="admin-actions"><a class="admin-btn" href="/yonetim/mesajlar/@x.Id">Aç</a><form method="post" action="/yonetim/mesajlar/sil/@x.Id" onsubmit="return confirm('Mesaj silinsin mi?')">@Html.AntiForgeryToken()<button class="admin-btn admin-btn--danger">Sil</button></form></div></td></tr>}</tbody></table></div>
