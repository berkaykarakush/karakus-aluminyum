@model KarakusAluminyum.Web.Models.UserAdminInput
@{ ViewData["Title"] = "Kullanıcı ekle"; }
<div class="admin-panel"><h1>Kullanıcı ekle</h1><form class="admin-form" method="post" action="/yonetim/kullanicilar/ekle">@Html.AntiForgeryToken()<div asp-validation-summary="All"></div><label asp-for="Email">E-posta</label><input asp-for="Email" autocomplete="email"/><span asp-validation-for="Email"></span><label asp-for="Password">Geçici parola</label><input asp-for="Password" type="password" autocomplete="new-password"/><span asp-validation-for="Password"></span><label asp-for="Role">Rol</label><select asp-for="Role"><option value="Editor">Editor</option><option value="Admin">Admin</option><option value="Accountant">Muhasebe</option></select><p class="admin-muted">Güçlü parola zorunludur. İlk girişte parola değiştirme ve e-posta doğrulama akışları sonraki güvenlik adımı olarak eklenmelidir.</p><button class="admin-btn" type="submit">Kullanıcı oluştur</button></form></div>
