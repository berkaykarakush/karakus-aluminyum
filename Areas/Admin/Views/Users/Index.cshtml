@model List<KarakusAluminyum.Web.Areas.Admin.Controllers.UserListRow>
@{ ViewData["Title"] = "Kullanıcı yönetimi"; }
<div class="admin-panel"><div class="admin-actions"><h1>Kullanıcı yönetimi</h1><a class="admin-btn" href="/yonetim/kullanicilar/ekle">Yeni kullanıcı</a></div><p class="admin-muted">Bu sayfaya yalnızca Admin rolü erişebilir.</p><table class="admin-table"><thead><tr><th>E-posta</th><th>Rol</th><th>Durum</th><th>İşlem</th></tr></thead><tbody>@foreach(var user in Model){<tr><td>@user.Email</td><td>@string.Join(", ", user.Roles)</td><td>@(user.IsLocked ? "Kilitli" : "Aktif")</td><td><form method="post" action="/yonetim/kullanicilar/kilitle/@user.Id">@Html.AntiForgeryToken()<button class="admin-btn" type="submit">@(user.IsLocked ? "Kilidi kaldır" : "Kilitle")</button></form></td></tr>}</tbody></table></div>
