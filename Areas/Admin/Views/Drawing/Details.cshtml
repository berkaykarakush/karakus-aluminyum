@model KarakusAluminyum.Web.Models.Drawing.DrawingList
@using System.Text.Json
@using KarakusAluminyum.Web.Models.Drawing
@using KarakusAluminyum.Web.Services.Drawing
@{
    var materials = (MaterialList)ViewBag.Materials;
    var suggested = (Dictionary<int, decimal>)ViewBag.SuggestedPrices;
    ViewData["Title"] = Model.Name;
    var quotes = (SelectList)ViewBag.Quotes;
    var items = Model.Items.OrderBy(x => x.SortOrder).ThenBy(x => x.Id).ToList();
    var json = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    var withSystem = items.Where(x => x.ProfileSystemId is not null).ToList();
}
<link rel="stylesheet" href="~/css/window-designer.css" asp-append-version="true" />
<div class="admin-actions wd-noprint">
  <h1>@Model.Name</h1>
  <a class="admin-btn admin-btn--secondary" href="/yonetim/cizim">Çizim listeleri</a>
  <a class="admin-btn admin-btn--secondary" href="/yonetim/cizim/duzenle/@Model.Id">Listeyi düzenle</a>
  @if (withSystem.Count > 0) { <a class="admin-btn admin-btn--secondary" href="/yonetim/cizim/optimizasyon?@string.Join("&", withSystem.Select(x => $"ids={x.Id}"))">Birlikte optimize et</a> }
  <a class="admin-btn admin-btn--secondary" href="/yonetim/cizim/olcu-listesi/@Model.Id">Ölçü listesi</a>
  <button class="admin-btn admin-btn--secondary" type="button" data-print="drawings" data-print-title="@Model.Name - Çizimler">Çizimi yazdır</button>
  <button class="admin-btn admin-btn--secondary" type="button" data-print="materials" data-print-title="@Model.Name - Malzemeler">Malzemeleri yazdır</button>
  <button class="admin-btn admin-btn--secondary" type="button" data-print="all" data-print-title="@Model.Name - Çizimler ve malzemeler">Hepsini yazdır</button>
</div>
<style>@@page{size:A4;margin:10mm}</style>
<div class="wd-sheet wd-pages">
  @* Her sayfada en fazla 9 çizim: çizim sayısı ne olursa olsun hücre ölçüsü değişmez. *@
  @{ var pages = items.Chunk(9).ToList(); var itemNotes = items.Where(x => !string.IsNullOrWhiteSpace(x.Notes)).ToList(); }
  @for (var p = 0; p < pages.Count; p++)
  {
    <section class="wd-page">
      <header class="wd-page__head">
        <div><strong>@Model.Name</strong><div class="admin-muted">@(Model.Customer is null ? "" : Model.Customer.Name + " · ")@items.Count çizim · @items.Sum(x => x.Quantity) adet</div></div>
        <span class="admin-muted">Sayfa @(p + 1) / @pages.Count</span>
      </header>
      <div class="wd-pos-grid">
        @foreach (var item in pages[p])
        {
          <article class="wd-pos">
            <header class="wd-pos__head">
              <div class="wd-pos__title">
                <strong>@item.Name</strong>
                <div class="admin-muted">@ProductCategories.Label(item.Category) · @Units.Size(item.WidthMm, item.HeightMm) @Units.Code · @item.Quantity adet</div>
                <div class="admin-actions wd-noprint wd-pos__links">
                  <a href="/yonetim/cizim/poz/@item.Id">Çizimi aç</a>
                  @if (item.ProfileSystemId is not null) { <a href="/yonetim/cizim/imalat/@item.Id">İmalat föyü</a> }
                </div>
              </div>
              <partial name="_BrandMark" model="item.Brand" />
            </header>
            <svg data-drawing="@JsonSerializer.Serialize(WindowDrawings.Drawing(item), json)" role="img" aria-label="@item.Name çizimi"></svg>
          </article>
        }
      </div>
    </section>
  }
  @if (!string.IsNullOrWhiteSpace(Model.Notes) || itemNotes.Count > 0)
  {
    <section class="wd-page-notes">
      <h2>Notlar</h2>
      @if (!string.IsNullOrWhiteSpace(Model.Notes)) { <p style="white-space:pre-wrap">@Model.Notes</p> }
      @foreach (var item in itemNotes) { <p style="white-space:pre-wrap"><strong>@item.Name:</strong> @item.Notes</p> }
    </section>
  }
  <div class="admin-panel wd-noprint">
    <h2>Teklife ekle</h2>
    @if (quotes.Any())
    {
      <form method="post" action="/yonetim/cizim/teklife-ekle/@Model.Id">
        @Html.AntiForgeryToken()
        <p class="admin-muted">Birim fiyat yazılan çizimler teklife satır olarak eklenir.</p>
        <select name="quoteId" aria-label="Taslak teklif" asp-items="quotes" style="margin-bottom:10px"></select>
        <table class="admin-table wd-table">
          <thead><tr><th>Çizim</th><th>Adet</th><th>Birim fiyat (₺)</th></tr></thead>
          <tbody>
          @foreach (var item in items)
          {
            <tr>
              <td>@item.Name</td>
              <td>@item.Quantity</td>
              <td><input type="number" name="prices[@item.Id]" min="0" step="0.01" value="@(suggested.TryGetValue(item.Id, out var price) ? price.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" aria-label="@item.Name birim fiyat" /></td>
            </tr>
          }
          </tbody>
        </table>
        <button class="admin-btn" style="margin-top:10px">Teklife ekle</button>
      </form>
    }
    else { <p class="admin-muted">Taslak durumunda teklif yok. <a href="/yonetim/crm/teklifler/ekle">Yeni teklif oluşturun.</a></p> }
  </div>
  @* Yazdırma seçilen moda göre çizimleri, malzemeleri veya ikisini basar; Ctrl+P yalnızca çizimleri basar. *@
  <div class="wd-materials">
    <header class="wd-materials__head">
      <h2>Malzeme listesi</h2>
      <div class="admin-muted">@Model.Name@(Model.Customer is null ? "" : " · " + Model.Customer.Name) · @items.Count çizim · @items.Sum(x => x.Quantity) adet</div>
    </header>
    <partial name="_Materials" model="materials" />
  </div>
</div>
<script src="~/js/window-drawing.js" asp-append-version="true"></script>
<script>document.querySelectorAll("[data-drawing]").forEach((svg) => WindowDrawing.render(svg, JSON.parse(svg.dataset.drawing), { textScale: 2.4 }));
document.querySelectorAll("[data-print]").forEach((button) => button.addEventListener("click", () => {
  const root = document.documentElement, title = document.title;
  root.dataset.printMode = button.dataset.print;
  document.title = button.dataset.printTitle; // kaydedilen PDF'in önerilen adı
  addEventListener("afterprint", () => { delete root.dataset.printMode; document.title = title; }, { once: true });
  window.print();
}));</script>
