@model KarakusAluminyum.Web.Models.Drawing.DrawingList
@using KarakusAluminyum.Web.Models.Drawing
@using KarakusAluminyum.Web.Services.Drawing
@{
    var materials = (MaterialList)ViewBag.Materials;
    ViewData["Title"] = Model.Name;
    var quotes = (List<KarakusAluminyum.Web.Models.Crm.Quote>)ViewBag.Quotes;
    var pozlar = PozSheet.Build(Model.Items.OrderBy(x => x.SortOrder).ThenBy(x => x.Id));
    var items = pozlar.Select(x => x.Design).ToList();
    var withSystem = items.Where(x => x.ProfileSystemId is not null).ToList();
    var brands = items.Where(x => x.Brand is not null).Select(x => x.Brand!).DistinctBy(x => x.Id).ToList();
    var itemNotes = items.Where(x => !string.IsNullOrWhiteSpace(x.Notes)).ToList();
    var culture = KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture;
}
<link rel="stylesheet" href="~/css/window-designer.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/poz-list.css" asp-append-version="true" />
<div class="admin-actions wd-noprint">
  <h1>@Model.Name</h1>
  <a class="admin-btn admin-btn--secondary" href="/yonetim/cizim">Çizim listeleri</a>
  <a class="admin-btn" href="/yonetim/cizim/duzenle/@Model.Id">Pozları düzenle</a>
  @if (withSystem.Count > 0) { <a class="admin-btn admin-btn--secondary" href="/yonetim/cizim/optimizasyon?@string.Join("&", withSystem.Select(x => $"ids={x.Id}"))">Birlikte optimize et</a> }
  <a class="admin-btn admin-btn--secondary" href="/yonetim/cizim/olcu-listesi/@Model.Id">Ölçü listesi</a>
  <button class="admin-btn admin-btn--secondary" type="button" data-print="drawings" data-print-title="@Model.Name - Çizimler">Çizimi yazdır</button>
  <button class="admin-btn admin-btn--secondary" type="button" data-print="materials" data-print-title="@Model.Name - Malzemeler">Malzemeleri yazdır</button>
  <button class="admin-btn admin-btn--secondary" type="button" data-print="all" data-print-title="@Model.Name - Çizimler ve malzemeler">Hepsini yazdır</button>
</div>
<div class="admin-panel wd-noprint poz-options" aria-label="Çizim görünümü">
  <label><input type="checkbox" data-poz-option="inner" /> Ara ölçüler</label>
  <label><input type="checkbox" data-poz-option="outer" /> Dış ölçüler</label>
  <label><input type="checkbox" data-poz-option="glass" /> Cam ölçüleri</label>
  <label><input type="checkbox" data-poz-option="lines" /> Açıklama</label>
  <label><input type="checkbox" data-poz-option="mono" /> Siyah-beyaz</label>
  <label>Ölçek <input type="range" min="0.6" max="1.6" step="0.1" data-poz-option="zoom" /></label>
</div>
<style>@@page{size:A4;margin:10mm}</style>
<div class="wd-sheet wd-pages">
  <table class="poz-sheet wd-page">
    <thead><tr><td>
      <header class="poz-sheet__head">
        <dl><dt>Liste No</dt><dd>@Model.Id</dd><dt>Liste</dt><dd>@Model.Name</dd></dl>
        <dl><dt>Müşteri</dt><dd>@(Model.Customer?.Name ?? "-")</dd><dt>Tarih</dt><dd>@Model.UpdatedUtc.ToLocalTime().ToString("dd.MM.yyyy")</dd></dl>
        <dl><dt>Poz / Adet</dt><dd>@items.Count / @items.Sum(x => x.Quantity)</dd><dt>Toplam alan</dt><dd>@pozlar.Sum(x => x.AreaM2 * x.Design.Quantity).ToString("0.00", culture) m²</dd></dl>
        <div class="poz-sheet__brands">@foreach (var brand in brands) { @if (!string.IsNullOrEmpty(brand.LogoPath)) { <img src="@brand.LogoPath" alt="@brand.Name" /> } else { <span>@brand.Name</span> } }</div>
      </header>
    </td></tr></thead>
    <tbody><tr><td>
      <partial name="_PozList" model="pozlar" />
      <div class="poz-totals">
        <span>Ünite adedi: @items.Sum(x => x.Quantity)</span>
        <span>Toplam çevre: @pozlar.Sum(x => x.PerimeterM * x.Design.Quantity).ToString("0.0", culture) m</span>
        <span>Toplam alan: @pozlar.Sum(x => x.AreaM2 * x.Design.Quantity).ToString("0.00", culture) m²</span>
      </div>
    </td></tr></tbody>
  </table>
  @if (!string.IsNullOrWhiteSpace(Model.Notes) || itemNotes.Count > 0)
  {
    <section class="wd-page-notes">
      <h2>Notlar</h2>
      @if (!string.IsNullOrWhiteSpace(Model.Notes)) { <p style="white-space:pre-wrap">@Model.Notes</p> }
      @foreach (var item in itemNotes) { <p style="white-space:pre-wrap"><strong>@item.Name:</strong> @item.Notes</p> }
    </section>
  }
  @if (withSystem.Count > 0)
  {
    <div class="admin-panel wd-noprint">
      <h2>İmalat föyleri</h2>
      <div class="admin-actions">@foreach (var poz in pozlar.Where(x => x.Design.ProfileSystemId is not null)) { <a class="admin-btn admin-btn--secondary" href="/yonetim/cizim/imalat/@poz.Design.Id">Poz @poz.Position</a> }</div>
    </div>
  }
  <div class="admin-panel wd-noprint">
    <h2>Teklif</h2>
    <p class="admin-muted">Teklif bu listeden hazırlanır: her poz maliyetiyle kalem olur, kâr marjı, cam ve iskonto teklif ekranında seçilir. Çizimler teklifin sonuna eklenir.</p>
    <a class="admin-btn" href="/yonetim/crm/teklifler/ekle?liste=@Model.Id">Teklif hazırla</a>
    @if (quotes.Count > 0)
    {
      <table class="admin-table wd-table" style="margin-top:12px">
        <thead><tr><th>Teklif</th><th>Durum</th><th>Genel toplam</th></tr></thead>
        <tbody>
        @foreach (var q in quotes)
        {
          <tr><td><a href="/yonetim/crm/teklifler/detay/@q.Id">@q.QuoteNumber - @q.Title</a></td><td>@(q.Status switch { KarakusAluminyum.Web.Models.Crm.QuoteStatus.Draft => "Taslak", KarakusAluminyum.Web.Models.Crm.QuoteStatus.Sent => "Gönderildi", KarakusAluminyum.Web.Models.Crm.QuoteStatus.Accepted => "Kabul edildi", KarakusAluminyum.Web.Models.Crm.QuoteStatus.Rejected => "Reddedildi", KarakusAluminyum.Web.Models.Crm.QuoteStatus.Expired => "Süresi doldu", _ => "Sözleşmeye dönüştürüldü" })</td><td>@q.GrandTotal.ToString("N2", culture) ₺</td></tr>
        }
        </tbody>
      </table>
    }
  </div>
  @* Yazdırma seçilen moda göre çizimleri, malzemeleri veya ikisini basar; Ctrl+P yalnızca çizimleri basar. *@
  <div class="wd-materials">
    <header class="wd-materials__head">
      <h2>Malzeme listesi</h2>
      <div class="admin-muted">@Model.Name@(Model.Customer is null ? "" : " · " + Model.Customer.Name) · @items.Count poz · @items.Sum(x => x.Quantity) adet</div>
    </header>
    <partial name="_Materials" model="materials" />
  </div>
</div>
<script src="~/js/window-drawing.js" asp-append-version="true"></script>
<script src="~/js/poz-list.js" asp-append-version="true"></script>
<script>document.querySelectorAll("[data-print]").forEach((button) => button.addEventListener("click", () => {
  const root = document.documentElement, title = document.title;
  root.dataset.printMode = button.dataset.print;
  document.title = button.dataset.printTitle; // kaydedilen PDF'in önerilen adı
  addEventListener("afterprint", () => { delete root.dataset.printMode; document.title = title; }, { once: true });
  window.print();
}));</script>
