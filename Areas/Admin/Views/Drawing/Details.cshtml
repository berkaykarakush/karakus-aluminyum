@model KarakusAluminyum.Web.Models.Drawing.WindowDesign
@using System.Text.Json
@using KarakusAluminyum.Web.Models.Drawing
@using KarakusAluminyum.Web.Services.Drawing
@inject KarakusAluminyum.Web.Services.SiteSettingsProvider SiteSettings
@{
    var production = (await SiteSettings.GetAsync()).ProductionDetails;
    var suggested = ViewBag.SuggestedPrice as decimal?;
    ViewData["Title"] = Model.Name;
    var quotes = (SelectList)ViewBag.Quotes;
}
<link rel="stylesheet" href="~/css/window-designer.css" asp-append-version="true" />
<div class="admin-actions wd-noprint">
  <h1>@Model.Name</h1>
  <a class="admin-btn admin-btn--secondary" href="/yonetim/cizim?tur=@Model.Category">Çizim listesi</a>
  <a class="admin-btn admin-btn--secondary" href="/yonetim/cizim/duzenle/@Model.Id">Düzenle</a>
  @if (production && Model.ProfileSystemId is not null) { <a class="admin-btn admin-btn--secondary" href="/yonetim/cizim/imalat/@Model.Id">İmalat föyü</a> }
  <button class="admin-btn admin-btn--secondary" type="button" onclick="window.print()">Yazdır / PDF kaydet</button>
</div>
<div class="wd-sheet">
  <div class="admin-panel">
    <h2>@Model.Name</h2>
    <p class="admin-muted">@ProductCategories.Label(Model.Category)@(Model.Customer is null ? "" : " · " + Model.Customer.Name) · @Units.Size(Model.WidthMm, Model.HeightMm) @Units.Code · @Model.Quantity adet</p>
    <svg id="wd-sheet-drawing" role="img" aria-label="@Model.Name çizimi"></svg>
    @if (!string.IsNullOrWhiteSpace(Model.Notes)) { <p style="white-space:pre-wrap">@Model.Notes</p> }
  </div>
  <div class="admin-panel wd-noprint">
    <h2>Teklife ekle</h2>
    @if (quotes.Any())
    {
      <form class="admin-actions" method="post" action="/yonetim/cizim/teklife-ekle/@Model.Id">
        @Html.AntiForgeryToken()
        <select name="quoteId" aria-label="Taslak teklif" asp-items="quotes"></select>
        <input type="number" name="unitPrice" min="0" step="0.01" value="@suggested?.ToString(System.Globalization.CultureInfo.InvariantCulture)" placeholder="Birim fiyat (₺)" aria-label="Birim fiyat" required style="padding:9px 11px;border:1px solid #cfd5d9;border-radius:8px" />
        <button class="admin-btn">Ekle</button>
      </form>
    }
    else { <p class="admin-muted">Taslak durumunda teklif yok. <a href="/yonetim/crm/teklifler/ekle">Yeni teklif oluşturun.</a></p> }
  </div>
</div>
<script src="~/js/window-drawing.js" asp-append-version="true"></script>
<script>WindowDrawing.render(document.getElementById("wd-sheet-drawing"), @Html.Raw(JsonSerializer.Serialize(WindowDrawings.Drawing(Model), new JsonSerializerOptions(JsonSerializerDefaults.Web))));</script>
