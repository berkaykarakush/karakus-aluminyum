@model KarakusAluminyum.Web.Models.Drawing.WindowDesign
@using System.Text.Json
@using KarakusAluminyum.Web.Services.Drawing
@using KarakusAluminyum.Web.Models.Drawing
@{
    ViewData["Title"] = "İmalat föyü";
    var c = (WindowCalculation)ViewBag.Calculation;
    var plans = (List<BarPlan>)ViewBag.Plans;
    var quotes = (SelectList)ViewBag.Quotes;
    var s = Model.ProfileSystem!;
    var drawing = DrawingCalculation.Drawing(Model, s);
    var glassLists = (SelectList)ViewBag.GlassLists;
    var glassCount = c.Glass.Sum(g => g.Count) * Model.Quantity;
}
<link rel="stylesheet" href="~/css/window-designer.css" asp-append-version="true" />
<div class="admin-actions wd-noprint">
  <h1>İmalat föyü</h1>
  <a class="admin-btn" href="/yonetim/cizim/duzenle/@Model.Id">Çizime dön</a>
  <button class="admin-btn" type="button" onclick="window.print()">Yazdır / PDF kaydet</button>
</div>
<div class="wd-sheet">
  <div class="admin-panel">
    <h2>@Model.Name</h2>
    <p class="admin-muted">@ProductCategories.Label(Model.Category) · @Model.Customer?.Name · @s.Name · @Units.Size(Model.WidthMm, Model.HeightMm) @Units.Code · @Model.Quantity adet</p>
    @if (c.Errors.Count > 0) { <ul class="wd-errors">@foreach (var e in c.Errors) { <li>@e</li> }</ul> }
    @if (c.Warnings.Count > 0) { <ul class="wd-warnings">@foreach (var w in c.Warnings) { <li>@w</li> }</ul> }
    <svg id="wd-sheet-drawing" role="img" aria-label="Pencere çizimi"></svg>
    @if (!string.IsNullOrWhiteSpace(Model.Notes)) { <p style="white-space:pre-wrap">@Model.Notes</p> }
  </div>
  @if (c.IsValid)
  {
    <div class="wd-sheet-grid">
      <div class="admin-panel">
        <h2>Kesim listesi (1 adet)</h2>
        <table class="admin-table wd-table"><thead><tr><th>Profil</th><th>Parça</th><th>@Units.Code</th><th>Ad.</th><th>Kesim</th></tr></thead><tbody>
          @foreach (var x in c.Cuts) { <tr><td>@x.Profile</td><td>@x.Label</td><td>@Units.Format(x.LengthMm)</td><td>@x.Count</td><td>@x.Ends</td></tr> }
        </tbody></table>
      </div>
      <div class="admin-panel">
        @if (c.Panels.Count > 0)
        {
          <h2>Panel listesi (1 adet)</h2>
          <table class="admin-table wd-table"><thead><tr><th>G × Y (@Units.Code)</th><th>Ad.</th><th>m²</th></tr></thead><tbody>
            @foreach (var x in c.Panels) { <tr><td>@Units.Size(x.WidthMm, x.HeightMm)</td><td>@x.Count</td><td>@x.AreaM2.ToString("0.###")</td></tr> }
          </tbody></table>
        }
        @if (c.Hardware.Count > 0)
        {
          <h2 style="margin-top:16px">Donanım (1 adet)</h2>
          <table class="admin-table wd-table"><thead><tr><th>Donanım</th><th>Ad.</th></tr></thead><tbody>
            @foreach (var x in c.Hardware) { <tr><td>@x.Name</td><td>@x.Count</td></tr> }
          </tbody></table>
        }
      </div>
      <div class="admin-panel">
        <h2>Maliyet (camlar hariç)</h2>
        <table class="admin-table wd-table"><tbody>
          <tr><td>Profil</td><td>@c.ProfileCost.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture) ₺</td></tr>
          @if (c.PanelCost > 0) { <tr><td>Panel</td><td>@c.PanelCost.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture) ₺</td></tr> }
          <tr><td>Donanım</td><td>@c.HardwareCost.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture) ₺</td></tr>
          <tr><td>İşçilik</td><td>@c.LaborCost.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture) ₺</td></tr>
          <tr><td>Birim maliyet</td><td>@c.UnitCost.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture) ₺</td></tr>
          <tr><td>Birim satış</td><td><strong>@c.UnitPrice.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture) ₺</strong></td></tr>
          <tr><td>Toplam (@Model.Quantity adet)</td><td><strong>@c.TotalPrice.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture) ₺</strong></td></tr>
        </tbody></table>
      </div>
    </div>
    <div class="admin-panel">
      <h2>Profil kesim optimizasyonu (@Model.Quantity adet)</h2>
      <partial name="_BarPlans" model="plans" />
    </div>
    <div class="admin-panel wd-noprint">
      <h2>Camlar</h2>
      @if (glassCount > 0)
      {
        <p class="admin-muted">Bu çizimde @glassCount adet cam var. Camlar doğramadan ayrı listelenir ve ayrı fiyatlanır.</p>
        <form class="admin-actions" method="post" action="/yonetim/camlar/cizimden/@Model.Id">
          @Html.AntiForgeryToken()
          <select name="listId" aria-label="Cam listesi" asp-items="glassLists"><option value="">Yeni cam listesi oluştur</option></select>
          <button class="admin-btn">Cam ölçülerini listeye aktar</button>
        </form>
      }
      else { <p class="admin-muted">Bu çizimde cam yok.</p> }
    </div>
    <div class="admin-panel wd-noprint">
      <h2>Teklife ekle</h2>
      @if (quotes.Any())
      {
        <form class="admin-actions" method="post" action="/yonetim/cizim/teklife-ekle/@Model.Id">
          @Html.AntiForgeryToken()
          <select name="quoteId" aria-label="Taslak teklif" asp-items="quotes"></select>
          <button class="admin-btn">Birim satış fiyatıyla ekle</button>
        </form>
      }
      else { <p class="admin-muted">Taslak durumunda teklif yok. <a href="/yonetim/crm/teklifler/ekle">Yeni teklif oluşturun.</a></p> }
    </div>
  }
</div>
<script src="~/js/window-drawing.js" asp-append-version="true"></script>
<script>WindowDrawing.render(document.getElementById("wd-sheet-drawing"), @Html.Raw(JsonSerializer.Serialize(drawing, new JsonSerializerOptions(JsonSerializerDefaults.Web))));</script>
