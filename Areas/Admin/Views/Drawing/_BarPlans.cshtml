@model IEnumerable<KarakusAluminyum.Web.Services.Drawing.BarPlan>
@foreach (var plan in Model)
{
    <h3>@plan.Profile: @plan.Bars.Count boy (@Units.WithLabel(plan.BarLengthMm)), verim %@plan.UtilisationPercent, toplam fire @Units.WithLabel(plan.TotalWasteMm)</h3>
    @* Aynı ölçülerle kesilen ardışık boylar tek satırda gösterilir; parça adları yalnızca ipucunda kalır. *@
    var start = 0;
    while (start < plan.Bars.Count)
    {
        var bar = plan.Bars[start];
        var end = start + 1;
        while (end < plan.Bars.Count && plan.Bars[end].Pieces.Select(p => p.LengthMm).SequenceEqual(bar.Pieces.Select(p => p.LengthMm))) { end++; }
        var group = plan.Bars.Skip(start).Take(end - start).ToList();
        <div class="admin-muted">@(group.Count == 1 ? $"Boy {start + 1}" : $"Boy {start + 1}–{end} ({group.Count} boy)"): @(group.Count == 1 ? "fire" : "her boyda fire") @Units.WithLabel(bar.WasteMm)</div>
        <div class="wd-bar">
            @for (var i = 0; i < bar.Pieces.Count; i++)
            {
                var piece = bar.Pieces[i];
                var labels = string.Join(", ", group.Select(b => b.Pieces[i].Label).Distinct());
                var percent = (piece.LengthMm / plan.BarLengthMm * 100m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                <span style="width:@(percent)%" title="@labels: @Units.WithLabel(piece.LengthMm)">@Units.Format(piece.LengthMm)</span>
            }
        </div>
        start = end;
    }
}
