@model List<KarakusAluminyum.Web.Models.Drawing.DrawingList>
@using KarakusAluminyum.Web.Models.Drawing
@inject KarakusAluminyum.Web.Services.SiteSettingsProvider SiteSettings
@{
    var production = (await SiteSettings.GetAsync()).ProductionDetails;
    ViewData["Title"] = "Çizim listeleri";
    var current = ViewBag.Category as string;
    var newUrl = ProductCategories.All.Contains(current) ? $"/yonetim/cizim/ekle?tur={current}" : "/yonetim/cizim/ekle";
}
<link rel="stylesheet" href="~/css/window-designer.css" asp-append-version="true" />
<div class="admin-actions"><h1>Çizim listeleri</h1><a class="admin-btn" href="@newUrl">+ Yeni liste</a><a class="admin-btn" href="/yonetim/markalar">Markalar</a>@if (production) { <a class="admin-btn" href="/yonetim/cizim/sistemler">Sistemler</a> }<a class="admin-btn" href="/yonetim/camlar">Cam listeleri</a></div>
<nav class="wd-tabs" aria-label="Ürün türü">
  <a class="@(ProductCategories.All.Contains(current) ? "" : "is-active")" href="/yonetim/cizim">Tümü</a>
  @foreach (var category in ProductCategories.All) { <a class="@(current == category ? "is-active" : "")" href="/yonetim/cizim?tur=@category">@ProductCategories.Label(category)</a> }
</nav>
<div class="admin-panel">
  <table class="admin-table">
    <thead><tr><th>Liste</th><th>Müşteri</th><th>Ürünler</th><th>Çizim</th><th>Adet</th><th>Güncelleme</th><th>İşlem</th></tr></thead>
    <tbody>
    @foreach (var x in Model)
    {
      <tr>
        <td><a href="/yonetim/cizim/detay/@x.Id">@x.Name</a></td>
        <td>@x.Customer?.Name</td>
        <td>@string.Join(", ", x.Items.Select(i => i.Category).Distinct().Select(ProductCategories.Label))</td>
        <td>@x.Items.Count</td>
        <td>@x.Items.Sum(i => i.Quantity)</td>
        <td>@x.UpdatedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
        <td>
          <div class="admin-actions">
            <a class="admin-btn" href="/yonetim/cizim/detay/@x.Id">Görüntüle</a>
            <a class="admin-btn" href="/yonetim/cizim/duzenle/@x.Id">Düzenle</a>
            <form method="post" action="/yonetim/cizim/kopyala/@x.Id">@Html.AntiForgeryToken()<button class="admin-btn">Kopyala</button></form>
            <form method="post" action="/yonetim/cizim/sil/@x.Id" onsubmit="return confirm('Bu liste ve içindeki tüm çizimler silinsin mi?')">@Html.AntiForgeryToken()<button class="admin-btn admin-btn--danger">Sil</button></form>
          </div>
        </td>
      </tr>
    }
    </tbody>
  </table>
  @if (Model.Count == 0) { <p class="admin-muted">Bu bölümde henüz çizim listesi yok.</p> }
</div>
