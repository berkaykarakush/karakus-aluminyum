@model KarakusAluminyum.Web.Models.Drawing.BulkDesignInputVm
@using KarakusAluminyum.Web.Models.Drawing
@{
    ViewData["Title"] = "Toplu çizim ekle";
    var selected = ViewBag.Category as string ?? ProductCategories.Aluminum;
}
<link rel="stylesheet" href="~/css/window-designer.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/document-editor.css" asp-append-version="true" />
<div class="admin-actions"><h1>Toplu çizim ekle</h1><a class="admin-btn" href="/yonetim/cizim">Çizim listesi</a></div>
<form id="db-form" class="doc-editor" method="post" action="/yonetim/cizim/toplu-ekle">
  @Html.AntiForgeryToken()
  <input type="hidden" asp-for="ItemsJson" />
  <div asp-validation-summary="All" class="doc-errors"></div>
  <section class="doc-card">
    <div class="doc-grid">
      <div><label for="db-category">Yeni satırların türü</label><select id="db-category">
        @foreach (var category in ProductCategories.All) { <option value="@category" selected="@(category == selected)">@ProductCategories.Label(category)</option> }
      </select></div>
      <div><label for="db-type">Yeni satırların tipi</label><select id="db-type"></select></div>
      <div><label asp-for="CustomerId">Müşteri (hepsi için)</label><select asp-for="CustomerId" asp-items="(SelectList)ViewBag.Customers"><option value="">-</option></select></div>
      <div>
        <label asp-for="ColorHex">Renk (hepsi için)</label>
        <input asp-for="ColorHex" type="color" style="height:34px;padding:2px" />
        <partial name="_ColorPicker" />
      </div>
    </div>
  </section>
  <section class="doc-card">
    <h2>Yapıştırarak ekle</h2>
    <p class="admin-muted">Her satıra bir çizim yazın veya Excel'den yapıştırın: <code>ad genişlik yükseklik adet</code>. Ad ve adet yazılmayabilir. Yeni satırlar yukarıda seçili tür ve tipi alır.</p>
    <textarea id="db-paste" rows="4" aria-label="Toplu çizim ölçüleri" placeholder="Salon 150 140 2&#10;Mutfak 90x120&#10;180 210"></textarea>
    <div class="doc-row"><label for="db-paste-unit" style="margin:0">Bu ölçülerin birimi</label><select id="db-paste-unit" style="flex:0 0 auto;width:auto!important"><option value="mm">mm</option><option value="cm">cm</option><option value="m">m</option></select><button type="button" class="doc-btn" id="db-paste-add">Listeye ekle</button><span id="db-paste-note" class="admin-muted"></span></div>
  </section>
  <section class="doc-card">
    <h2>Çizimler</h2>
    <p class="admin-muted">Ad boş kalırsa sırayla "Poz 1, Poz 2" verilir. Kapı açılımı, kemer, panel sayısı gibi ayrıntıları kaydettikten sonra çizimi açıp düzenleyebilirsiniz.</p>
    <div style="overflow-x:auto">
      <table class="gl-table db-table">
        <thead><tr><th></th><th>Tür</th><th>Tip</th><th>Ad</th><th>Genişlik</th><th>Yükseklik</th><th>Adet</th><th></th></tr></thead>
        <tbody id="db-rows"></tbody>
      </table>
    </div>
    <div class="doc-row"><button type="button" class="doc-btn" id="db-add">+ Satır ekle</button><strong id="db-totals"></strong></div>
  </section>
  <div class="doc-actions"><button class="admin-btn" type="submit">Hepsini kaydet</button><a class="admin-btn" href="/yonetim/cizim">İptal</a></div>
</form>
<script src="~/js/window-drawing.js" asp-append-version="true"></script>
<script src="~/js/drawing-bulk.js" asp-append-version="true"></script>
