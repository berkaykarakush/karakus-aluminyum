@model KarakusAluminyum.Web.Models.Drawing.DesignInputVm
@using KarakusAluminyum.Web.Models.Drawing
@inject KarakusAluminyum.Web.Services.SiteSettingsProvider SiteSettings
@{
    var production = (await SiteSettings.GetAsync()).ProductionDetails;
    var label = ProductCategories.Label(Model.Category);
    ViewData["Title"] = "Çizim: " + label;
    var action = $"/yonetim/cizim/poz/{Model.Id}";
    var templates = new[] { ("fixed", "Sabit"), ("single", "Tek kanat"), ("double", "Çift kanat"), ("triple", "Üçlü"), ("sliding", "Sürme"), ("transom", "Üst vasistas"), ("door", "Kapı") };
    var openings = new[] { ("fixed", "Sabit"), ("left", "Sola menteşe"), ("right", "Sağa menteşe"), ("tilt", "Vasistas"), ("tiltLeft", "Açılır-devrilir sol"), ("tiltRight", "Açılır-devrilir sağ"), ("slideLeft", "Sürme sola"), ("slideRight", "Sürme sağa"), ("doorLeft", "Kapı sol"), ("doorRight", "Kapı sağ") };
}
<link rel="stylesheet" href="~/css/window-designer.css" asp-append-version="true" />
<div class="admin-actions wd-noprint"><h1>@ViewData["Title"]</h1><a class="admin-btn" href="/yonetim/cizim/duzenle/@Model.DrawingListId">Listeye dön</a><a class="admin-btn" href="/yonetim/cizim/detay/@Model.DrawingListId">Çizimleri görüntüle</a>@if (production && Model.ProfileSystemId is not null) { <a class="admin-btn" href="/yonetim/cizim/imalat/@Model.Id">İmalat föyü</a> }</div>
<form id="wd-form" method="post" action="@action">
  @Html.AntiForgeryToken()
  <input type="hidden" asp-for="LayoutJson" />
  <input type="hidden" asp-for="Category" />
  <div asp-validation-summary="All" class="wd-errors"></div>
  <div class="wd-simple">
    <div>
      <div class="wd-panel">
        <p class="wd-step"><b>1</b> Ölçü</p>
        <label asp-for="Name">Çizim adı</label><input asp-for="Name" required placeholder="Örn. Salon penceresi" />
        <div class="wd-pair">
          <div><label asp-for="WidthMm">Genişlik</label><input asp-for="WidthMm" type="number" min="200" max="20000" /></div>
          <div><label asp-for="HeightMm">Yükseklik</label><input asp-for="HeightMm" type="number" min="200" max="20000" /></div>
        </div>
        <label asp-for="Quantity">Adet</label><input asp-for="Quantity" type="number" min="1" />
        <label asp-for="BrandId">Marka</label>
        <select asp-for="BrandId" data-brand-select>
          <option value="">Marka yok</option>
          @foreach (var b in ((List<Brand>)ViewBag.Brands).Where(b => b.IsActive || b.Id == Model.BrandId)) { <option value="@b.Id" data-logo="@b.LogoPath">@b.Name</option> }
        </select>
        @if (production)
        {
          <label asp-for="ProfileSystemId">Profil sistemi</label>
          <select asp-for="ProfileSystemId">
            <option value="">Seçilmedi</option>
            @foreach (var s in ((List<ProfileSystem>)ViewBag.Systems).Where(s => s.IsActive || s.Id == Model.ProfileSystemId)) { <option value="@s.Id">@s.Name</option> }
          </select>
        }
      </div>
      <div class="wd-panel">
        <p class="wd-step"><b>2</b> Tip seçin</p>
        <div class="wd-pick">
          @foreach (var (key, text) in templates) { <button type="button" data-template="@key">@text</button> }
        </div>
      </div>
      <div class="wd-panel">
        <p class="wd-step"><b>3</b> Bölmeye tıklayıp açılımı seçin</p>
        <div class="wd-pick">
          @foreach (var (key, text) in openings) { <button type="button" data-opening="@key">@text</button> }
        </div>
        <div class="wd-actions-row">
          <button type="button" class="wd-btn" data-split="v" data-count="2">Yan yana böl</button>
          <button type="button" class="wd-btn" data-split="h" data-count="2">Üst üste böl</button>
          <button type="button" class="wd-btn" id="wd-merge">Birleştir</button>
        </div>
        <div id="wd-sizes"></div>
      </div>
      <details class="wd-panel">
        <summary>Gelişmiş ayarlar</summary>
        <label asp-for="Shape">Şekil</label>
        <select asp-for="Shape"><option value="rect">Dikdörtgen</option><option value="arch">Kemerli</option><option value="slopeL">Eğimli (sol alçak)</option><option value="slopeR">Eğimli (sağ alçak)</option></select>
        <div id="wd-param-row" hidden><label id="wd-param-label" asp-for="ShapeParamMm">Şekil ölçüsü</label><input asp-for="ShapeParamMm" type="number" min="0" /></div>
        <label asp-for="ColorHex">Renk</label>
        <input asp-for="ColorHex" type="color" style="height:34px;padding:2px" />
        <partial name="_ColorPicker" />
        <div class="wd-actions-row">
          <button type="button" class="wd-btn" data-split="v" data-count="3">Yan yana 3</button>
          <button type="button" class="wd-btn" data-split="h" data-count="3">Üst üste 3</button>
          <button type="button" class="wd-btn" data-split="v" data-count="2" data-sliding="true">Sürme 2</button>
          <button type="button" class="wd-btn" data-split="v" data-count="3" data-sliding="true">Sürme 3</button>
        </div>
        <label style="margin-top:12px"><input type="checkbox" id="wd-fill-panel" style="width:auto" /> Seçili bölme panel olsun</label>
        <label asp-for="Notes">Notlar</label><textarea asp-for="Notes" rows="3"></textarea>
      </details>
    </div>
    <div>
      <div class="wd-canvas-panel"><span id="wd-brand-mark" class="wd-brand wd-brand--canvas" hidden></span>
                <svg id="wd-canvas" role="img" aria-label="Pencere çizimi"></svg>
        <div class="wd-summary-bar">
          <span class="admin-muted">Bölme ölçülerinin toplamı dış ölçüye eşittir.</span>
          <div class="wd-canvas-actions" style="margin:0">
            <button type="button" class="wd-btn" id="wd-undo">Geri al</button>
            <button type="button" class="wd-btn" id="wd-redo">Yinele</button>
            <button class="admin-btn" type="submit">Kaydet</button>
          </div>
        </div>
        @if (production)
        {
          <div id="wd-alerts"></div>
          <p id="wd-summary" class="admin-muted" style="margin:8px 2px 0"></p>
          <div id="wd-result"></div>
        }
      </div>
    </div>
  </div>
</form>
<script src="~/js/window-drawing.js" asp-append-version="true"></script>
<script src="~/js/window-designer.js" asp-append-version="true"></script>
<script src="~/js/drawing-brand.js" asp-append-version="true"></script>
@if (production) { <script src="~/js/drawing-production.js" asp-append-version="true"></script> }
