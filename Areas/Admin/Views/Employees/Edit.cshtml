@model KarakusAluminyum.Web.Models.Accounting.Employee
@{ var editing = Model.Id != 0; ViewData["Title"] = editing ? "Personeli düzenle" : "Yeni personel"; var action = editing ? $"/yonetim/muhasebe/personel/duzenle/{Model.Id}" : "/yonetim/muhasebe/personel/ekle"; }
<div class="admin-actions"><h1>@ViewData["Title"]</h1><a class="admin-btn" href="/yonetim/muhasebe/personel">Personel</a></div>
<div class="admin-panel"><form class="admin-form" method="post" action="@action">@Html.AntiForgeryToken()
  <div asp-validation-summary="All"></div>
  <label asp-for="Name">Ad soyad</label><input asp-for="Name" required />
  <label asp-for="Position">Görev</label><input asp-for="Position" />
  <label asp-for="Phone">Telefon</label><input asp-for="Phone" />
  <label asp-for="Iban">IBAN</label><input asp-for="Iban" />
  <label asp-for="NetSalary">Net maaş (TL)</label><input asp-for="NetSalary" type="number" step="0.01" min="0" />
  <label for="StartDate">İşe başlama</label><input id="StartDate" type="date" name="StartDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
  <p><label><input asp-for="IsActive" /> Aktif</label></p>
  <div class="admin-actions"><button class="admin-btn">Kaydet</button></div>
</form></div>
