@model KarakusAluminyum.Web.Models.Drawing.GlassType
@{
    var editing = Model.Id != 0;
    ViewData["Title"] = editing ? "Cam tipini düzenle" : "Yeni cam tipi";
    var action = editing ? $"/yonetim/camlar/tipler/duzenle/{Model.Id}" : "/yonetim/camlar/tipler/ekle";
}
<h1>@ViewData["Title"]</h1>
<div class="admin-panel">
  <form class="admin-form" method="post" action="@action">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>
    <label asp-for="Name">Cam adı</label><input asp-for="Name" required />
    <label asp-for="PricePerM2">m² fiyatı (₺)</label><input asp-for="PricePerM2" type="number" step="0.01" />
    <p><label><input asp-for="IsActive" type="checkbox" style="width:auto" /> Aktif</label></p>
    <div class="admin-actions"><button class="admin-btn" type="submit">Kaydet</button><a href="/yonetim/camlar/tipler">İptal</a></div>
  </form>
</div>
