@model List<KarakusAluminyum.Web.Models.AuditLog>
@{ ViewData["Title"] = "Denetim kayıtları"; }
<div class="admin-panel"><h1>Denetim kayıtları</h1><p class="admin-muted">Son 500 kayıt. Bu ekran yalnızca Admin rolüne açıktır.</p><table class="admin-table"><thead><tr><th>Tarih (UTC)</th><th>Kullanıcı</th><th>İşlem</th><th>Kayıt</th><th>Detay</th><th>IP</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.CreatedUtc.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@item.ActorEmail</td><td>@item.Action</td><td>@item.EntityType #@item.EntityId</td><td>@item.Details</td><td>@item.IpAddress</td></tr>}</tbody></table></div>
