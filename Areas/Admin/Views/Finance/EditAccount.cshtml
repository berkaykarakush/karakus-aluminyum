@model KarakusAluminyum.Web.Models.Accounting.FinanceAccount
@using KarakusAluminyum.Web.Models.Accounting
@{ var editing = Model.Id != 0; ViewData["Title"] = editing ? "Hesabı düzenle" : "Yeni hesap"; var action = editing ? $"/yonetim/muhasebe/kasa-banka/hesap/duzenle/{Model.Id}" : "/yonetim/muhasebe/kasa-banka/hesap/ekle"; }
<div class="admin-actions"><h1>@ViewData["Title"]</h1><a class="admin-btn" href="/yonetim/muhasebe/kasa-banka">Kasa ve banka</a></div>
<div class="admin-panel"><form class="admin-form" method="post" action="@action">@Html.AntiForgeryToken()
  <div asp-validation-summary="All"></div>
  <label asp-for="Name">Hesap adı</label><input asp-for="Name" required />
  <label asp-for="Kind">Tür</label><select asp-for="Kind">@foreach (var k in Enum.GetValues<FinanceAccountKind>()) { <option value="@k">@AccountingLabels.Label(k)</option> }</select>
  <label asp-for="Currency">Para birimi</label><select asp-for="Currency">@foreach (var c in AccountingLabels.Currencies) { <option value="@c">@c</option> }</select>
  <label asp-for="Iban">IBAN</label><input asp-for="Iban" />
  <label asp-for="OpeningBalance">Açılış bakiyesi</label><input asp-for="OpeningBalance" type="number" step="0.01" />
  <p><label><input asp-for="IsActive" /> Aktif</label></p>
  <div class="admin-actions"><button class="admin-btn">Kaydet</button></div>
</form></div>
