@model KarakusAluminyum.Web.Models.Production.ServiceRequest
@using KarakusAluminyum.Web.Services.Documents
@{
    // Servis talep formu: ekibe verilir, sahada tespit ve yapılan işlem elle doldurulup müşteriye imzalatılır.
    Layout = null;
    var printed = PrintDates.From(Context.Request);
    var head = new BrandHeadVm("SERVİS TALEP FORMU", printed.ToString("dd.MM.yyyy"));
}
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Servis talep formu - @Model.Number</title>
  <link rel="stylesheet" href="~/css/document-print.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
</head>
<body class="doc doc--proforma">
  <partial name="~/Areas/Admin/Views/Shared/_BrandLayer.cshtml" />
  <div class="doc-toolbar"><a class="doc-toolbar__link" href="/yonetim/servis/detay/@Model.Id">Talebe dön</a><partial name="~/Areas/Admin/Views/Shared/_PrintDate.cshtml" model='new PrintDateVm(printed, Model.ReceivedOn, "Talep tarihi")' /><button type="button" onclick="window.print()">Yazdır / PDF kaydet</button></div>
  <table class="doc-sheet">
    <thead><tr><td><partial name="~/Areas/Admin/Views/Shared/_BrandHead.cshtml" model="head" /></td></tr></thead>
    <tfoot><tr><td><partial name="~/Areas/Admin/Views/Shared/_BrandFoot.cshtml" /></td></tr></tfoot>
    <tbody><tr><td class="doc-body">
      <partial name="_ServiceHead" model="Model" />
      <div class="sv-row">
        <div class="sv-field"><span>Planlanan ziyaret</span>@(Model.PlannedOn?.ToString("dd.MM.yyyy") ?? "")@(Model.PlannedAt is TimeOnly at ? " " + at.ToString("HH:mm") : "")&nbsp;</div>
        <div class="sv-field"><span>Servis ekibi</span>@(Model.Installer?.Name ?? "")&nbsp;</div>
        <div class="sv-field"><span>Varış saati</span>&nbsp;</div>
        <div class="sv-field"><span>Çıkış saati</span>&nbsp;</div>
      </div>
      <div class="sv-section"><h3>Tespit</h3><div class="sv-box"></div></div>
      <div class="sv-section"><h3>Yapılan işlem</h3><div class="sv-box sv-box--tall"></div></div>
      <table class="pf-lines">
        <thead><tr><th>Kullanılan parça</th><th class="pf-num">Miktar</th><th>Birim</th></tr></thead>
        <tbody>@for (var i = 0; i < 4; i++) { <tr><td>&nbsp;</td><td></td><td></td></tr> }</tbody>
      </table>
      <p><span class="sv-check">☐ Sorun giderildi</span><span class="sv-check">☐ Tekrar ziyaret gerekli</span><span class="sv-check">☐ Parça bekleniyor</span></p>
      <p><span class="sv-check">☐ Garanti kapsamında</span><span class="sv-check">☐ Ücretli · Tutar: ................ ₺</span></p>
      <partial name="_ServiceSign" />
    </td></tr></tbody>
  </table>
  <div class="doc-print-foot"><partial name="~/Areas/Admin/Views/Shared/_BrandFoot.cshtml" /></div>
</body>
</html>
