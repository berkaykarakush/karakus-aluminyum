@model KarakusAluminyum.Web.Areas.Admin.Controllers.DashboardVm
@using KarakusAluminyum.Web.Services.Documents
@{
    ViewData["Title"] = "Ana Sayfa";
    var sales = Model.Report.Sales;
    var open = Model.Tasks.Where(t => t.Count > 0).ToList();
    var missing = Model.Setup.Where(s => !s.Done).ToList();
}
<div class="admin-page-heading">
  <div><h1>Hoş geldiniz</h1><div class="admin-muted">Son 30 günün özeti</div></div>
  <div class="admin-actions"><a class="admin-btn" href="/yonetim/crm/teklifler/ekle">+ Yeni teklif</a><a class="admin-btn admin-btn--secondary" href="/yonetim/cizim/ekle">+ Yeni çizim</a><a class="admin-btn admin-btn--secondary" href="/yonetim/raporlar">Raporlar</a></div>
</div>
<section class="report-kpis">
  <partial name="~/Areas/Admin/Views/Reports/_Kpi.cshtml" model='new KarakusAluminyum.Web.Areas.Admin.Models.KpiVm("Teklif tutarı", TurkishNumbers.Money(sales.QuoteTotal), sales.QuoteTotal, sales.PreviousQuoteTotal)' />
  <partial name="~/Areas/Admin/Views/Reports/_Kpi.cshtml" model='new KarakusAluminyum.Web.Areas.Admin.Models.KpiVm("İmzalı sözleşme", TurkishNumbers.Money(sales.SignedTotal), sales.SignedTotal, sales.PreviousSignedTotal)' />
  <partial name="~/Areas/Admin/Views/Reports/_Kpi.cshtml" model='new KarakusAluminyum.Web.Areas.Admin.Models.KpiVm("Yeni müşteri", sales.NewCustomers.ToString(), sales.NewCustomers, sales.PreviousNewCustomers)' />
  <partial name="~/Areas/Admin/Views/Reports/_Kpi.cshtml" model='new KarakusAluminyum.Web.Areas.Admin.Models.KpiVm("Site oturumu", Model.Report.Web.Sessions.ToString(), Model.Report.Web.Sessions, Model.Report.Web.PreviousSessions)' />
</section>
<div class="admin-columns">
  <section class="admin-panel">
    <h2>Yapılacaklar</h2>
    @if (open.Count == 0) { <p class="admin-muted">Bekleyen iş yok.</p> }
    else
    {
      <ul class="admin-list">
        @foreach (var task in open) { <li><a href="@task.Url"><span>@task.Text</span><strong>@task.Count</strong></a></li> }
      </ul>
    }
  </section>
  <section class="admin-panel">
    <h2>Son mesajlar</h2>
    @if (Model.RecentMessages.Count == 0) { <p class="admin-muted">Henüz mesaj yok.</p> }
    <ul class="admin-list">@foreach (var x in Model.RecentMessages) { <li><a href="@x.Url"><span>@x.Title</span><small>@x.Detail</small></a></li> }</ul>
  </section>
  <section class="admin-panel">
    <h2>Son teklifler</h2>
    @if (Model.RecentQuotes.Count == 0) { <p class="admin-muted">Henüz teklif yok.</p> }
    <ul class="admin-list">@foreach (var x in Model.RecentQuotes) { <li><a href="@x.Url"><span>@x.Title</span><small>@x.Detail</small></a></li> }</ul>
  </section>
</div>
@if (missing.Count > 0)
{
  <section class="admin-panel">
    <h2>Kurulumu tamamlayın</h2>
    <p class="admin-muted">Bu bilgiler girilmeden ilgili özellikler tam çalışmaz.</p>
    <ul class="admin-list">@foreach (var item in missing) { <li><a href="@item.Url"><span>@item.Text</span><small>Girin →</small></a></li> }</ul>
  </section>
}
