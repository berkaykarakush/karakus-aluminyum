@model KarakusAluminyum.Web.Areas.Admin.Controllers.DashboardStats
@{ViewData["Title"]="Ana Sayfa";}
<div class="admin-page-heading"><div><h1>Hoş geldiniz, @(User.Identity?.Name ?? "Yönetici")</h1><div class="admin-muted">Karakuş Alüminyum yönetim paneline hoş geldiniz.</div></div><div class="admin-muted">@DateTime.Now.ToString("dd MMMM yyyy, dddd")</div></div>
<section class="admin-grid">
<div class="admin-stat"><span class="admin-stat-icon">▤</span><div class="admin-muted" style="margin-top:12px">Hizmetler</div><strong>@Model.Services</strong><a href="/yonetim/hizmetler">Hizmetleri yönet →</a></div>
<div class="admin-stat"><span class="admin-stat-icon" style="background:#e5f8ef;color:#159765">▣</span><div class="admin-muted" style="margin-top:12px">Projeler</div><strong>@Model.Projects</strong><a href="/yonetim/projeler">Projeleri yönet →</a></div>
<div class="admin-stat"><span class="admin-stat-icon" style="background:#fff2df;color:#d88913">▤</span><div class="admin-muted" style="margin-top:12px">Blog yazıları</div><strong>@Model.Posts</strong><a href="/yonetim/yazilar">Yazıları yönet →</a></div>
<div class="admin-stat"><span class="admin-stat-icon" style="background:#ffe9ed;color:#e04455">✉</span><div class="admin-muted" style="margin-top:12px">Okunmamış mesaj</div><strong>@Model.UnreadMessages</strong><a href="/yonetim/mesajlar">Mesajları görüntüle →</a></div>
</section>
<div class="admin-grid" style="grid-template-columns:minmax(0,1.55fr) minmax(260px,1fr);margin-top:16px;align-items:stretch">
<section class="admin-panel"><h2>Hızlı işlemler</h2><p class="admin-muted">Sık kullanılan yönetim ekranlarına buradan ulaşabilirsiniz.</p><div class="admin-actions"><a class="admin-btn" href="/yonetim/crm/teklifler/ekle">＋ Yeni teklif oluştur</a><a class="admin-btn admin-btn--secondary" href="/yonetim/crm/musteriler">♧ Müşterileri görüntüle</a><a class="admin-btn admin-btn--secondary" href="/yonetim/projeler/ekle">＋ Proje ekle</a><a class="admin-btn admin-btn--secondary" href="/yonetim/yazilar/ekle">＋ Blog yazısı ekle</a></div></section>
<section class="admin-panel" style="background:linear-gradient(135deg,#172943,#244a78);color:white;border:0"><div style="font-size:11px;letter-spacing:1.5px;opacity:.7">KARAKUŞ ALÜMİNYUM</div><h2 style="font-size:22px;line-height:1.35;margin:14px 0">Kaliteli alüminyum,<br/>güçlü yapılar.</h2><p style="opacity:.8;line-height:1.7">Kurumsal site içeriklerinizi, projelerinizi ve müşteri tekliflerinizi tek panelden yönetin.</p><a href="/" target="_blank" rel="noopener" class="admin-btn" style="background:white;color:#1c3760">Siteyi görüntüle ↗</a></section>
</div>
<section class="admin-panel"><h2>Yayın öncesi kontrol</h2><div class="admin-muted" style="line-height:1.9">• Proje, hizmet ve blog içeriklerinde görsel seçerek dosya yükleyebilirsiniz.<br/>• Üretim ortamında HTTPS kullanın ve veritabanı yedeklerini düzenli alın.<br/>• Yönetici parolasını güçlü ve benzersiz tutun; gizli bilgileri Git'e göndermeyin.</div></section>
