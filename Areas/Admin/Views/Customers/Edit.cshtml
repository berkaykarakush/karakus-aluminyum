@model KarakusAluminyum.Web.Models.Crm.Customer
@using KarakusAluminyum.Web.Models.Crm
@{ var editing = Model.Id > 0; ViewData["Title"] = editing ? "Müşteri düzenle" : "Yeni müşteri"; var action = editing ? $"/yonetim/crm/musteriler/duzenle/{Model.Id}" : "/yonetim/crm/musteriler/ekle"; }
<div class="admin-actions"><h1>@ViewData["Title"]</h1>@if (Model.Id > 0 && (User.IsInRole("Admin") || User.IsInRole("Accountant"))) { <a class="admin-btn admin-btn--secondary" href="/yonetim/muhasebe/cariler/@Model.Id">Cari ekstre</a> }</div><div class="admin-panel"><form class="admin-form" method="post" action="@action">@Html.AntiForgeryToken()<input type="hidden" asp-for="Id"/><div asp-validation-summary="ModelOnly"></div>
<div class="admin-grid"><div><label asp-for="Name">Müşteri / firma adı *</label><input asp-for="Name" required/><span asp-validation-for="Name"></span></div><div><label>Tür</label><select asp-for="Kind" id="customer-kind"><option value="Individual">Bireysel</option><option value="Company">Firma</option></select></div><div><label>Cari türü</label><select asp-for="PartyType"><option value="Customer">Müşteri</option><option value="Supplier">Tedarikçi</option><option value="Both">Müşteri ve tedarikçi</option></select></div><div><label>Durum</label><select asp-for="Status"><option value="Lead">Aday</option><option value="Active">Aktif</option><option value="Passive">Pasif</option></select></div><div><label asp-for="ContactPerson">Yetkili kişi</label><input asp-for="ContactPerson"/></div><div><label asp-for="Phone">Telefon</label><input asp-for="Phone"/></div><div><label asp-for="Email">E-posta</label><input asp-for="Email" type="email"/></div><div><label asp-for="TaxNumber" id="tax-label">@(Model.Kind == KarakusAluminyum.Web.Models.Crm.CustomerKind.Individual ? "T.C. kimlik no" : "Vergi no")</label><input asp-for="TaxNumber" inputmode="numeric"/></div><div><label asp-for="TaxOffice">Vergi dairesi</label><input asp-for="TaxOffice" placeholder="Bireyselde gerekmez"/></div><div><label asp-for="City">İl</label><input asp-for="City"/></div><div><label asp-for="District">İlçe</label><input asp-for="District"/></div><div><label asp-for="Source">Müşteri kaynağı</label><input asp-for="Source" list="customer-sources" placeholder="Bizi nereden buldu?"/><datalist id="customer-sources">@foreach (var src in KarakusAluminyum.Web.Models.Crm.CustomerSources.Suggestions) { <option value="@src"></option> }</datalist></div><div><label asp-for="ReferredByCustomerId">Tavsiye eden müşteri</label><select asp-for="ReferredByCustomerId" asp-items="(List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Referrers"><option value="">Yok</option></select><span asp-validation-for="ReferredByCustomerId"></span></div></div>
<label asp-for="Address">Adres</label><textarea asp-for="Address"></textarea><label asp-for="Notes">Notlar</label><textarea asp-for="Notes"></textarea><p><label style="font-weight:400"><input asp-for="NotificationsOptOut" type="checkbox" style="width:auto"/> Sipariş ve servis bildirimlerini (e-posta, WhatsApp) istemiyor</label></p><div class="admin-actions"><button class="admin-btn">Kaydet</button><a href="/yonetim/crm/musteriler">İptal</a></div></form></div>
@{ var neighbors = ViewBag.Neighbors as List<KarakusAluminyum.Web.Services.NeighborMatch> ?? new(); var referredList = ViewBag.Referred as List<(int Id, string Name)> ?? new(); }
@if (Model.Id > 0)
{
  <div class="admin-grid" style="align-items:start">
    <div class="admin-panel">
      <h2 style="margin-top:0">Tavsiye ettiği müşteriler</h2>
      <ul>@foreach (var r in referredList) { <li><a href="/yonetim/crm/musteriler/duzenle/@r.Id">@r.Name</a></li> }</ul>
      @if (referredList.Count == 0) { <p class="admin-muted">Henüz yok. Yeni müşteri kartında "Tavsiye eden müşteri" olarak bu müşteriyi seçin.</p> }
      <p><a href="/yonetim/crm/musteriler/tavsiyeler">Tavsiye raporu →</a></p>
    </div>
    <div class="admin-panel">
      <h2 style="margin-top:0">Yakında yaptığımız işler</h2>
      @if (neighbors.Count == 0) { <p class="admin-muted">Bu adrese yakın teslim edilmiş iş bulunamadı. Adres "... Sitesi", "... Sok.", "... Mah." gibi yazılırsa eşleşme bulunur.</p> }
      else
      {
        <p class="admin-muted">Satışta referans olarak kullanılabilir: "Aynı sitede/sokakta şu işi biz yaptık." Müşteri bilgisi paylaşmadan anlatın.</p>
        <ul>@foreach (var n in neighbors) { <li><strong>@n.LevelText</strong>: <a href="/yonetim/siparisler/detay/@n.OrderId">@n.OrderNumber</a> · @n.CustomerName<br /><small class="admin-muted">@n.Address</small></li> }</ul>
      }
    </div>
  </div>
}
<script>(function(){var k=document.getElementById('customer-kind'),l=document.getElementById('tax-label');k.addEventListener('change',function(){l.textContent=k.value==='Individual'?'T.C. kimlik no':'Vergi no';});})();</script>
