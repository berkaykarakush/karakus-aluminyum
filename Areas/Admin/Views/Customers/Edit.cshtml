@model KarakusAluminyum.Web.Models.Crm.Customer
@using KarakusAluminyum.Web.Models.Crm
@{ var editing = Model.Id > 0; ViewData["Title"] = editing ? "Müşteri düzenle" : "Yeni müşteri"; var action = editing ? $"/yonetim/crm/musteriler/duzenle/{Model.Id}" : "/yonetim/crm/musteriler/ekle"; }
<h1>@ViewData["Title"]</h1><div class="admin-panel"><form class="admin-form" method="post" action="@action">@Html.AntiForgeryToken()<input type="hidden" asp-for="Id"/><div asp-validation-summary="ModelOnly"></div>
<div class="admin-grid"><div><label asp-for="Name">Müşteri / firma adı *</label><input asp-for="Name" required/><span asp-validation-for="Name"></span></div><div><label>Tür</label><select asp-for="Kind"><option value="Company">Firma</option><option value="Individual">Bireysel</option></select></div><div><label>Durum</label><select asp-for="Status"><option value="Lead">Aday</option><option value="Active">Aktif</option><option value="Passive">Pasif</option></select></div><div><label asp-for="ContactPerson">Yetkili kişi</label><input asp-for="ContactPerson"/></div><div><label asp-for="Phone">Telefon</label><input asp-for="Phone"/></div><div><label asp-for="Email">E-posta</label><input asp-for="Email" type="email"/></div><div><label asp-for="TaxNumber">Vergi / T.C. no</label><input asp-for="TaxNumber"/></div><div><label asp-for="TaxOffice">Vergi dairesi</label><input asp-for="TaxOffice"/></div><div><label asp-for="City">İl</label><input asp-for="City"/></div><div><label asp-for="District">İlçe</label><input asp-for="District"/></div><div><label asp-for="Source">Müşteri kaynağı</label><input asp-for="Source" placeholder="Web sitesi, tavsiye, telefon..."/></div></div>
<label asp-for="Address">Adres</label><textarea asp-for="Address"></textarea><label asp-for="Notes">Notlar</label><textarea asp-for="Notes"></textarea><div class="admin-actions"><button class="admin-btn">Kaydet</button><a href="/yonetim/crm/musteriler">İptal</a></div></form></div>
