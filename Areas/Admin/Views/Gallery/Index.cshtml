@model IReadOnlyList<KarakusAluminyum.Web.Models.GalleryImage>
@{ ViewData["Title"] = "Galeri"; }
<div class="admin-actions"><h1>Galeri</h1><a class="admin-btn" href="/yonetim/galeri/ekle">+ Yeni görsel</a></div>
<div class="admin-panel">
  <table class="admin-table">
    <thead><tr><th>Görsel</th><th>Başlık</th><th>Bağlı olduğu</th><th>Sıra</th><th>Durum</th><th>İşlem</th></tr></thead>
    <tbody>
    @foreach (var g in Model)
    {
      <tr>
        <td><img src="@g.ImagePath" alt="@g.Title" style="width:80px;height:60px;object-fit:cover;border-radius:6px" /></td>
        <td>@g.Title</td>
        <td>@(g.ServiceId is not null ? "Hizmet #" + g.ServiceId : g.ProjectId is not null ? "Proje #" + g.ProjectId : "Genel")</td>
        <td>@g.SortOrder</td>
        <td>@(g.IsPublished ? "Yayında" : "Taslak")</td>
        <td>
          <form method="post" action="/yonetim/galeri/sil/@g.Id" onsubmit="return confirm('Bu görsel silinsin mi?')">
            @Html.AntiForgeryToken()
            <button class="admin-btn admin-btn--danger">Sil</button>
          </form>
        </td>
      </tr>
    }
    </tbody>
  </table>
</div>
