@model KarakusAluminyum.Web.Models.GalleryUploadVm
@{ ViewData["Title"] = "Görsel Yükle"; }
<h1>Görsel Yükle</h1>
<div class="admin-panel">
  <form class="admin-form" method="post" enctype="multipart/form-data" action="/yonetim/galeri/ekle">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>
    <label>Dosya (JPG, PNG, WEBP · en fazla 5 MB)</label>
    <input type="file" name="file" accept=".jpg,.jpeg,.png,.webp" required />
    <label asp-for="ServiceId">Hizmet</label>
    <select asp-for="ServiceId" asp-items="(SelectList?)ViewBag.Services"><option value="">—</option></select>
    <label asp-for="ProjectId">Proje</label>
    <select asp-for="ProjectId" asp-items="(SelectList?)ViewBag.Projects"><option value="">—</option></select>
    <label asp-for="Title">Başlık</label>
    <input asp-for="Title" />
    <label asp-for="Caption">Açıklama</label>
    <input asp-for="Caption" />
    <label asp-for="SortOrder">Sıra</label>
    <input asp-for="SortOrder" type="number" />
    <label><input asp-for="IsPublished" /> Yayında</label>
    <div class="admin-actions">
      <button class="admin-btn">Yükle</button>
      <a class="admin-btn" href="/yonetim/galeri">Vazgeç</a>
    </div>
  </form>
</div>
