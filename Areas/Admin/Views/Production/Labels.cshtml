@model KarakusAluminyum.Web.Models.Production.ProductionOrder
@using KarakusAluminyum.Web.Services.Production
@{
    Layout = null;
    var kind = (string)ViewBag.Kind;
    var size = (string)ViewBag.Size;
    var pozlar = (List<PozLabel>)ViewBag.Pozlar;
    var parts = (List<PartLabel>)ViewBag.Parts;
    var culture = KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture;
    var perSheet = size == "a4" ? 24 : 1;
    var count = kind == "parca" ? parts.Count : pozlar.Count;
    var printers = (List<KarakusAluminyum.Web.Models.Production.LabelPrinter>)ViewBag.Printers;
    string Url(string t, string b) => $"/yonetim/uretim/etiketler/{Model.Id}?tur={t}&boyut={b}";
}
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>@(kind == "parca" ? "Parça" : "Poz") etiketleri - @Model.OrderNumber</title>
  <link rel="stylesheet" href="~/css/labels.css" asp-append-version="true" />
  @if (size == "termal") { <style>@@page{size:100mm 50mm;margin:0}</style> } else { <style>@@page{size:A4;margin:0}</style> }
</head>
<body class="lb--@size">
  <div class="lb-toolbar">
    <a href="/yonetim/siparisler/detay/@Model.Id">Siparişe dön</a>
    <a href="@Url("poz", size)">Poz etiketleri</a>
    <a href="@Url("parca", size)">Parça etiketleri</a>
    <a href="@Url(kind, size == "a4" ? "termal" : "a4")">@(size == "a4" ? "Termal (100 × 50 mm)" : "A4 (3 × 8)")</a>
    <span>@count etiket</span>
    <button type="button" onclick="window.print()">Tarayıcıdan yazdır</button>
  </div>
  @if (TempData["Notice"] is string notice) { <div class="lb-toolbar"><strong>@notice</strong></div> }
  @if (printers.Count > 0 && count > 0)
  {
    <div class="lb-toolbar">
      <form method="post" action="/yonetim/uretim/etiketler/@Model.Id/yazdir" class="lb-printer">
        @Html.AntiForgeryToken()
        <input type="hidden" name="tur" value="@kind" />
        <label for="lb-printer">Barkod yazıcısı</label>
        <select id="lb-printer" name="yazici">@foreach (var p in printers) { <option value="@p.Id" data-network="@(p.Host is null ? "0" : "1")">@p.Name (@p.Language.ToUpperInvariant(), @p.WidthMm × @p.HeightMm mm)</option> }</select>
        <button type="submit" id="lb-send">Yazıcıya gönder</button>
        <a id="lb-file" href="/yonetim/uretim/etiketler/@Model.Id/dosya?tur=@kind&yazici=@printers[0].Id">Dosyayı indir</a>
      </form>
    </div>
    <script>
      (() => {
        const select = document.getElementById('lb-printer'), send = document.getElementById('lb-send'), file = document.getElementById('lb-file');
        const sync = () => { const o = select.selectedOptions[0]; send.hidden = o.dataset.network !== '1'; file.href = file.href.replace(/yazici=\d+/, 'yazici=' + o.value); };
        select.addEventListener('change', sync); sync();
      })();
    </script>
  }
  else if (printers.Count == 0)
  {
    <div class="lb-toolbar"><span>Zebra / TSC gibi barkod yazıcısı için <a href="/yonetim/uretim/yazicilar/ekle">yazıcı tanımlayın</a>.</span></div>
  }
  @if (count == 0)
  {
    <div class="lb-toolbar"><span>@(kind == "parca" ? "Parça etiketi için pozlara profil sistemi seçin." : "Siparişe bağlı çizim listesinde poz yok.")</span></div>
  }
  @if (kind == "parca")
  {
    @foreach (var page in parts.Chunk(perSheet))
    {
      <div class="lb-sheet">
        @foreach (var p in page)
        {
          <div class="lb">
            <div class="lb-row"><strong>@p.Profile</strong><span>@Model.OrderNumber</span></div>
            <div class="lb-row"><span class="lb-big">@p.LengthMm.ToString("0.#", culture) mm</span><span>@p.Ends</span></div>
            <div class="lb-muted">@p.Label · Poz @p.Position (@p.Unit/@p.Design.Quantity) @p.Design.Name</div>
            @Html.Raw(Code128.Svg(p.Code))
          </div>
        }
      </div>
    }
  }
  else
  {
    @foreach (var page in pozlar.Chunk(perSheet))
    {
      <div class="lb-sheet">
        @foreach (var p in page)
        {
          <div class="lb">
            <div class="lb-row"><strong>@Model.OrderNumber</strong><span>Poz @p.Position · @p.Unit/@p.Quantity</span></div>
            <div class="lb-row"><span class="lb-big">@p.Size</span></div>
            <div class="lb-muted">@p.Design.Name · @Model.Customer?.Name</div>
            <div class="lb-muted">@string.Join(" · ", p.Lines.Take(3))</div>
            @Html.Raw(Code128.Svg(p.Code))
          </div>
        }
      </div>
    }
  }
</body>
</html>
