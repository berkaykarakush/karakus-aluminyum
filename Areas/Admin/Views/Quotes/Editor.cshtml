@model KarakusAluminyum.Web.Models.Crm.QuoteInputViewModel
@using System.Text.Json
@using KarakusAluminyum.Web.Models.Crm
@using KarakusAluminyum.Web.Models.Documents
@{
    var editing = Model.Id != 0;
    ViewData["Title"] = editing ? "Teklifi düzenle" : "Yeni teklif";
    var action = editing ? $"/yonetim/crm/teklifler/duzenle/{Model.Id}" : "/yonetim/crm/teklifler/ekle";
    var customers = ViewBag.Customers as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var glassTypes = (List<KarakusAluminyum.Web.Services.Documents.GlassOption>)ViewBag.GlassTypes;
    var web = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    var clauses = ((List<TemplateClause>)ViewBag.Clauses).Select(c => new { id = c.Id, name = c.Name, quoteText = c.QuoteText, contractText = c.ContractText });
}
<link rel="stylesheet" href="~/css/document-editor.css" asp-append-version="true" />
<div class="admin-actions"><h1>@ViewData["Title"]</h1><a class="admin-btn admin-btn--secondary" href="/yonetim/crm/teklifler">Teklif listesi</a></div>
<form id="doc-form" class="doc-editor" method="post" action="@action" data-mode="quote">
  @Html.AntiForgeryToken()
  <input type="hidden" asp-for="DocumentJson" />
  <div asp-validation-summary="All" class="doc-errors"></div>

  <section class="doc-card">
    <h2>Teklif bilgileri</h2>
    <p class="admin-muted">Teklif kurumsal teklif düzeninde basılır: "TEKLİFTİR" başlığı, "Sayın müşteri" hitabı, giriş ve teknik özellik cümleleri, Ürün Adı / Ürün Açıklaması / Miktar / Birim / Tutar tablosu, kapanış, şartlar ve imza; altında poz çizimleri.</p>
    <div class="doc-grid">
      <div><label asp-for="CustomerId">Müşteri *</label><select asp-for="CustomerId" asp-items="customers" required><option value="">Müşteri seçin</option></select></div>
      <div><label asp-for="Title">Teklif başlığı *</label><input asp-for="Title" required placeholder="Örn. 3 blok inşaat doğrama işi" /></div>
      <div><label asp-for="DocumentDate">Teklif tarihi</label><input asp-for="DocumentDate" type="date" value="@Model.DocumentDate.ToString("yyyy-MM-dd")" /></div>
      <div><label asp-for="ValidUntilUtc">Geçerlilik tarihi</label><input asp-for="ValidUntilUtc" type="date" value="@Model.ValidUntilUtc?.ToString("yyyy-MM-dd")" /></div>
      <div><label asp-for="VatMode">KDV gösterimi</label>
        <select asp-for="VatMode"><option value="@VatMode.Added">KDV hariç fiyat, KDV toplama eklensin</option><option value="@VatMode.Included">Fiyatlar KDV dahil</option><option value="@VatMode.None">KDV belirtilmesin</option></select></div>
      <div><label asp-for="TaxRate">KDV oranı (%)</label><input asp-for="TaxRate" type="number" step="0.01" min="0" max="100" /></div>
      <div><label asp-for="Signatory">İmza yetkilisi</label><input asp-for="Signatory" list="doc-staff" autocomplete="off" /><datalist id="doc-staff">@foreach (var name in (List<string>)ViewBag.Staff) { <option value="@name"></option> }</datalist><p class="doc-help">Belgeyi hazırlayan kullanıcıyla gelir. Boş bırakılırsa şablondaki yetkili basılır.</p></div>
      <div><label asp-for="SignatoryTitle">Yetkili sıfatı</label><input asp-for="SignatoryTitle" /></div>
    </div>
  </section>

  <section class="doc-card">
    <h2>Metinler</h2>
    <p class="admin-muted">Şablondan gelir, bu teklife özel değiştirebilirsiniz. <code>{{alan}}</code> yazdığınız her yer aşağıda değişkene dönüşür, <code>**metin**</code> kalın basılır.</p>
    <label for="doc-intro">Açıklama (tablonun üstünde)</label><textarea id="doc-intro" rows="2" data-content="intro"></textarea>
    <label for="doc-closing">Ek açıklama (isteğe bağlı)</label><textarea id="doc-closing" rows="2" data-content="closing"></textarea>
    <label for="doc-note">Not</label><textarea id="doc-note" rows="2" data-content="note" placeholder="Örn. Bodrum kattaki doğramalar fiyata dahil değildir."></textarea>
  </section>

  <section class="doc-card">
    <h2>Değişkenler</h2>
    <p class="admin-muted">Tüm belgede geçerli değerler. Boş bırakılanlar çıktıda çizgi olarak basılır.</p>
    <div id="doc-variables" class="doc-grid"></div>
  </section>

  <section class="doc-card">
    <h2>Bölümler ve kalemler</h2>
    <p class="admin-muted">Blok adı tablodaki Ürün Adı'dır (ör. PVC Doğrama, Motorlu Panjur). Birden çok kalemli blokta kalemlerin tutarı yazılmaz, altına "Blok adı Toplamı" satırı gelir; adsız bloktaki kalemler tek tek fiyatlanır ("Poz 1 - ..." açıklamasında poz adı Ürün Adı olur). Maddeler tablonun üstünde cümle olarak yazar. Maliyet ve marj yalnızca bu ekranda görünür.</p>
    <div id="doc-blocks"></div>
    <div class="doc-row"><button type="button" class="doc-btn" id="doc-add-block">+ Blok ekle</button><strong id="doc-total"></strong></div>
  </section>

  <section class="doc-card">
    <h2>Teklif şartları</h2>
    <p class="admin-muted">Ödeme, teslim süresi, montaj, fiyata dahil olmayanlar ve garanti gibi şartlar. Şablondan gelir; bu teklife özel değiştirebilirsiniz. Değerler (ör. teslim süresi) yukarıdaki değişkenlerdendir.</p>
    <div id="doc-terms"></div>
  </section>

  <section class="doc-card doc-pricing">
    <h2>Fiyatlandırma <small class="admin-muted">(müşteri çıktısında görünmez)</small></h2>
    <input type="hidden" asp-for="DrawingListId" />
    @if (ViewBag.ListName is string listName) { <p class="admin-muted">Çizim listesi: <a href="/yonetim/cizim/detay/@Model.DrawingListId" target="_blank" rel="noopener">@listName</a>. Pozların maliyeti çizimlerden hesaplanır.</p> }
    <div class="doc-grid">
      <div><label asp-for="MarginPercent">Kâr marjı (%)</label><input asp-for="MarginPercent" type="number" step="0.01" min="0" max="500" /></div>
      <div><label asp-for="GlassTypeId">Cam tipi (maliyete eklenir)</label>
        <select asp-for="GlassTypeId"><option value="">Cam maliyete eklenmesin</option>
          @foreach (var g in glassTypes.Where(g => g.Active || g.Id == Model.GlassTypeId)) { <option value="@g.Id">@g.Name (@g.PricePerM2.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture) ₺/m²)</option> }
        </select></div>
      <div><label asp-for="DiscountRate">Genel iskonto (%)</label><input asp-for="DiscountRate" type="number" step="0.01" min="0" max="100" /></div>
    </div>
    <div class="doc-grid" id="doc-rounding"></div>
    <p class="admin-muted">Marjı değiştirince elle yazılmamış tüm fiyatlar yeniden hesaplanır. Elle yazdığınız fiyatın yanında ↺ çıkar, tıklarsanız fiyat marja döner. Genel iskonto ara toplama uygulanır ve çıktıda ayrı satır olarak basılır; kalem bazında iskonto için satırdaki "İsk. %" alanını kullanın.</p>
    <p class="admin-muted">İmalatı veya camı taşerona verdiğiniz pozda kalemin maliyet hücresinde <strong>Taşeron</strong> kutusunu işaretleyip taşeronun birim fiyatını yazın. İşaretli parça sistemden hesaplanmaz, çizim ve ölçüler yine sistemden gelir.</p>
    <table class="doc-summary-table" id="doc-pricing-summary"></table>
  </section>

  <section class="doc-card">
    <h2>Ek: çizimler</h2>
    <p class="admin-muted">Seçilen pencere çizimleri poz listesi olarak belgenin sonuna eklenir.</p>
    <div id="doc-designs-list"></div>
  </section>

  <div class="doc-actions"><button class="admin-btn" type="submit">@(editing ? "Değişiklikleri kaydet" : "Teklifi oluştur")</button><a class="admin-btn admin-btn--secondary" href="/yonetim/crm/teklifler">İptal</a></div>
</form>
<script type="application/json" id="doc-clauses">@Html.Raw(JsonSerializer.Serialize(clauses))</script>
<script type="application/json" id="doc-glass-types">@Html.Raw(JsonSerializer.Serialize(glassTypes, web))</script>
<script type="application/json" id="doc-design-costs">@Html.Raw(JsonSerializer.Serialize((List<KarakusAluminyum.Web.Services.Documents.DesignCostOption>)ViewBag.DesignCosts, web))</script>
<script type="application/json" id="doc-designs">@Html.Raw(JsonSerializer.Serialize(ViewBag.Designs))</script>
<script src="~/js/document-editor.js" asp-append-version="true"></script>
