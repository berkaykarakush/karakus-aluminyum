@model List<KarakusAluminyum.Web.Models.Crm.Quote>
@using KarakusAluminyum.Web.Models.Crm
@{ ViewData["Title"] = "CRM - Teklifler"; }
<div class="admin-actions"><h1>CRM · Teklifler</h1><a class="admin-btn" href="/yonetim/crm/teklifler/ekle">+ Yeni teklif</a><a class="admin-btn" href="/yonetim/crm/musteriler">Müşteriler</a></div>
<div class="admin-panel"><form method="get" class="admin-form"><div class="admin-grid"><div><label>Teklif durumu</label><select name="status"><option value="">Tüm durumlar</option>@foreach(var s in Enum.GetValues<QuoteStatus>()){<option value="@((int)s)" selected="@(ViewBag.Status is QuoteStatus selected && selected == s)">@QuoteLabel(s)</option>}</select></div><div style="align-self:end"><button class="admin-btn">Filtrele</button></div></div></form></div>
<div class="admin-panel"><table class="admin-table"><thead><tr><th>Teklif no</th><th>Başlık / müşteri</th><th>Tarih</th><th>Durum</th><th>Toplam (KDV dahil)</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.QuoteNumber</strong></td><td>@x.Title<br/><small>@x.Customer?.Name</small></td><td>@x.CreatedUtc.ToLocalTime().ToString("dd.MM.yyyy")</td><td>@QuoteLabel(x.Status)</td><td>@x.GrandTotal.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture) ₺</td><td><a class="admin-btn" href="/yonetim/crm/teklifler/detay/@x.Id">Detay</a></td></tr>}@if(Model.Count==0){<tr><td colspan="6">Henüz teklif yok.</td></tr>}</tbody></table></div>
@functions { string QuoteLabel(QuoteStatus s) => s switch { QuoteStatus.Draft => "Taslak", QuoteStatus.Sent => "Gönderildi", QuoteStatus.Accepted => "Kabul edildi", QuoteStatus.Rejected => "Reddedildi", QuoteStatus.Expired => "Süresi doldu", _ => "Sözleşmeye dönüştürüldü" }; }
