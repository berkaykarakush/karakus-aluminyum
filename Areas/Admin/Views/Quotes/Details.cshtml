@model KarakusAluminyum.Web.Models.Crm.Quote
@using KarakusAluminyum.Web.Models.Crm
@{ ViewData["Title"] = "Teklif detay"; var statusText = QuoteLabel(Model.Status); var tr = KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture; var profit = QuoteRules.Profit(Model); }
<div class="admin-actions"><h1>Teklif @Model.QuoteNumber</h1><a class="admin-btn admin-btn--secondary" href="/yonetim/crm/teklifler">Teklif listesi</a>@if ((User.IsInRole("Admin") || User.IsInRole("Accountant")) && Model.Status is QuoteStatus.Accepted or QuoteStatus.Converted) { <a class="admin-btn" href="/yonetim/muhasebe/faturalar/ekle?teklif=@Model.Id">Faturaya dönüştür</a> }<a class="admin-btn" href="/yonetim/crm/teklifler/yazdir/@Model.Id" target="_blank" rel="noopener">Görüntüle / PDF</a><a class="admin-btn" href="/yonetim/crm/teklifler/yazdir/@Model.Id?sunum=1" target="_blank" rel="noopener" title="Kurumsal sunum teklifin önüne eklenir">Sunumla PDF</a>@if(Model.Status==QuoteStatus.Draft){<a class="admin-btn" href="/yonetim/crm/teklifler/duzenle/@Model.Id">Düzenle</a><form method="post" action="/yonetim/crm/teklifler/sablonu-yenile/@Model.Id">@Html.AntiForgeryToken()<button class="admin-btn">Şablonu yenile</button></form>}@if(Model.Status==QuoteStatus.Accepted){<form method="post" action="/yonetim/sozlesmeler/tekliften/@Model.Id">@Html.AntiForgeryToken()<button class="admin-btn">Sözleşme oluştur</button></form>}@if(ViewBag.ContractId is int contractId){<a class="admin-btn" href="/yonetim/sozlesmeler/detay/@contractId">Sözleşmeyi aç</a>}@if(ViewBag.OrderId is int orderId){<a class="admin-btn" href="/yonetim/siparisler/detay/@orderId">Siparişi aç</a>}else if(Model.Status is QuoteStatus.Accepted or QuoteStatus.Converted){<form method="post" action="/yonetim/siparisler/tekliften/@Model.Id">@Html.AntiForgeryToken()<button class="admin-btn">Sipariş oluştur</button></form>}</div>
<div class="admin-panel"><div class="admin-grid"><div><span class="admin-muted">Müşteri</span><h2>@Model.Customer?.Name</h2><p>@Model.Customer?.ContactPerson<br/>@Model.Customer?.Phone · @Model.Customer?.Email</p></div><div><span class="admin-muted">Teklif başlığı</span><h2>@Model.Title</h2><p>Oluşturma: @Model.CreatedUtc.ToLocalTime().ToString("dd.MM.yyyy")<br/>Geçerlilik: @(Model.ValidUntilUtc?.ToLocalTime().ToString("dd.MM.yyyy") ?? "Belirtilmedi")<br/>Durum: @statusText</p></div></div>
<table class="admin-table"><thead><tr><th>Açıklama</th><th>Miktar</th><th>Birim</th><th>Birim maliyet</th><th>Birim fiyatı</th><th>Tutar</th><th>Marj</th></tr></thead><tbody>@foreach(var x in Model.Items.OrderBy(i=>i.SortOrder).ThenBy(i=>i.Id)){<tr><td>@if(!string.IsNullOrEmpty(x.BlockName)){<small>@x.BlockName · </small>}@x.Description@if(x.ManualBaseCost is not null || x.ManualGlassCost is not null){<small class="admin-muted"> · taşeron: @(string.Join(", ", new[]{ x.ManualBaseCost is not null ? "imalat" : null, x.ManualGlassCost is not null ? "cam" : null }.OfType<string>()))</small>}</td><td>@x.Quantity.ToString("N3", tr)</td><td>@x.Unit</td><td>@x.UnitCost.ToString("N2", tr) ₺</td><td>@x.UnitPrice.ToString("N2", tr) ₺</td><td>@x.LineTotal.ToString("N2", tr) ₺</td><td>@(x.UnitCost > 0 ? "%" + ((x.UnitPrice / x.UnitCost - 1) * 100).ToString("0.#", tr) : "—")</td></tr>}</tbody></table>
<div class="admin-panel" style="margin-top:16px"><h3>İç fiyatlandırma <small class="admin-muted">(çıktıda görünmez)</small></h3>
<p class="admin-muted">@if (Model.DrawingList is not null) { <text>Çizim listesi: <a href="/yonetim/cizim/detay/@Model.DrawingListId">@Model.DrawingList.Name</a> · </text> }Kâr marjı: %@Model.MarginPercent.ToString("0.##", tr) · Cam: @(Model.GlassType?.Name ?? "maliyete dahil değil")</p>
<table class="admin-table" style="max-width:420px"><tbody>
<tr><td>Toplam maliyet</td><td>@Model.CostTotal.ToString("N2", tr) ₺</td></tr>
<tr><td>Net satış (iskonto sonrası, KDV hariç)</td><td>@profit.NetSales.ToString("N2", tr) ₺</td></tr>
<tr><td><strong>Kâr</strong></td><td><strong>@profit.Profit.ToString("N2", tr) ₺</strong></td></tr>
<tr><td>Gerçekleşen marj</td><td>@(profit.MarginPercent is decimal m ? "%" + m.ToString("0.#", tr) : "—")</td></tr>
</tbody></table></div>
<div style="max-width:360px;margin:20px 0 0 auto"><p>Ara toplam: <strong>@Model.Subtotal.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture) ₺</strong></p><p>İskonto (@Model.DiscountRate.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture)%): <strong>-@Model.DiscountAmount.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture) ₺</strong></p><p>KDV (@Model.TaxRate.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture)%): <strong>@Model.TaxAmount.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture) ₺</strong></p>@{ var roundingAmount = QuoteRules.RoundingAmount(Model.VatMode, Model.Subtotal, Model.DiscountAmount, Model.TaxAmount, Model.GrandTotal); }@if (roundingAmount != 0) { <p>Yuvarlama: <strong>@(roundingAmount > 0 ? "+" : "")@roundingAmount.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture) ₺</strong></p> }<h2>Genel toplam: @Model.GrandTotal.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture) ₺</h2></div>
@if(!string.IsNullOrWhiteSpace(Model.Notes)){<hr/><h3>Notlar ve koşullar</h3><p style="white-space:pre-wrap">@Model.Notes</p>}
<hr/>@if (Model.Status == QuoteStatus.Rejected && Model.LostReason is not null) { <p><strong>Kayıp nedeni:</strong> @Model.LostReason@(Model.LostCompetitor is null ? "" : " · rakip: " + Model.LostCompetitor)@(Model.LostNote is null ? "" : " · " + Model.LostNote)</p> }@if (Model.Status == QuoteStatus.Rejected) { <p class="admin-muted">@(Model.WinBackOn is DateOnly wb ? $"Geri arama: {wb:dd.MM.yyyy} tarihinde arama listesine düşer." : "Geri arama listesinde değil.")@(Model.WinBackNote is null ? "" : " Son not: " + Model.WinBackNote) <a href="/yonetim/crm/arama-listesi">Arama listesi →</a></p> }<form method="post" action="/yonetim/crm/teklifler/durum/@Model.Id" class="admin-form" id="quote-status">@Html.AntiForgeryToken()<label>Teklif durumunu değiştir</label><div class="admin-actions"><select name="status" id="quote-status-select">@foreach(var s in AllowedStatuses(Model.Status)){<option value="@((int)s)" selected="@(Model.Status==s)">@QuoteLabel(s)</option>}</select><button class="admin-btn">Durumu kaydet</button></div><div id="lost-fields" style="display:none;margin-top:8px"><div class="admin-grid"><div><label for="lostReason">Kayıp nedeni</label><select id="lostReason" name="lostReason"><option value="">Seçin</option>@foreach (var r in QuoteLoss.Reasons) { <option selected="@(r == Model.LostReason)">@r</option> }</select></div><div><label for="lostCompetitor">Tercih edilen firma (biliniyorsa)</label><input id="lostCompetitor" name="lostCompetitor" maxlength="120" value="@Model.LostCompetitor" /></div></div><label for="lostNote">Not</label><input id="lostNote" name="lostNote" maxlength="300" value="@Model.LostNote" placeholder="ör. %10 daha ucuz teklif aldı" /></div><script>(function(){var s=document.getElementById('quote-status-select'),b=document.getElementById('lost-fields'),r=document.getElementById('lostReason');function u(){var on=s.value=='@((int)QuoteStatus.Rejected)';b.style.display=on?'':'none';r.required=on;}s.addEventListener('change',u);u();})();</script></form></div>
@{
    // README 7.18: müşteri teklifi bu bağlantıdan inceleyip online onaylar.
    var approvalPhone = KarakusAluminyum.Web.Services.Notifications.NotificationComposer.PhoneDigits(Model.Customer?.Phone);
    var approvalText = $"Merhaba, {Model.QuoteNumber} numaralı teklifimizi bu bağlantıdan inceleyip onaylayabilirsiniz: {(string)ViewBag.PublicUrl}";
    var approvalWa = (approvalPhone is null ? "https://wa.me/" : $"https://wa.me/{approvalPhone}") + "?text=" + Uri.EscapeDataString(approvalText);
}
<div class="admin-panel" id="online-onay">
  <h3 style="margin-top:0">Online onay</h3>
  @if (Model.AcceptedUtc is DateTime acceptedUtc)
  {
    <p><strong>@Model.AcceptedName</strong> teklifi @acceptedUtc.AddHours(3).ToString("dd.MM.yyyy HH:mm") tarihinde @(Model.AcceptedTotal?.ToString("N2", tr)) ₺ tutarla onayladı.</p>
    <p class="admin-muted">IP: @(Model.AcceptedIp ?? "-") · Tarayıcı: @(Model.AcceptedUserAgent ?? "-")<br />Belge özeti (SHA-256): <code style="word-break:break-all">@Model.AcceptedHash</code>@(Model.AcceptedHash == KarakusAluminyum.Web.Services.Documents.QuoteAcceptance.Hash(Model) ? " · teklif onaydan sonra değişmedi" : " · teklif onaydan sonra değişti")</p>
  }
  else if (Model.Status == QuoteStatus.Sent)
  {
    <p class="admin-muted">Müşteri teklifi aşağıdaki bağlantıdan (veya PDF'teki QR kodundan) inceleyip adını yazarak onaylayabilir; onaylanınca sipariş kendiliğinden açılır ve size e-posta gelir.</p>
    <div class="admin-actions"><a class="admin-btn" href="@approvalWa" target="_blank" rel="noopener noreferrer">Onay bağlantısını WhatsApp ile gönder</a></div>
  }
  else { <p class="admin-muted">Online onay, durumu "Gönderildi" olan teklifte açıktır.</p> }
</div>
@{ var link = ((string)ViewBag.PublicUrl, "/yonetim/crm/teklifler/baglantiyi-yenile/" + Model.Id); }
<partial name="_DocumentLink" model="link" />
<style>@@media print{body.admin{background:white}.admin-nav,header,.admin-actions button,.admin-actions a,form{display:none!important}.admin-shell{max-width:none;padding:0}.admin-panel{border:0}}</style>

@functions {
    // Sözleşmeye dönüşüm durum listesinden değil, sözleşme oluşturularak yapılır.
    IEnumerable<QuoteStatus> AllowedStatuses(QuoteStatus current) => Enum.GetValues<QuoteStatus>()
        .Where(s => s == current || (s != QuoteStatus.Converted && QuoteRules.CanTransition(current, s)));
    string QuoteLabel(QuoteStatus s) => s switch { QuoteStatus.Draft => "Taslak", QuoteStatus.Sent => "Gönderildi", QuoteStatus.Accepted => "Kabul edildi", QuoteStatus.Rejected => "Reddedildi", QuoteStatus.Expired => "Süresi doldu", _ => "Sözleşmeye dönüştürüldü" };
}
