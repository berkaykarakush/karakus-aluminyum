@model KarakusAluminyum.Web.Models.Crm.Quote
@using KarakusAluminyum.Web.Models.Crm
@{ ViewData["Title"] = "Teklif detay"; var statusText = QuoteLabel(Model.Status); var tr = KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture; var profit = QuoteRules.Profit(Model); }
<div class="admin-actions"><h1>Teklif @Model.QuoteNumber</h1><a class="admin-btn" href="/yonetim/crm/teklifler">Teklif listesi</a>@if ((User.IsInRole("Admin") || User.IsInRole("Accountant")) && Model.Status is QuoteStatus.Accepted or QuoteStatus.Converted) { <a class="admin-btn" href="/yonetim/muhasebe/faturalar/ekle?teklif=@Model.Id">Faturaya dönüştür</a> }<a class="admin-btn" href="/yonetim/crm/teklifler/yazdir/@Model.Id" target="_blank" rel="noopener">Görüntüle / PDF</a><a class="admin-btn" href="/yonetim/crm/teklifler/yazdir/@Model.Id?sunum=1" target="_blank" rel="noopener" title="Kurumsal sunum teklifin önüne eklenir">Sunumla PDF</a>@if(Model.Status==QuoteStatus.Draft){<a class="admin-btn" href="/yonetim/crm/teklifler/duzenle/@Model.Id">Düzenle</a><form method="post" action="/yonetim/crm/teklifler/sablonu-yenile/@Model.Id">@Html.AntiForgeryToken()<button class="admin-btn">Şablonu yenile</button></form>}@if(Model.Status==QuoteStatus.Accepted){<form method="post" action="/yonetim/sozlesmeler/tekliften/@Model.Id">@Html.AntiForgeryToken()<button class="admin-btn">Sözleşme oluştur</button></form>}@if(ViewBag.ContractId is int contractId){<a class="admin-btn" href="/yonetim/sozlesmeler/detay/@contractId">Sözleşmeyi aç</a>}</div>
<div class="admin-panel"><div class="admin-grid"><div><span class="admin-muted">Müşteri</span><h2>@Model.Customer?.Name</h2><p>@Model.Customer?.ContactPerson<br/>@Model.Customer?.Phone · @Model.Customer?.Email</p></div><div><span class="admin-muted">Teklif başlığı</span><h2>@Model.Title</h2><p>Oluşturma: @Model.CreatedUtc.ToLocalTime().ToString("dd.MM.yyyy")<br/>Geçerlilik: @(Model.ValidUntilUtc?.ToLocalTime().ToString("dd.MM.yyyy") ?? "Belirtilmedi")<br/>Durum: @statusText</p></div></div>
<table class="admin-table"><thead><tr><th>Açıklama</th><th>Miktar</th><th>Birim</th><th>Birim maliyet</th><th>Birim fiyatı</th><th>Tutar</th><th>Marj</th></tr></thead><tbody>@foreach(var x in Model.Items.OrderBy(i=>i.SortOrder).ThenBy(i=>i.Id)){<tr><td>@if(!string.IsNullOrEmpty(x.BlockName)){<small>@x.BlockName · </small>}@x.Description@if(x.ManualBaseCost is not null || x.ManualGlassCost is not null){<small class="admin-muted"> · taşeron: @(string.Join(", ", new[]{ x.ManualBaseCost is not null ? "imalat" : null, x.ManualGlassCost is not null ? "cam" : null }.OfType<string>()))</small>}</td><td>@x.Quantity.ToString("N3", tr)</td><td>@x.Unit</td><td>@x.UnitCost.ToString("N2", tr) ₺</td><td>@x.UnitPrice.ToString("N2", tr) ₺</td><td>@x.LineTotal.ToString("N2", tr) ₺</td><td>@(x.UnitCost > 0 ? "%" + ((x.UnitPrice / x.UnitCost - 1) * 100).ToString("0.#", tr) : "—")</td></tr>}</tbody></table>
<div class="admin-panel" style="margin-top:16px"><h3>İç fiyatlandırma <small class="admin-muted">(çıktıda görünmez)</small></h3>
<p class="admin-muted">@if (Model.DrawingList is not null) { <text>Çizim listesi: <a href="/yonetim/cizim/detay/@Model.DrawingListId">@Model.DrawingList.Name</a> · </text> }Kâr marjı: %@Model.MarginPercent.ToString("0.##", tr) · Cam: @(Model.GlassType?.Name ?? "maliyete dahil değil")</p>
<table class="admin-table" style="max-width:420px"><tbody>
<tr><td>Toplam maliyet</td><td>@Model.CostTotal.ToString("N2", tr) ₺</td></tr>
<tr><td>Net satış (iskonto sonrası, KDV hariç)</td><td>@profit.NetSales.ToString("N2", tr) ₺</td></tr>
<tr><td><strong>Kâr</strong></td><td><strong>@profit.Profit.ToString("N2", tr) ₺</strong></td></tr>
<tr><td>Gerçekleşen marj</td><td>@(profit.MarginPercent is decimal m ? "%" + m.ToString("0.#", tr) : "—")</td></tr>
</tbody></table></div>
<div style="max-width:360px;margin:20px 0 0 auto"><p>Ara toplam: <strong>@Model.Subtotal.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture) ₺</strong></p><p>İskonto (@Model.DiscountRate.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture)%): <strong>-@Model.DiscountAmount.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture) ₺</strong></p><p>KDV (@Model.TaxRate.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture)%): <strong>@Model.TaxAmount.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture) ₺</strong></p><h2>Genel toplam: @Model.GrandTotal.ToString("N2", KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture) ₺</h2></div>
@if(!string.IsNullOrWhiteSpace(Model.Notes)){<hr/><h3>Notlar ve koşullar</h3><p style="white-space:pre-wrap">@Model.Notes</p>}
<hr/><form method="post" action="/yonetim/crm/teklifler/durum/@Model.Id" class="admin-form">@Html.AntiForgeryToken()<label>Teklif durumunu değiştir</label><div class="admin-actions"><select name="status">@foreach(var s in AllowedStatuses(Model.Status)){<option value="@((int)s)" selected="@(Model.Status==s)">@QuoteLabel(s)</option>}</select><button class="admin-btn">Durumu kaydet</button></div></form></div>
<style>@@media print{body.admin{background:white}.admin-nav,header,.admin-actions button,.admin-actions a,form{display:none!important}.admin-shell{max-width:none;padding:0}.admin-panel{border:0}}</style>

@functions {
    // Sözleşmeye dönüşüm durum listesinden değil, sözleşme oluşturularak yapılır.
    IEnumerable<QuoteStatus> AllowedStatuses(QuoteStatus current) => Enum.GetValues<QuoteStatus>()
        .Where(s => s == current || (s != QuoteStatus.Converted && QuoteRules.CanTransition(current, s)));
    string QuoteLabel(QuoteStatus s) => s switch { QuoteStatus.Draft => "Taslak", QuoteStatus.Sent => "Gönderildi", QuoteStatus.Accepted => "Kabul edildi", QuoteStatus.Rejected => "Reddedildi", QuoteStatus.Expired => "Süresi doldu", _ => "Sözleşmeye dönüştürüldü" };
}
