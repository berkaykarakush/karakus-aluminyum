@model KarakusAluminyum.Web.Models.Crm.QuoteInputViewModel
@{ ViewData["Title"] = "Yeni teklif"; var customers = ViewBag.Customers as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new(); }
<h1>Yeni teklif oluştur</h1><div class="admin-panel"><form class="admin-form" method="post" action="/yonetim/crm/teklifler/ekle">@Html.AntiForgeryToken()<div asp-validation-summary="All"></div>
<div class="admin-grid"><div><label>Müşteri *</label><select asp-for="CustomerId" asp-items="customers"><option value="">Müşteri seçin</option></select></div><div><label asp-for="Title">Teklif başlığı *</label><input asp-for="Title" required placeholder="Örn. Villa cam balkon uygulaması"/></div><div><label asp-for="ValidUntilUtc">Geçerlilik tarihi</label><input asp-for="ValidUntilUtc" type="date" value="@(Model.ValidUntilUtc?.ToString("yyyy-MM-dd"))"/></div><div><label asp-for="TaxRate">KDV (%)</label><input asp-for="TaxRate" type="number" min="0" max="100" step="0.01"/></div><div><label asp-for="DiscountRate">İskonto (%)</label><input asp-for="DiscountRate" type="number" min="0" max="100" step="0.01"/></div></div>
<h2>Teklif kalemleri</h2><p class="admin-muted">En az bir kalem girin. Boş açıklamalı satırlar kaydedilmez.</p><table class="admin-table"><thead><tr><th>Açıklama</th><th>Miktar</th><th>Birim</th><th>Birim fiyatı (₺)</th></tr></thead><tbody>@for(var i=0;i<Model.Items.Count;i++){<tr><td><input asp-for="Items[i].Description" placeholder="Profil, cam, montaj işçiliği..."/></td><td><input asp-for="Items[i].Quantity" type="number" min="0" step="0.001"/></td><td><input asp-for="Items[i].Unit"/></td><td><input asp-for="Items[i].UnitPrice" type="number" min="0" step="0.01"/></td></tr>}</tbody></table>
<label asp-for="Notes">Teklif notları / kapsam / ödeme koşulları</label><textarea asp-for="Notes"></textarea><div class="admin-actions"><button class="admin-btn">Teklifi oluştur</button><a href="/yonetim/crm/teklifler">İptal</a></div></form></div>
