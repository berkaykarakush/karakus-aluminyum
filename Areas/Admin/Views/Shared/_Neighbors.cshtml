@model List<KarakusAluminyum.Web.Services.NeighborMatch>
@* Bu adrese yakın teslim edilmiş işler: satışta referans ("aynı sitede şu işi biz yaptık") ve talebi öne almak için. *@
@if (Model.Count > 0)
{
  <div class="admin-panel">
    <h3 style="margin-top:0">Yakında yaptığımız işler</h3>
    <p class="admin-muted">Aynı site, sokak veya mahallede teslim ettiğimiz işler. Görüşmede referans olarak anlatın (müşteri bilgisi paylaşmadan); bu talebi öne almak da mantıklı olabilir.</p>
    <ul style="margin:0">@foreach (var n in Model) { <li><strong>@n.LevelText</strong>: <a href="/yonetim/siparisler/detay/@n.OrderId">@n.OrderNumber</a> · @n.CustomerName<br /><small class="admin-muted">@n.Address</small></li> }</ul>
  </div>
}
