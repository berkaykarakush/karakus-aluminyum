@{ var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "/yonetim"; }
<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>@ViewData["Title"] - Karakuş Alüminyum Yönetim</title>
<link rel="stylesheet" href="/css/site.css"/>
<link rel="stylesheet" href="/css/units.css"/>
<script src="/js/units.js"></script>
<style>
:root{--navy:#111d31;--navy2:#192943;--blue:#2463eb;--blue2:#3679f6;--ink:#17243b;--muted:#71809b;--line:#e4eaf3;--canvas:#f3f6fc;--white:#fff}
*{box-sizing:border-box}body.admin{margin:0;background:var(--canvas);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:14px}.admin-app{min-height:100vh;display:grid;grid-template-columns:244px minmax(0,1fr)}.admin-sidebar{background:linear-gradient(180deg,var(--navy),#101a2b);color:#eaf0fb;padding:22px 13px;display:flex;flex-direction:column;min-height:100vh;position:sticky;top:0;height:100vh;overflow:auto}.admin-brand{display:flex;align-items:center;gap:11px;padding:6px 10px 28px;text-decoration:none;color:white}.admin-brand-mark{width:42px;height:42px;display:grid;place-items:center;background:#f3f7ff;color:var(--navy);font-size:25px;font-weight:900;clip-path:polygon(0 0,100% 0,100% 25%,36% 100%,0 100%)}.admin-brand strong{display:block;font-size:16px;letter-spacing:1.4px}.admin-brand small{display:block;font-size:10px;letter-spacing:3px;opacity:.78;margin-top:2px}.admin-nav-label{font-size:10px;color:#8190a9;text-transform:uppercase;letter-spacing:1.4px;padding:14px 12px 8px}.admin-nav{display:flex;flex-direction:column;gap:4px}.admin-nav a,.admin-logout{display:flex;align-items:center;gap:12px;padding:11px 13px;border-radius:8px;color:#dce5f4;text-decoration:none;font-size:13px;transition:background .15s;color .15s}.admin-nav a:hover,.admin-nav a.active{background:linear-gradient(100deg,#2463b9,#2766bd);color:#fff}.admin-nav .nav-icon{width:20px;text-align:center;font-size:16px;opacity:.95}.admin-sidebar-bottom{margin-top:auto;padding:18px 10px 6px;border-top:1px solid #2a3850;color:#a7b6cb;font-size:11px}.admin-online{display:inline-block;width:8px;height:8px;border-radius:50%;background:#28d5a0;margin-right:7px}.admin-main{min-width:0}.admin-topbar{height:70px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:20px;padding:0 28px;position:sticky;top:0;z-index:5}.admin-search{max-width:500px;flex:1;background:#f3f6fb;border:1px solid #edf1f8;border-radius:9px;padding:11px 14px;color:#75839b}.admin-top-right{display:flex;align-items:center;gap:18px;font-size:12px}.admin-avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#e6edfa;color:#214b8f;font-weight:800}.admin-content{padding:27px 28px 34px;max-width:1800px;margin:auto}.admin-page-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:20px}.admin-page-heading h1{font-size:25px;letter-spacing:-.5px;margin:0 0 5px}.admin-muted{color:var(--muted)}.admin-panel{background:#fff;border:1px solid var(--line);border-radius:11px;padding:20px;margin:16px 0;box-shadow:0 3px 12px #253f6606;overflow-x:auto}.admin-panel h2{font-size:16px;margin:0 0 16px}.admin-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:15px}.admin-stat{padding:19px;border:1px solid var(--line);border-radius:11px;background:#fff;box-shadow:0 3px 12px #253f6605}.admin-stat strong{display:block;font-size:29px;margin:8px 0;color:#17243b}.admin-stat a{color:var(--blue);text-decoration:none;font-size:12px}.admin-stat-icon{display:inline-grid;place-items:center;width:39px;height:39px;border-radius:9px;background:#eaf1ff;color:#2563eb;font-size:18px}.admin-table{width:100%;border-collapse:collapse;min-width:600px}.admin-table th,.admin-table td{padding:13px 12px;border-bottom:1px solid #edf1f7;text-align:left;vertical-align:middle}.admin-table th{font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:#687995;background:#f8faff}.admin-table tr:hover td{background:#fbfcff}.admin-form label{display:block;font-weight:650;margin:14px 0 6px;color:#34435c}.admin-form input:not([type=checkbox]):not([type=file]),.admin-form textarea,.admin-form select{width:100%;padding:11px 12px;border:1px solid #d8e0ed;border-radius:8px;background:#fff;color:var(--ink);font:inherit}.admin-form textarea{min-height:110px}.admin-form input:focus,.admin-form textarea:focus,.admin-form select:focus{outline:2px solid #c8d9ff;border-color:#7ba3ff}.admin-form input[type=checkbox]{width:auto}.admin-actions{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.admin-actions form{display:inline}.admin-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:10px 14px;background:var(--blue);color:white;border:0;border-radius:8px;text-decoration:none;cursor:pointer;font:inherit;font-weight:650}.admin-btn:hover{background:#174fc6}.admin-btn--secondary{background:#eef3fb;color:#263c5c}.admin-btn--danger{background:#a62e3b}.notice{padding:13px 15px;background:#e8f8ee;border:1px solid #c8efd5;color:#176a38;border-radius:9px}.validation-summary-errors,.field-validation-error{color:#a12727}.admin-image-picker{display:flex;align-items:center;gap:16px;flex-wrap:wrap;padding:14px;border:1px dashed #bdcbe0;border-radius:10px;background:#f9fbff}.admin-image-preview{width:150px;height:100px;object-fit:cover;border-radius:8px;border:1px solid var(--line);background:#eef2f8}.admin-image-hint{font-size:12px;color:var(--muted);margin-top:7px}.admin-footer{padding:10px 28px 22px;color:#7e8ba2;font-size:11px}.admin-mobile-toggle{display:none;border:0;background:#eef3fb;border-radius:8px;padding:8px 11px;font-size:19px}
@@media(max-width:900px){.admin-app{grid-template-columns:1fr}.admin-sidebar{position:fixed;z-index:20;left:-260px;width:244px;transition:left .2s;box-shadow:0 0 30px #0002}.admin-app.sidebar-open .admin-sidebar{left:0}.admin-mobile-toggle{display:block}.admin-topbar{padding:0 16px}.admin-content{padding:20px 15px}.admin-search{display:none}.admin-page-heading h1{font-size:22px}}
@@media print{.admin-sidebar,.admin-topbar,.admin-actions,.admin-footer{display:none!important}.admin-app{display:block}.admin-content{padding:0}.admin-panel{box-shadow:none;border:0}}
</style>
</head>
<body class="admin">
<div class="admin-app" id="adminApp">
<aside class="admin-sidebar">
<a class="admin-brand" href="/yonetim"><span class="admin-brand-mark">K</span><span><strong>KARAKUŞ</strong><small>ALÜMİNYUM</small></span></a>
<div class="admin-nav-label">Çalışma alanı</div><nav class="admin-nav">
<a class="@(currentPath=="/yonetim"?"active":"")" href="/yonetim"><span class="nav-icon">⌂</span>Ana Sayfa</a>
<a class="@(currentPath.Contains("/cizim")?"active":"")" href="/yonetim/cizim"><span class="nav-icon">▥</span>Doğrama çizimi</a>
<a class="@(currentPath.Contains("/camlar")?"active":"")" href="/yonetim/camlar"><span class="nav-icon">▢</span>Cam listeleri</a>
<a class="@(currentPath.Contains("teklif")?"active":"")" href="/yonetim/crm/teklifler"><span class="nav-icon">▤</span>Teklifler</a>
<a class="@(currentPath.Contains("/sozlesmeler")?"active":"")" href="/yonetim/sozlesmeler"><span class="nav-icon">▧</span>Sözleşmeler</a>
<a class="@(currentPath.Contains("musteri")?"active":"")" href="/yonetim/crm/musteriler"><span class="nav-icon">♧</span>Müşteriler</a>
<a class="@(currentPath.Contains("hizmet")?"active":"")" href="/yonetim/hizmetler"><span class="nav-icon">◇</span>Hizmetler</a>
<a class="@(currentPath.Contains("proje")?"active":"")" href="/yonetim/projeler"><span class="nav-icon">▣</span>Projeler</a>
<a class="@(currentPath.Contains("galeri")?"active":"")" href="/yonetim/galeri"><span class="nav-icon">▦</span>Galeri</a>
<a class="@(currentPath.Contains("/sss")?"active":"")" href="/yonetim/sss"><span class="nav-icon">?</span>Sık sorulan sorular</a>
<a class="@(currentPath.Contains("yazilar")?"active":"")" href="/yonetim/yazilar"><span class="nav-icon">▤</span>Blog yazıları</a>
<a class="@(currentPath.Contains("mesaj")?"active":"")" href="/yonetim/mesajlar"><span class="nav-icon">✉</span>İletişim mesajları</a>
<div class="admin-nav-label">Yönetim</div>
<a class="@(currentPath.Contains("ayarlar")?"active":"")" href="/yonetim/ayarlar"><span class="nav-icon">⚙</span>Site ayarları</a>
@if(User.IsInRole("Admin")){<a class="@(currentPath.Contains("/sablonlar")?"active":"")" href="/yonetim/sablonlar"><span class="nav-icon">▨</span>Belge şablonları</a><a class="@(currentPath.Contains("kullanicilar")?"active":"")" href="/yonetim/kullanicilar"><span class="nav-icon">♙</span>Kullanıcılar</a><a class="@(currentPath.Contains("denetim-kaydi")?"active":"")" href="/yonetim/denetim-kaydi"><span class="nav-icon">◷</span>Denetim kaydı</a>}
</nav><div class="admin-sidebar-bottom"><span class="admin-online"></span>Sistem yönetimi<br/><span style="display:inline-block;margin:10px 0 0 16px">KARAKUŞ ALÜMİNYUM · v1.0</span></div>
</aside>
<section class="admin-main"><header class="admin-topbar"><button class="admin-mobile-toggle" type="button" onclick="document.getElementById('adminApp').classList.toggle('sidebar-open')" aria-label="Menüyü aç">☰</button><div class="admin-search">⌕ &nbsp; Ara... (müşteri, teklif, içerik vb.)</div><div class="admin-top-right"><label class="unit-global">Ölçü birimi <select id="unit-global" aria-label="Genel ölçü birimi"><option value="mm">mm</option><option value="cm">cm</option><option value="m">m</option></select></label><span>Yönetim Paneli</span><span class="admin-avatar">@(User.Identity?.Name?.FirstOrDefault().ToString().ToUpperInvariant() ?? "Y")</span><form method="post" action="/yonetim-cikis">@Html.AntiForgeryToken()<button class="admin-btn admin-btn--secondary" type="submit">Çıkış</button></form></div></header>
<main class="admin-content">@if(TempData["Notice"] is string notice){<p class="notice">@notice</p>}@RenderBody()</main><footer class="admin-footer">© @DateTime.UtcNow.Year Karakuş Alüminyum · Daha güçlü yapılar için.</footer></section>
</div>
<script>
document.querySelectorAll('input[type=file][data-image-preview]').forEach(function(input){input.addEventListener('change',function(){const target=document.getElementById(input.dataset.imagePreview);if(!target||!input.files||!input.files[0])return;const reader=new FileReader();reader.onload=e=>{target.src=e.target.result;target.hidden=false};reader.readAsDataURL(input.files[0]);});});
</script>
</body></html>
