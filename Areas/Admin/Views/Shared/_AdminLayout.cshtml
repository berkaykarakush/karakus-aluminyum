@using Microsoft.EntityFrameworkCore
@inject KarakusAluminyum.Web.Data.AppDbContext Db
@{
    var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "/yonetim";
    var isAdmin = User.IsInRole("Admin");
    var unread = await Db.ContactMessages.CountAsync(x => !x.IsRead);
    // Bugün veya daha önce aranması gereken, sonuçlanmamış firmalar.
    var followUpDay = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(3));
    var openStages = new[] { KarakusAluminyum.Web.Models.Crm.ProspectStage.New, KarakusAluminyum.Web.Models.Crm.ProspectStage.Contacted, KarakusAluminyum.Web.Models.Crm.ProspectStage.Meeting, KarakusAluminyum.Web.Models.Crm.ProspectStage.Quoted };
    var followUps = User.IsInRole("Admin") || User.IsInRole("Editor") ? await Db.Prospects.CountAsync(x => x.NextFollowUp != null && x.NextFollowUp <= followUpDay && openStages.Contains(x.Stage) && !x.DoNotContact) : 0;
    // Sevk tarihi geçmiş, henüz sevk edilmemiş siparişler.
    var lateOrders = User.IsInRole("Admin") || User.IsInRole("Editor") ? await Db.ProductionOrders.CountAsync(x => x.PlannedShipDate != null && x.PlannedShipDate < followUpDay && x.Status < KarakusAluminyum.Web.Models.Production.OrderStatus.Shipped) : 0;
    // Açık (planlanmış dahil) servis talepleri.
    var openServices = User.IsInRole("Admin") || User.IsInRole("Editor") ? await Db.ServiceRequests.CountAsync(x => x.Status == KarakusAluminyum.Web.Models.Production.ServiceStatus.Open || x.Status == KarakusAluminyum.Web.Models.Production.ServiceStatus.Scheduled) : 0;
    // Giderilmemiş eksik ve kusurlar (cam kırık, kol eksik...).
    var openPunch = User.IsInRole("Admin") || User.IsInRole("Editor") ? await Db.PunchItems.CountAsync(x => x.Status == KarakusAluminyum.Web.Models.Production.PunchStatus.Open || x.Status == KarakusAluminyum.Web.Models.Production.PunchStatus.Waiting) : 0;
    // Bugün veya geçmiş günü verilmiş, henüz ölçüsü alınmamış keşifler.
    var dueSurveys = User.IsInRole("Admin") || User.IsInRole("Editor") ? await Db.SiteSurveys.CountAsync(x => x.Status == KarakusAluminyum.Web.Models.Production.SurveyStatus.Planned && x.PlannedOn != null && x.PlannedOn <= followUpDay) : 0;
    // Ödeme planında vadesi geçmiş, ödenmemiş taksitler (README 7.19).
    var lateCount = User.IsInRole("Admin") || User.IsInRole("Editor") || User.IsInRole("Accountant")
        ? (await KarakusAluminyum.Web.Areas.Admin.Controllers.PaymentsController.DueAsync(Db, followUpDay)).Count(r => r.Status.State == KarakusAluminyum.Web.Models.Production.InstallmentState.Late) : 0;
    var groups = new List<(string Key, string Title, List<(string Text, string Url, string Match, int Count)> Links)>
    {
        ("sales", "Satış", new() { ("Firma havuzu", "/yonetim/crm/firmalar", "/crm/firmalar", followUps), ("Keşifler", "/yonetim/kesif", "/kesif", dueSurveys), ("Teklifler", "/yonetim/crm/teklifler", "/crm/teklifler", 0), ("Kurumsal sunum", "/yonetim/sunum", "/sunum", 0), ("Sözleşmeler", "/yonetim/sozlesmeler", "/sozlesmeler", 0), ("Ödeme takibi", "/yonetim/odemeler", "/odemeler", lateCount), ("Müşteriler", "/yonetim/crm/musteriler", "/crm/musteriler", 0), ("İletişim mesajları", "/yonetim/mesajlar", "/mesajlar", unread) }),
        ("production", "Üretim", new() { ("Siparişler", "/yonetim/siparisler", "/siparisler", lateOrders), ("Üretim planı", "/yonetim/siparisler/planlama", "/siparisler/planlama", 0), ("Çizim listeleri", "/yonetim/cizim", "/cizim", 0), ("Cam listeleri", "/yonetim/camlar", "/camlar", 0), ("Eksikler", "/yonetim/eksikler", "/eksikler", openPunch), ("Malzeme ihtiyacı", "/yonetim/uretim/malzeme-ihtiyaci", "/uretim/malzeme-ihtiyaci", 0), ("Barkod okut", "/yonetim/uretim/okut", "/uretim/okut", 0) }),
        ("field", "Saha ve servis", new() { ("Servis", "/yonetim/servis", "/servis", openServices), ("Personel takvimi", "/yonetim/takvim", "/takvim", 0), ("Montajcılar", "/yonetim/siparisler/montajcilar", "/siparisler/montajcilar", 0) }),
        ("definitions", "Tanımlar", new() { ("Profil sistemleri", "/yonetim/cizim/sistemler", "/cizim/sistemler", 0), ("Fiyat listeleri", "/yonetim/fiyat-listeleri", "/fiyat-listeleri", 0), ("Markalar", "/yonetim/markalar", "/markalar", 0), ("Barkod yazıcıları", "/yonetim/uretim/yazicilar", "/uretim/yazicilar", 0), ("Kesim makineleri", "/yonetim/uretim/makineler", "/uretim/makineler", 0) }),
        ("content", "Site içeriği", new() { ("Hizmetler", "/yonetim/hizmetler", "/hizmetler", 0), ("Projeler", "/yonetim/projeler", "/projeler", 0), ("Referanslar", "/yonetim/referanslar", "/referanslar", 0), ("Sosyal medya", "/yonetim/sosyal-medya", "/sosyal-medya", 0), ("Galeri", "/yonetim/galeri", "/galeri", 0), ("Sık sorulan sorular", "/yonetim/sss", "/sss", 0), ("Blog yazıları", "/yonetim/yazilar", "/yazilar", 0) })
    };
    if (isAdmin) groups.Add(("admin", "Yönetim", new() { ("Site ayarları", "/yonetim/ayarlar", "/ayarlar", 0), ("Bildirimler", "/yonetim/bildirimler", "/bildirimler", 0), ("Belge şablonları", "/yonetim/sablonlar", "/sablonlar", 0), ("Kullanıcılar", "/yonetim/kullanicilar", "/kullanicilar", 0), ("Denetim kaydı", "/yonetim/denetim-kaydi", "/denetim-kaydi", 0) }));
    var seesAccounting = isAdmin || User.IsInRole("Accountant");
    var accountantOnly = User.IsInRole("Accountant") && !isAdmin && !User.IsInRole("Editor");
    if (accountantOnly) groups.Clear();
    if (seesAccounting) groups.Insert(accountantOnly ? 0 : 1, ("accounting", "Ön muhasebe", new()
    {
        ("Genel bakış", "/yonetim/muhasebe", "/muhasebe$", 0), ("Faturalar", "/yonetim/muhasebe/faturalar", "/muhasebe/faturalar", 0), ("Cari hesaplar", "/yonetim/muhasebe/cariler", "/muhasebe/cariler", 0),
        ("Kasa ve banka", "/yonetim/muhasebe/kasa-banka", "/muhasebe/kasa-banka", 0), ("Çek ve senet", "/yonetim/muhasebe/cek-senet", "/muhasebe/cek-senet", 0), ("Giderler", "/yonetim/muhasebe/giderler", "/muhasebe/giderler", 0), ("Proje analizi", "/yonetim/muhasebe/projeler", "/muhasebe/projeler", 0),
        ("Ürün ve stok", "/yonetim/muhasebe/urunler", "/muhasebe/urunler", 0), ("Personel", "/yonetim/muhasebe/personel", "/muhasebe/personel", 0), ("Raporlar", "/yonetim/muhasebe/raporlar/kar-zarar", "/muhasebe/raporlar", 0), ("Veri aktarımı", "/yonetim/muhasebe/aktar", "/muhasebe/aktar", 0)
    }));
    if (accountantOnly) groups[0].Links.Insert(1, ("Ödeme takibi", "/yonetim/odemeler", "/odemeler", lateCount));
    bool Matches(string match) => match.EndsWith('$') ? currentPath == "/yonetim" + match.TrimEnd('$') : currentPath == "/yonetim" + match || currentPath.StartsWith("/yonetim" + match + "/");
    // Aynı öneki paylaşan bağlantılardan (Siparişler / Üretim planı) yalnızca en özel olanı seçili görünür.
    var activeMatch = groups.SelectMany(g => g.Links).Select(l => l.Match).Where(Matches).OrderByDescending(m => m.Length).FirstOrDefault();
    bool Active(string match) => match == activeMatch || (match == "/raporlar" && Matches(match));
}
<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="robots" content="noindex,nofollow"/>
<title>@ViewData["Title"] - Karakuş Alüminyum Yönetim</title>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/units.css" asp-append-version="true"/>
<script src="~/js/units.js" asp-append-version="true"></script>
<script src="~/js/price-round.js" asp-append-version="true"></script>
</head>
<body class="admin">
<div class="admin-app" id="adminApp">
<aside class="admin-sidebar" aria-label="Yönetim menüsü">
  <a class="admin-brand" href="/yonetim"><img src="/images/transparent.webp" alt="Karakuş Alüminyum" width="190" height="58"/></a>
  <a class="admin-nav-home @(currentPath == "/yonetim" ? "active" : "")" href="/yonetim">Ana Sayfa</a>
  @if (!accountantOnly) { <a class="admin-nav-home @(Active("/raporlar") ? "active" : "")" style="margin-top:0" href="/yonetim/raporlar">Raporlar</a> }
  @foreach (var group in groups)
  {
    var open = group.Links.Any(l => Active(l.Match));
    var total = group.Links.Sum(l => l.Count);
    <details class="nav-group" data-nav-group="@group.Key" data-active="@(open ? "1" : "0")" open="@open">
      <summary>@group.Title @if (total > 0) { <span class="nav-group__badge">@total</span> }</summary>
      <nav class="admin-nav" aria-label="@group.Title">
        @foreach (var link in group.Links)
        {
          <a class="@(Active(link.Match) ? "active" : "")" href="@link.Url" aria-current="@(Active(link.Match) ? "page" : null)"><span>@link.Text</span>@if (link.Count > 0) { <span class="admin-nav-count">@link.Count</span> }</a>
        }
      </nav>
    </details>
  }
  <div class="admin-sidebar-bottom"><a class="@(currentPath == "/yonetim/yardim" ? "active" : "")" href="/yonetim/yardim">Yardım ve kullanım kılavuzu</a><a href="/" target="_blank" rel="noopener">Siteyi görüntüle ↗</a></div>
</aside>
<div class="admin-backdrop" onclick="document.getElementById('adminApp').classList.remove('sidebar-open')"></div>
<section class="admin-main">
  <header class="admin-topbar">
    <button class="admin-mobile-toggle" type="button" onclick="document.getElementById('adminApp').classList.toggle('sidebar-open')" aria-label="Menüyü aç">☰</button>
    @if (!accountantOnly) { <form class="admin-search" method="get" action="/yonetim/ara" role="search"><input type="search" name="q" value="@Context.Request.Query["q"]" placeholder="Müşteri, teklif, sözleşme, çizim ara..." aria-label="Panelde ara"/></form> }
    <div class="admin-top-right">
      <a class="admin-help-link" href="/yonetim/yardim" title="Yardım ve kullanım kılavuzu" aria-label="Yardım">?</a>

      <span class="admin-user" title="@User.Identity?.Name"><span class="admin-avatar" aria-hidden="true">@(User.Identity?.Name?.FirstOrDefault().ToString().ToUpperInvariant() ?? "Y")</span><span class="admin-user__name">@User.Identity?.Name</span></span>
      <form method="post" action="/yonetim-cikis">@Html.AntiForgeryToken()<button class="admin-logout" type="submit">Çıkış</button></form>
    </div>
  </header>
  <main class="admin-content">@if (TempData["Notice"] is string notice) { <p class="notice">@notice</p> }@RenderBody()</main>
  <footer class="admin-footer">© @KarakusAluminyum.Web.Models.SiteSettings.CopyrightYears Karakuş Alüminyum</footer>
</section>
</div>
<script>
document.querySelectorAll('input[type=file][data-image-preview]').forEach(function(input){input.addEventListener('change',function(){const target=document.getElementById(input.dataset.imagePreview);if(!target||!input.files||!input.files[0])return;const reader=new FileReader();reader.onload=e=>{target.src=e.target.result;target.hidden=false};reader.readAsDataURL(input.files[0]);});});
// Menü: açılan bölümler hatırlanır, bulunulan sayfanın bölümü her zaman açıktır.
(function(){
  const KEY='admin_nav_open';let saved=['sales'];// ilk açılışta en sık kullanılan bölüm açık gelir
  try{const stored=localStorage.getItem(KEY);if(stored)saved=JSON.parse(stored);}catch{}
  const groups=document.querySelectorAll('[data-nav-group]');
  groups.forEach(function(group){
    group.open=saved.includes(group.dataset.navGroup)||group.dataset.active==='1';
    // Yalnızca kullanıcının tıklayarak açıp kapattığı bölümler hatırlanır; sayfanın kendi bölümünün otomatik açılması kaydedilmez.
    group.querySelector('summary').addEventListener('click',function(){
      const name=group.dataset.navGroup,willOpen=!group.open;
      saved=saved.filter(function(g){return g!==name;});if(willOpen)saved.push(name);
      try{localStorage.setItem(KEY,JSON.stringify(saved));}catch{}
    });
  });
})();
</script>
</body></html>
