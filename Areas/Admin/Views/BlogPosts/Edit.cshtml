@model KarakusAluminyum.Web.Models.BlogPost
@{ViewData["Title"]=Model.Id==0?"Yazı Ekle":"Yazı Düzenle";var action=Model.Id==0?"/yonetim/yazilar/ekle":$"/yonetim/yazilar/duzenle/{Model.Id}";}<h1>@ViewData["Title"]</h1><div class="admin-panel"><form class="admin-form" method="post" enctype="multipart/form-data" action="@action">@Html.AntiForgeryToken()<input type="hidden" asp-for="Id"/><div asp-validation-summary="All"></div><label asp-for="Title">Başlık</label><input asp-for="Title"/><label asp-for="Slug">Slug</label><input asp-for="Slug"/><label asp-for="Summary">Özet</label><textarea asp-for="Summary"></textarea><label asp-for="Content">İçerik</label><textarea asp-for="Content" style="min-height:300px"></textarea><label>Görsel seç</label><div class="admin-image-picker"><img class="admin-image-preview" id="imagePreview" src="@(string.IsNullOrWhiteSpace(Model.Image) ? "/images/image-placeholder.svg" : Model.Image)" alt="Görsel önizleme"/><div><input type="file" name="imageFile" accept="image/jpeg,image/png,image/webp,image/gif" data-image-preview="imagePreview"/><div class="admin-image-hint">JPG, PNG, WEBP veya GIF · En fazla 8 MB. Seçtiğin görsel kaydedilince yüklenir.</div><input type="hidden" asp-for="Image"/></div></div><label asp-for="SeoTitle">SEO başlığı</label><input asp-for="SeoTitle"/><label asp-for="SeoDescription">SEO açıklaması</label><textarea asp-for="SeoDescription"></textarea><label><input asp-for="IsPublished" type="checkbox" style="width:auto"/> Yayında</label><button class="admin-btn">Kaydet</button></form></div>
