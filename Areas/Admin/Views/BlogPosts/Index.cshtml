@model List<KarakusAluminyum.Web.Models.BlogPost>
@{ViewData["Title"]="Blog yazıları";}<div class="admin-actions"><h1>Blog yazıları</h1><a class="admin-btn" href="/yonetim/yazilar/ekle">+ Yeni yazı</a></div><div class="admin-panel"><table class="admin-table"><thead><tr><th>Başlık</th><th>Durum</th><th>Güncelleme</th><th>İşlem</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Title</td><td>@(x.IsPublished?"Yayında":"Taslak")</td><td>@x.UpdatedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td><td><div class="admin-actions"><a class="admin-btn" href="/yonetim/yazilar/duzenle/@x.Id">Düzenle</a><form method="post" action="/yonetim/yazilar/sil/@x.Id" onsubmit="return confirm('Silinsin mi?')">@Html.AntiForgeryToken()<button class="admin-btn admin-btn--danger">Sil</button></form></div></td></tr>}</tbody></table></div>
