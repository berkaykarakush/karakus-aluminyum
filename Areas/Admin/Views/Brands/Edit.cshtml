@model KarakusAluminyum.Web.Models.Drawing.Brand
@using KarakusAluminyum.Web.Models.Drawing
@{
    var editing = Model.Id != 0;
    ViewData["Title"] = editing ? "Markayı düzenle" : "Yeni marka";
    var action = editing ? $"/yonetim/markalar/duzenle/{Model.Id}" : "/yonetim/markalar/ekle";
}
<link rel="stylesheet" href="~/css/window-designer.css" asp-append-version="true" />
<div class="admin-actions"><h1>@ViewData["Title"]</h1><a class="admin-btn" href="/yonetim/markalar">Markalar</a></div>
<div class="admin-panel">
  <form method="post" action="@action" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="wd-errors"></div>
    <label asp-for="Name">Marka adı</label><input asp-for="Name" required />
    <label asp-for="Category">Ürün türü</label>
    <select asp-for="Category">
      @foreach (var category in ProductCategories.All) { <option value="@category">@ProductCategories.Label(category)</option> }
    </select>
    <label for="logoFile">Logo görseli (PNG, JPG, WEBP; şeffaf PNG önerilir)</label>
    @if (!string.IsNullOrEmpty(Model.LogoPath))
    {
      <p><partial name="_BrandMark" model="Model" /></p>
      <p><label><input type="checkbox" name="removeLogo" value="true" /> Logoyu kaldır</label></p>
    }
    <input id="logoFile" type="file" name="logoFile" accept=".png,.jpg,.jpeg,.webp" />
    <label asp-for="SortOrder">Sıra</label><input asp-for="SortOrder" type="number" />
    <p><label><input asp-for="IsActive" /> Aktif (yeni çizimlerde seçilebilir)</label></p>
    <div class="admin-actions"><button class="admin-btn" type="submit">Kaydet</button><a href="/yonetim/markalar">İptal</a></div>
  </form>
</div>
