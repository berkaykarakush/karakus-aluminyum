@model List<KarakusAluminyum.Web.Models.SiteSettingRecord>
@{ViewData["Title"]="Site ayarları";}<h1>Site ayarları</h1><p class="admin-muted">Bu ayarlar veritabanında saklanır ve genel iletişim bilgileri web sitesinde kullanılır. Canonical URL / JSON-LD gibi SEO alanlarını yayın öncesinde appsettings.json ile de eşleştirin.</p><div class="admin-panel"><form class="admin-form" method="post" action="/yonetim/ayarlar/kaydet">@Html.AntiForgeryToken()@for(var i=0;i<Model.Count;i++){<input type="hidden" name="items[@i].Id" value="@Model[i].Id"/><label>@Model[i].Key — @Model[i].Description</label><input name="items[@i].Value" value="@Model[i].Value"/><input type="hidden" name="items[@i].Key" value="@Model[i].Key"/><input type="hidden" name="items[@i].Description" value="@Model[i].Description"/>}<button class="admin-btn">Ayarları kaydet</button></form></div>
