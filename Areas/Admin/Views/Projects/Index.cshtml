@model List<KarakusAluminyum.Web.Models.PortfolioProject>
@{ViewData["Title"]="Projeler";}<div class="admin-actions"><h1>Projeler</h1><a class="admin-btn" href="/yonetim/projeler/ekle">+ Yeni proje</a></div><div class="admin-panel"><table class="admin-table"><thead><tr><th>Başlık</th><th>Slug</th><th>Durum</th><th>İşlem</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Title</td><td>@x.Slug</td><td>@(x.IsPublished?"Yayında":"Taslak")</td><td><div class="admin-actions"><a class="admin-btn" href="/yonetim/projeler/duzenle/@x.Id">Düzenle</a><form method="post" action="/yonetim/projeler/sil/@x.Id" onsubmit="return confirm('Silinsin mi?')">@Html.AntiForgeryToken()<button class="admin-btn admin-btn--danger">Sil</button></form></div></td></tr>}</tbody></table></div>
