@model KarakusAluminyum.Web.Services.Documents.QuotePrintVm
@using KarakusAluminyum.Web.Models.Crm
@using KarakusAluminyum.Web.Services.Documents
@{
    // Kurumsal teklif (teklif-formati.pdf): TEKLİFTİR başlığı ve tarih, "Sayın ..." hitabı, giriş ve teknik özellik cümleleri,
    // Ürün Adı / Ürün Açıklaması / Miktar / Birim / Tutar tablosu, kapanış, şartlar, imza; altında poz çizimleri.
    Layout = null;
    var t = Model.Template;
    var c = Model.Content;
    var system = Model.System;
    var quote = Model.Quote;
    ViewData["DocDate"] = PrintDates.Text(Model.PrintedOn);
    var technical = Model.Blocks.Where(b => b.Block.Clauses.Any(x => !string.IsNullOrWhiteSpace(x.Text))).ToList();
    var terms = c.Terms.Where(x => !string.IsNullOrWhiteSpace(x.Text)).ToList();
}
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>@t.Title - @Model.CustomerName</title>
  <link rel="stylesheet" href="~/css/document-print.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/poz-list.css" asp-append-version="true" />
  @if (Model.Presentation is not null)
  {
    <link rel="stylesheet" href="~/css/presentation.css" asp-append-version="true" />
    @* Sunum sayfaları kenar boşluksuzdur. Chrome aynı belgede farklı kenar boşluklu sayfaları güvenilir bölemediği için
       teklif sayfaları da kenar boşluksuz basılır; üst ve alt boşluk her sayfada tekrar eden başlık ve alt bilgiye verilir. *@
    <style>@@page{size:A4;margin:0}@@media print{.doc-head{padding-top:12mm!important}.doc-sheet>tfoot .doc-foot{height:34mm}.doc-print-foot{bottom:10mm}}</style>
  }
</head>
<body class="doc doc--quote doc--letter">
  <partial name="~/Areas/Admin/Views/Shared/_BrandLayer.cshtml" />
  @if (ViewData["PublicNote"] is string publicNote) { <partial name="~/Areas/Admin/Views/Documents/_PublicBanner.cshtml" model="publicNote" /> }
  <div class="doc-toolbar">
    @if (quote.Id != 0 && ViewData["PublicNote"] is null)
    {
      @* Sunumlu ve sunumsuz görünüm arasında geçiş; önizlemede (kayıtsız örnek teklif) gösterilmez. *@
      <a class="doc-toolbar__link" href="/yonetim/crm/teklifler/yazdir/@quote.Id@(Model.Presentation is null ? "?sunum=1" : "")">@(Model.Presentation is null ? "Kurumsal sunumu ekle" : "Sunumsuz göster")</a>
    }
    @if (quote.Id != 0 && ViewData["PublicNote"] is null) { <partial name="~/Areas/Admin/Views/Shared/_PrintDate.cshtml" model='new PrintDateVm(Model.PrintedOn, DateOnly.FromDateTime(quote.DocumentDate), "Teklif tarihi")' /> }
    @if (ViewData["Acceptance"] is KarakusAluminyum.Web.Services.Documents.QuoteAcceptanceVm { Blocked: null, AcceptedUtc: null }) { <a class="doc-toolbar__link" href="#onay">Teklifi onayla ↓</a> }
    <button type="button" onclick="window.print()">Yazdır / PDF kaydet</button>
  </div>
  @if (Model.Presentation is not null)
  {
    <partial name="~/Areas/Admin/Views/Documents/_Presentation.cshtml" model="Model.Presentation" />
    <partial name="~/Areas/Admin/Views/Documents/_PresentationFit.cshtml" />
  }
  <table class="doc-sheet">
    <thead><tr><td><partial name="~/Areas/Admin/Views/Documents/_DocumentHead.cshtml" model="t" /></td></tr></thead>
    <tfoot><tr><td><partial name="~/Areas/Admin/Views/Documents/_DocumentFoot.cshtml" model="t" /></td></tr></tfoot>
    <tbody><tr><td class="doc-body">
      <div class="ql-meta">
        @if (!string.IsNullOrEmpty(quote.QuoteNumber)) { <span>Teklif No: @quote.QuoteNumber</span> }
        @if (quote.ValidUntilUtc is DateTime valid) { <span>Geçerlilik: @TurkishNumbers.Date(valid)</span> }
        @if (!string.IsNullOrWhiteSpace(Model.Surveyors)) { <span>Ölçüyü alan: @Model.Surveyors</span> }
      </div>
      <p class="ql-salute">Sayın @Model.CustomerName,</p>

      @if (!string.IsNullOrWhiteSpace(c.Intro)) { <p>@TemplateText.ToHtml(c.Intro, c.Variables, system)</p> }
      @* Teknik özellikler örnekteki gibi ayrı cümlelerdir: marka, renk, cam ve panjur bilgisi. *@
      @foreach (var view in technical)
      {
        @foreach (var clause in view.Block.Clauses.Where(x => !string.IsNullOrWhiteSpace(x.Text)))
        {
          <p>@if (!string.IsNullOrWhiteSpace(clause.Title)) { <strong>@clause.Title: </strong> }@TemplateText.ToHtml(clause.Text, view.Block.Variables, c.Variables, system)</p>
        }
      }

      <partial name="~/Areas/Admin/Views/Documents/_QuoteTable.cshtml" model="Model.Table" />

      @if (!string.IsNullOrWhiteSpace(c.Closing)) { <p>@TemplateText.ToHtml(c.Closing, c.Variables, system)</p> }

      @if (terms.Count > 0)
      {
        <section class="ql-section">
          <h3>Teklif Şartları</h3>
          <dl class="ql-terms">
            @foreach (var term in terms) { <dt>@term.Title</dt><dd>@TemplateText.ToHtml(term.Text, c.Variables, system)</dd> }
          </dl>
        </section>
      }

      @if (!string.IsNullOrWhiteSpace(c.Note)) { <section class="ql-section"><h3>Not</h3><p>@TemplateText.ToHtml(c.Note, c.Variables, system)</p></section> }

      @if (!string.IsNullOrWhiteSpace(t.BankInfo))
      {
        <section class="ql-section"><h3>Banka Bilgileri</h3><p class="ql-bank">@t.BankInfo</p></section>
      }

      <div class="ql-signoff">
        <div>@TemplateText.ToHtml(string.IsNullOrWhiteSpace(t.SignOff) ? "Saygılarımızla," : t.SignOff, system)</div>
        @if (!string.IsNullOrWhiteSpace(t.Signatory)) { <div>@t.Signatory@(string.IsNullOrWhiteSpace(t.SignatoryTitle) ? "" : $" ({t.SignatoryTitle})")</div> }
      </div>
    </td></tr></tbody>
  </table>
  @if (Model.Attachments.Items.Count > 0)
  {
    <partial name="~/Areas/Admin/Views/Documents/_Attachments.cshtml" model="Model.Attachments" view-data='new ViewDataDictionary(ViewData) { ["Template"] = t }' />
  }
  @if (ViewData["Acceptance"] is KarakusAluminyum.Web.Services.Documents.QuoteAcceptanceVm acceptance) { <partial name="~/Areas/Admin/Views/Documents/_QuoteAcceptance.cshtml" model="acceptance" /> }
  <div class="doc-print-foot"><partial name="~/Areas/Admin/Views/Documents/_DocumentFoot.cshtml" model="t" /></div>
  <script src="~/js/units.js" asp-append-version="true"></script>
  <script src="~/js/window-drawing.js" asp-append-version="true"></script>
  <script src="~/js/poz-list.js" asp-append-version="true"></script>
</body>
</html>
