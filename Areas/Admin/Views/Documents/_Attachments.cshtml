@model KarakusAluminyum.Web.Services.Documents.AttachmentList
@{
    // Ekler Ercom'daki toplu resim listesi gibidir: pozlar aynı ölçekle akar, sayfa başlığı ve altlığı her sayfada tekrar eder.
    var template = (KarakusAluminyum.Web.Models.Documents.DocumentTemplate)ViewData["Template"]!;
    var culture = KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture;
}
<table class="doc-sheet doc-sheet--attachments">
  <thead><tr><td><partial name="~/Areas/Admin/Views/Documents/_DocumentHead.cshtml" model="template" /></td></tr></thead>
  <tfoot><tr><td><partial name="~/Areas/Admin/Views/Documents/_DocumentFoot.cshtml" model="template" /></td></tr></tfoot>
  <tbody><tr><td class="doc-body">
    <div class="doc-attachments">
      <partial name="~/Areas/Admin/Views/Shared/_PozList.cshtml" model="Model.Items" view-data='new ViewDataDictionary(ViewData) { ["PozListWidthMm"] = 160 }' />
    </div>
    <div class="poz-totals doc-pos-total">
      <span>Ünite adedi: @Model.UnitCount</span>
      <span>Toplam çevre: @Model.TotalPerimeterM.ToString("0.0", culture) m</span>
      <span>Toplam alan: @Model.TotalAreaM2.ToString("0.00", culture) m²</span>
    </div>
  </td></tr></tbody>
</table>
