@model KarakusAluminyum.Web.Services.Documents.ContractPrintVm
@using KarakusAluminyum.Web.Models.Documents
@using KarakusAluminyum.Web.Services.Documents
@{
    Layout = null;
    var t = Model.Template;
    var c = Model.Content;
    var contract = Model.Contract;
    var system = Model.System;
    ViewData["DocDate"] = TurkishNumbers.Date(contract.DocumentDate);
}
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>@t.Title - @contract.BuyerName</title>
  <link rel="stylesheet" href="~/css/document-print.css" asp-append-version="true" />
</head>
<body class="doc doc--contract">
  <div class="doc-toolbar"><button type="button" onclick="window.print()">Yazdır / PDF kaydet</button></div>
  <table class="doc-sheet">
    <thead><tr><td><partial name="~/Areas/Admin/Views/Documents/_DocumentHead.cshtml" model="t" /></td></tr></thead>
    <tfoot><tr><td><partial name="~/Areas/Admin/Views/Documents/_DocumentFoot.cshtml" model="t" /></td></tr></tfoot>
    <tbody><tr><td class="doc-body">
      @for (var n = 0; n < Model.Articles.Count; n++)
      {
        var article = Model.Articles[n];
        <section class="doc-article">
          <h2>@(n + 1). @article.Title</h2>
          @if (!string.IsNullOrWhiteSpace(article.Body)) { <p>@TemplateText.ToHtml(article.Body, c.Variables, system)</p> }

          @if (article.Kind == ContractArticleKinds.Subject)
          {
            @foreach (var block in c.Blocks)
            {
              <div class="doc-block">
                @if (!string.IsNullOrWhiteSpace(block.Name)) { <p class="doc-block-name"><strong>@block.Name:</strong></p> }
                <ul>
                  @foreach (var clause in block.Clauses)
                  {
                    <li>@if (!string.IsNullOrWhiteSpace(clause.Title)) { <strong>@clause.Title: </strong> }@TemplateText.ToHtml(clause.Text, block.Variables, c.Variables, system)</li>
                  }
                </ul>
                @if (!string.IsNullOrWhiteSpace(block.Footer)) { <p class="doc-indent">@TemplateText.ToHtml(block.Footer, block.Variables, c.Variables, system)</p> }
              </div>
            }
            @if (!string.IsNullOrWhiteSpace(c.Note)) { <p>@TemplateText.ToHtml(c.Note, c.Variables, system)</p> }
            @if (!string.IsNullOrWhiteSpace(c.Closing)) { <p>@TemplateText.ToHtml(c.Closing, c.Variables, system)</p> }
          }
          else if (article.Kind == ContractArticleKinds.Price)
          {
            <p><strong>@Model.PriceLine</strong></p>
            @if (!string.IsNullOrWhiteSpace(c.PriceNote)) { <p><strong>Not: </strong>@TemplateText.ToHtml(c.PriceNote, c.Variables, system)</p> }
          }
          else if (article.Kind == ContractArticleKinds.Payment)
          {
            <ul>
              @for (var p = 0; p < c.Payments.Count; p++)
              {
                <li>@TemplateText.ToHtml(PaymentPlan.Describe(c.Payments[p], isRemainder: p > 0 && p == c.Payments.Count - 1), c.Variables, system)</li>
              }
            </ul>
          }
        </section>
      }
      @* Kapanış metni ve imzalar aynı sayfada kalır. *@
      <div class="doc-closing">
      <p>@TemplateText.ToHtml(t.SignOff, c.Variables, system)</p>
      <table class="doc-signatures"><tbody><tr>
        <td><strong>@t.BuyerLabel</strong><div>@contract.BuyerName</div>@if (!string.IsNullOrWhiteSpace(contract.BuyerTaxInfo)) { <div>@contract.BuyerTaxInfo</div> }</td>
        <td><strong>@t.SellerLabel</strong><div>@t.SellerName</div>
          @if (!string.IsNullOrWhiteSpace(t.Signatory)) { <div>@t.Signatory@(string.IsNullOrWhiteSpace(t.SignatoryTitle) ? "" : $" ({t.SignatoryTitle})")</div> }
          @if (!string.IsNullOrWhiteSpace(t.SellerTaxInfo)) { <div>@t.SellerTaxInfo</div> }
        </td>
      </tr></tbody></table>
      </div>
      <partial name="~/Areas/Admin/Views/Documents/_Attachments.cshtml" model="Model.Attachments" />
    </td></tr></tbody>
  </table>
  <div class="doc-print-foot"><partial name="~/Areas/Admin/Views/Documents/_DocumentFoot.cshtml" model="t" /></div>
  <script src="~/js/units.js" asp-append-version="true"></script>
  <script src="~/js/window-drawing.js" asp-append-version="true"></script>
  <script>document.querySelectorAll("[data-doc-drawing]").forEach((svg) => WindowDrawing.render(svg, JSON.parse(svg.dataset.docDrawing)));</script>
</body>
</html>
