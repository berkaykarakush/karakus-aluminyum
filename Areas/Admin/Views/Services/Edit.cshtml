@model KarakusAluminyum.Web.Models.ServiceContent
@{ViewData["Title"] = Model.Id==0?"Hizmet Ekle":"Hizmet Düzenle";var edit=Model.Id!=0;var action=edit?$"/yonetim/hizmetler/duzenle/{Model.Id}":"/yonetim/hizmetler/ekle";}<h1>@ViewData["Title"]</h1><div class="admin-panel"><form class="admin-form" method="post" enctype="multipart/form-data" action="@action">@Html.AntiForgeryToken()<input type="hidden" asp-for="Id"/><div asp-validation-summary="All"></div><label asp-for="Name">Hizmet adı</label><input asp-for="Name"/><label asp-for="Slug">URL slug (ör. aluminyum-dograma)</label><input asp-for="Slug"/><label asp-for="ShortDescription">Kısa açıklama</label><textarea asp-for="ShortDescription"></textarea><label asp-for="Intro">Detay açıklaması</label><textarea asp-for="Intro"></textarea><label>Görsel seç</label><div class="admin-image-picker"><img class="admin-image-preview" id="imagePreview" src="@(string.IsNullOrWhiteSpace(Model.Image) ? "/images/image-placeholder.svg" : Model.Image)" alt="Görsel önizleme"/><div><input type="file" name="imageFile" accept="image/jpeg,image/png,image/webp,image/gif" data-image-preview="imagePreview"/><div class="admin-image-hint">JPG, PNG, WEBP veya GIF · En fazla 8 MB. Seçtiğin görsel kaydedilince yüklenir.</div><input type="hidden" asp-for="Image"/></div></div><label asp-for="SeoTitle">SEO başlığı</label><input asp-for="SeoTitle"/><label asp-for="SeoDescription">SEO açıklaması</label><textarea asp-for="SeoDescription"></textarea><label asp-for="BenefitsJson">Faydalar JSON (string dizisi)</label><textarea asp-for="BenefitsJson"></textarea><label asp-for="FaqsJson">SSS JSON (string dizisi)</label><textarea asp-for="FaqsJson"></textarea><label asp-for="SortOrder">Sıralama</label><input asp-for="SortOrder" type="number"/><label><input asp-for="IsPublished" type="checkbox" style="width:auto"/> Yayında</label><button class="admin-btn" type="submit">Kaydet</button> <a href="/yonetim/hizmetler">İptal</a></form></div>
