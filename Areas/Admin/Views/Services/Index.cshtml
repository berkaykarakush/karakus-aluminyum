@model List<KarakusAluminyum.Web.Models.ServiceContent>
@{ViewData["Title"]="Hizmetler";}<div class="admin-actions"><h1>Hizmetler</h1><a class="admin-btn" href="/yonetim/hizmetler/ekle">+ Yeni hizmet</a></div><div class="admin-panel"><table class="admin-table"><thead><tr><th>Ad</th><th>Slug</th><th>Durum</th><th>Sıra</th><th>İşlem</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Name</td><td>@x.Slug</td><td>@(x.IsPublished?"Yayında":"Taslak")</td><td>@x.SortOrder</td><td><div class="admin-actions"><a class="admin-btn" href="/yonetim/hizmetler/duzenle/@x.Id">Düzenle</a><form method="post" action="/yonetim/hizmetler/sil/@x.Id" onsubmit="return confirm('Bu hizmet silinsin mi?')">@Html.AntiForgeryToken()<button class="admin-btn admin-btn--danger">Sil</button></form></div></td></tr>}</tbody></table></div>
