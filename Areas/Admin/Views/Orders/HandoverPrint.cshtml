@model KarakusAluminyum.Web.Models.Production.ProductionOrder
@using KarakusAluminyum.Web.Services.Drawing
@{
    // Teslim tutanağı (sözleşmenin "Teslim ve Kabul" maddesi): teslim edilen pozlar, açık ayıp bildirim süresi, imzalar.
    Layout = null;
    var t = (KarakusAluminyum.Web.Models.Documents.DocumentTemplate)ViewBag.Template;
    var pozlar = (List<PozView>)ViewBag.Pozlar;
    var days = (string)ViewBag.InspectionDays;
    var culture = KarakusAluminyum.Web.Services.Documents.TurkishNumbers.Culture;
    string D(DateOnly? d) => KarakusAluminyum.Web.Areas.Admin.Controllers.OrdersController.Date(d);
    var printed = KarakusAluminyum.Web.Services.Documents.PrintDates.From(Context.Request);
    var head = new KarakusAluminyum.Web.Services.Documents.BrandHeadVm("TESLİM TUTANAĞI", D(printed));
}
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Teslim tutanağı - @Model.OrderNumber</title>
  <link rel="stylesheet" href="~/css/document-print.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/brand.css" asp-append-version="true" />
</head>
<body class="doc doc--proforma">
  <partial name="~/Areas/Admin/Views/Shared/_BrandLayer.cshtml" />
  <div class="doc-toolbar"><a class="doc-toolbar__link" href="/yonetim/siparisler/detay/@Model.Id">Siparişe dön</a><partial name="~/Areas/Admin/Views/Shared/_PrintDate.cshtml" model='new KarakusAluminyum.Web.Services.Documents.PrintDateVm(printed, Model.DeliveredOn, "Teslim tarihi")' /><button type="button" onclick="window.print()">Yazdır / PDF kaydet</button></div>
  <table class="doc-sheet">
    <thead><tr><td><partial name="~/Areas/Admin/Views/Shared/_BrandHead.cshtml" model="head" /></td></tr></thead>
    <tfoot><tr><td><partial name="~/Areas/Admin/Views/Shared/_BrandFoot.cshtml" /></td></tr></tfoot>
    <tbody><tr><td class="doc-body">
      <div class="pf-parties">
        <section class="pf-party"><h3>Satıcı (yüklenici)</h3><strong>@(t.SellerLegalName ?? t.SellerName)</strong>@if (!string.IsNullOrWhiteSpace(t.SellerAddress)) { <div>@t.SellerAddress</div> }</section>
        <section class="pf-party"><h3>Alıcı (iş sahibi)</h3><strong>@Model.Customer?.Name</strong>@if (!string.IsNullOrWhiteSpace(Model.InstallAddress)) { <div>@Model.InstallAddress</div> }</section>
        <dl class="pf-info"><dt>Sipariş</dt><dd>@Model.OrderNumber</dd>@if (Model.Contract is not null) { <dt>Sözleşme</dt><dd>@Model.Contract.ContractNumber</dd> }<dt>İş</dt><dd>@Model.Title</dd></dl>
      </div>
      <table class="pf-lines">
        <thead><tr><th class="pf-no">Sıra</th><th>Poz</th><th>Ürün</th><th class="pf-num">Ölçü (mm)</th><th class="pf-num">Adet</th></tr></thead>
        <tbody>
        @foreach (var poz in pozlar)
        {
          <tr><td class="pf-no">@poz.Position</td><td>@poz.Design.Name</td><td>@KarakusAluminyum.Web.Models.Drawing.ProductCategories.Label(poz.Design.Category)</td><td class="pf-num">@poz.Design.WidthMm × @poz.Design.HeightMm</td><td class="pf-num">@poz.Design.Quantity</td></tr>
        }
        </tbody>
      </table>
      <p class="pf-words">Toplam @pozlar.Count poz, @pozlar.Sum(x => x.Design.Quantity) adet, @pozlar.Sum(x => x.AreaM2 * x.Design.Quantity).ToString("0.00", culture) m²</p>
      <p>Yukarıda listelenen imalat ve montaj işleri, ekteki poz listesine uygun olarak <strong>____/____/______</strong> tarihinde teslim edilmiş ve iş sahibi tarafından yerinde görülerek teslim alınmıştır.</p>
      <p>İş sahibi, teslimden itibaren <strong>@days gün</strong> içinde işi gözden geçirerek açık ayıpları yazılı olarak bildirir; bu süre içinde bildirilmeyen açık ayıplar bakımından iş kabul edilmiş sayılır (TBK m. 474 ve 477). Gizli ayıplar ortaya çıktıklarında gecikmeksizin bildirilir. Garanti süresi teslim tarihinden başlar.</p>
      <p><strong>Teslimde tespit edilen eksik veya ayıplar:</strong></p>
      @{ var openPunch = (List<KarakusAluminyum.Web.Models.Production.PunchItem>)ViewBag.OpenPunch; var punchPositions = (Dictionary<int, int>)ViewBag.PunchPositions; }
      @if (openPunch.Count > 0)
      {
        <ol style="margin:0 0 2mm 5mm;padding:0">
          @foreach (var x in openPunch) { <li>@KarakusAluminyum.Web.Areas.Admin.Controllers.PunchController.Where(x, punchPositions) – @x.Kind: @x.Description (@x.Quantity adet)@(x.DueOn is DateOnly due ? $", giderilecek tarih {due:dd.MM.yyyy}" : "")</li> }
        </ol>
        <div style="height:14mm;border:1px solid #999;margin-bottom:4mm"></div>
      }
      else
      {
        <div style="height:28mm;border:1px solid #999;margin-bottom:4mm"></div>
      }
      <table class="pf-sign"><tbody><tr>
        <td><strong>Teslim eden (Satıcı)</strong><div>@(t.SellerLegalName ?? t.SellerName)</div><div class="pf-sign__field">Ad Soyad:</div><div class="pf-sign__line">Kaşe / İmza</div></td>
        <td><strong>Teslim alan (Alıcı)</strong><div>@Model.Customer?.Name</div><div class="pf-sign__field">Ad Soyad:</div><div class="pf-sign__line">İmza</div></td>
      </tr></tbody></table>
    </td></tr></tbody>
  </table>
  <div class="doc-print-foot"><partial name="~/Areas/Admin/Views/Shared/_BrandFoot.cshtml" /></div>
</body>
</html>
